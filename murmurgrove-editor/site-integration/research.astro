---
import Base from '../../layouts/Base.astro';
---
<Base title="Research connections | murmurgrove" description="Source-backed relationships and current research index.">
  <section class="murmur-research-reader" style="max-width:920px;margin:45px auto 100px;padding:0 24px;color:#26664c;">
    <a href="/" style="font-size:12px;text-decoration:none;color:#4c9170">← murmurgrove</a>
    <h1 style="font-weight:500;font-size:clamp(24px,4vw,40px);letter-spacing:-.03em">Research connections</h1>
    <p style="font-size:13px;line-height:1.8;max-width:65ch;color:#658c76">This is a source-backed view of the current archive, not a historical reconstruction of the organism. Follow each record to read its full text; interpretive relationships are distinguished from recorded metadata.</p>
    <label for="research-query" style="display:block;font-size:12px;margin:25px 0 5px">Search the archive</label>
    <input id="research-query" type="search" placeholder="Artist, exhibition, concept, question…" style="box-sizing:border-box;width:100%;padding:13px 0;border:0;border-bottom:1px solid #92b7a1;border-radius:0;background:transparent;color:#216e50;font:inherit;outline:0">
    <p id="research-total" style="font-size:12px;color:#799687" aria-live="polite"></p>
    <div id="research-records"></div>
  </section>
  <script is:inline type="module" src="/murmurgrove/research/explore.js"></script>
</Base>
