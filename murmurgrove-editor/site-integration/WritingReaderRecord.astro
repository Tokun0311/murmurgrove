---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('entries',({data})=>data.draft!==true)).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const {Content}=await render(item);
---
<Base title={`${item.data.title} | murmurgrove`}>
  <article class="article">
    <a class="eyebrow" href="/writing/">← Writing</a>
    <h1>{item.data.title}</h1>
    <p class="lead">{item.data.date.toISOString().slice(0,10)} · {item.data.type} · {item.data.language}</p>
    <p class="note">{item.data.description}</p>
    <div class="prose"><Content/></div>
  </article>
</Base>
