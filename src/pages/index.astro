---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const exhibitions=(await getCollection('exhibitions')).sort((a,b)=>b.data.visitedOn.valueOf()-a.data.visitedOn.valueOf());
const latest=exhibitions.slice(0,6);
---
<Base title="TOW ARCHIVE" description="A personal archive of exhibitions, art institutions, people and research concepts.">
  <section class="home-index" aria-label="Tow Archive index">
    <h2 class="section-title">An archive of looking and thinking.</h2>
    <p class="section-lead">Exhibitions, encounters and research notes, connected through people, places and concepts.</p>
    <div class="home-sections">
      <a href="/exhibitions/">Exhibitions <span>Browse by date and region ↗</span></a>
      <a href="/institutions/">Institutions <span>Explore places ↗</span></a>
      <a href="/concepts/">Concepts <span>Explore connections ↗</span></a>
      <a href="/people/">People <span>Browse people ↗</span></a>
    </div>
    <div class="home-recent-heading"><h2>Recent exhibitions</h2><a href="/exhibitions/">View all</a></div>
    <ol class="archive-list">
      {latest.map(item=><li class="archive-entry"><time datetime={item.data.visitedOn.toISOString().slice(0,10)}>{item.data.dateLabel.replaceAll('-','.')}</time><a href={`/exhibitions/${item.id}/`}>{item.data.title}</a><span class="entry-type">{item.data.region}</span></li>)}
    </ol>
  </section>
</Base>
