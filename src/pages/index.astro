---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { createMurmurgrove } from '../lib/murmurgrove';
import groveModel from '../data/murmurgrove-model.json';
const [exhibitions,people,institutions,concepts,writing,photography]=await Promise.all([
  getCollection('exhibitions'),getCollection('people'),getCollection('institutions'),getCollection('concepts'),getCollection('entries'),getCollection('photographs')
]);
const organism=createMurmurgrove({
  exhibitions:exhibitions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  people:people.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  institutions:institutions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  concepts:concepts.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  writing:writing.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  photography:photography.map(x=>({id:x.id,data:x.data as Record<string,any>})),
});
const pageData={marks:organism.marks,roots:organism.roots,counts:organism.counts,relationDensity:organism.relationDensity,fingerprint:organism.fingerprint,morphologyVersion:groveModel.version,motionSpeed:groveModel.motionSpeed,motionTimebase:groveModel.motionTimebase,sharedStateEndpoint:import.meta.env.PUBLIC_MURMURGROVE_STATE_URL||'',sharedVersion:`${organism.marks.length}:${organism.roots.length}:${organism.fingerprint}`};
---
<Base title="TOW ARCHIVE | Murmurgrove" description="A living morphology shaped by exhibitions, writing and research directions.">
  <section class="grove-home" aria-label="Murmurgrove, a living archive">
    <div class="grove-figure" id="murmurgrove" data-fingerprint={organism.fingerprint}>
      <div class="grove-canvas-area" id="grove-canvas-area">
        <canvas id="grove-canvas" role="img" aria-label="Interactive research morphology. Drag to rotate and zoom toward the pointer up to 1000%. Zooming back to 100% recentres the organism. Each point is an archive record."></canvas>
        <div id="grove-record-tooltip" class="grove-record-tooltip" hidden>
          <span id="grove-record-type"></span><a id="grove-record-link" href="#"></a>
        </div>
      </div>
      <div class="grove-footer">
        <button type="button" class="grove-tiny grove-history-toggle" id="grove-history-toggle" aria-expanded="false" aria-controls="grove-history-panel" title="Browse saved archive states"><span aria-hidden="true">◷</span> History</button>
        <div class="grove-controls" aria-label="Current observation mode"><span class="grove-mode is-selected">Whole</span></div>
        <div class="grove-tools">
          <button type="button" class="grove-tiny grove-zoom" data-zoom="out" aria-label="Zoom out" title="Zoom out">−</button>
          <span id="grove-zoom-label" aria-live="polite">100%</span>
          <button type="button" class="grove-tiny grove-zoom" data-zoom="in" aria-label="Zoom in to archive records" title="Zoom in (maximum 1000%)">+</button>
          <button type="button" class="grove-tiny" id="grove-reset" aria-label="Reset view" title="Reset view">↺</button>
        </div>
      </div>
      <div class="grove-history-panel" id="grove-history-panel" hidden>
        <label for="grove-history-range">Morphology <span id="grove-history-date"></span></label>
        <input id="grove-history-range" type="range" min="0" max="0" value="0" step="1" />
        <button id="grove-history-live" class="grove-tiny" type="button">Current</button>
        <span id="grove-history-meta" aria-live="polite"></span>
      </div>
      <span class="sr-only" id="grove-announcement" aria-live="polite"></span>
    </div>
  </section>
  <script type="application/json" id="grove-data" set:html={JSON.stringify(pageData).replace(/</g,'\\u003c')}></script>
</Base>
<style>
/* The organism is the entire viewport atmosphere, never a framed illustration. */
.grove-home{position:fixed;inset:0;width:100%;height:100svh;z-index:0;overflow:hidden;isolation:isolate;background:transparent}
.grove-figure,.grove-canvas-area{position:absolute;inset:0;min-height:0;width:100%;height:100%}
.grove-canvas-area{touch-action:none;overflow:hidden}
#grove-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab}
#grove-canvas:active{cursor:grabbing}
.grove-footer{position:absolute;z-index:5;bottom:max(22px,env(safe-area-inset-bottom));left:clamp(18px,5vw,76px);right:clamp(18px,5vw,76px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;pointer-events:none}
.grove-footer>*{pointer-events:auto}
.grove-controls{display:flex;align-items:center;gap:3px;white-space:nowrap;padding:4px;border-radius:40px;background:rgba(255,255,255,.42);border:1px solid rgba(145,191,163,.18);backdrop-filter:blur(14px);box-shadow:0 8px 28px rgba(64,115,82,.04)}
.grove-mode{font:inherit;font-size:11px;line-height:1.3;border-radius:32px;padding:7px 13px}
.grove-mode.is-selected{background:rgba(220,242,227,.52);border:1px solid rgba(124,190,148,.26);color:#087a55}
.grove-tiny{appearance:none;border:1px solid transparent;background:transparent;color:#63957a;font:inherit;font-size:11px;line-height:1.3;cursor:pointer;transition:background .2s,color .2s,border-color .2s;padding:7px 9px;border-radius:22px;white-space:nowrap}
.grove-tiny:hover{background:rgba(226,245,232,.42);color:#087a55}
.grove-tiny:focus-visible{outline:2px solid #168760;outline-offset:3px}
.grove-history-toggle{justify-self:start;border:1px solid rgba(145,191,163,.2);background:rgba(255,255,255,.34);backdrop-filter:blur(13px);box-shadow:0 8px 28px rgba(64,115,82,.04)}
.grove-tools{display:flex;align-items:center;justify-self:end;gap:3px;background:rgba(255,255,255,.28);border:1px solid rgba(145,191,163,.14);border-radius:30px;backdrop-filter:blur(13px);box-shadow:0 8px 28px rgba(64,115,82,.04)}
#grove-zoom-label{font-size:10px;color:#6e9a80;min-width:32px;text-align:center;font-variant-numeric:tabular-nums;text-shadow:0 0 12px rgba(255,255,255,.48)}

.grove-history-panel{position:absolute;z-index:6;bottom:clamp(83px,12vh,125px);left:clamp(18px,5vw,76px);right:clamp(18px,5vw,76px);display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:12px 18px;border:1px solid rgba(193,224,203,.6);border-radius:12px;background:rgba(255,255,255,.62);backdrop-filter:blur(18px);box-shadow:0 12px 28px rgba(49,98,64,.05);font-size:11px;color:#5e8d71}
.grove-history-panel[hidden],.grove-record-tooltip[hidden]{display:none}
.grove-history-panel input{accent-color:#268e62;flex:1;min-width:120px}
.grove-history-panel label{white-space:nowrap}
#grove-history-date{color:#087b55}
#grove-history-meta{font-size:10px;color:#789d87}
.grove-record-tooltip{position:absolute;z-index:7;max-width:min(315px,80vw);padding:10px 13px;border:1px solid rgba(193,224,203,.64);border-radius:8px;background:rgba(255,255,255,.76);backdrop-filter:blur(18px);box-shadow:0 12px 30px rgba(49,98,64,.07);font-size:12px;line-height:1.5;pointer-events:auto;transform:translate(12px,12px)}
#grove-record-type{font-size:9px;text-transform:uppercase;letter-spacing:.11em;color:#79a28b;display:block;margin-bottom:3px}
#grove-record-link{color:#087b55;text-decoration:none;display:block;overflow-wrap:anywhere}
#grove-record-link:hover{text-decoration:underline}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:650px){
 .grove-footer{left:14px;right:14px;bottom:max(19px,env(safe-area-inset-bottom));grid-template-columns:1fr auto;row-gap:13px}
 .grove-controls{grid-column:1/-1;grid-row:1;justify-self:center}
 .grove-history-toggle{grid-column:1;grid-row:2}
 .grove-tools{grid-column:2;grid-row:2}
 .grove-mode{font-size:10px;padding:7px 12px}
 .grove-history-panel{left:14px;right:14px;bottom:115px;padding:10px 12px}
}
@media(prefers-reduced-motion:reduce){.grove-tiny{transition:none}}
</style>
<script>
 type Mark={key:string;section:string;title:string;url:string;strength:number;recency:number;related:number;x:number;y:number;seed:number;directionStrength?:number;focus?:string;activity?:number;growth?:number};
 type Vec=[number,number,number];
 type Root={from:string;to:string;weight:number;kind:'direct'|'shared'};
 const dataEl=document.getElementById('grove-data');
 const canvas=document.getElementById('grove-canvas') as HTMLCanvasElement|null;
 const area=document.getElementById('grove-canvas-area') as HTMLElement|null;
 if(dataEl&&canvas&&area){
  const ctx=canvas.getContext('2d',{alpha:true});
  if(ctx){
   type MotionSpeed={whole:number;growth:number;movement:number};
   type HistoryState={capturedAt?:string;marks:Mark[];roots?:Root[];relationDensity:number;morphologyVersion?:string;motionSpeed?:MotionSpeed};
   type HistoryEntry={id:string;url:string;capturedAt:string;count:number;morphologyVersion?:string;motionSpeed?:MotionSpeed;changes?:{new?:string[];edited?:string[];deleted?:string[]}};
   const data=JSON.parse(dataEl.textContent||'{}') as {marks:Mark[];relationDensity:number;fingerprint:number;roots:Root[];morphologyVersion?:string;motionSpeed:MotionSpeed;motionTimebase?:number;sharedStateEndpoint?:string;sharedVersion?:string};
   const TAU=Math.PI*2;
   const hash=(s:string)=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return(h>>>0)/4294967295};
   const reduce=matchMedia('(prefers-reduced-motion:reduce)');
   const fine=matchMedia('(pointer:fine)');
   // A single continuous organism: no Growth or Movement modes.
   const tooltip=document.getElementById('grove-record-tooltip') as HTMLElement;
   const recordLink=document.getElementById('grove-record-link') as HTMLAnchorElement;
   const recordType=document.getElementById('grove-record-type') as HTMLElement;
   const zoomLabel=document.getElementById('grove-zoom-label');
   const historyToggle=document.getElementById('grove-history-toggle') as HTMLButtonElement;
   const historyPanel=document.getElementById('grove-history-panel') as HTMLElement;
   const historyRange=document.getElementById('grove-history-range') as HTMLInputElement;
   const historyDate=document.getElementById('grove-history-date');
   const historyMeta=document.getElementById('grove-history-meta');
   let history:HistoryEntry[]=[];
   let historyActive=false;
   const liveTargetPositions=new Map<string,Vec>();
   let sharedOnline=false;
   let historyLoadGeneration=0;
   const historyCache=new Map<string,HistoryState>();
   const historyIndexURL='/murmurgrove/history-index.json';
   let current=data.marks||[];
   let currentRoots=data.roots||[];
   let density=data.relationDensity||0;
   let fingerprint=data.fingerprint||0;
   const mode:'whole'='whole';
   let activeMotionSpeed:MotionSpeed=data.motionSpeed||{whole:3,growth:3,movement:10};
   const timebase=data.motionTimebase||0.00025;
   // A continuous simulation clock prevents jumps when switching viewing modes
   // or replaying a historical motion setting. Hidden-tab time is not fast-forwarded.
   let motionClock=0,motionLast=0;
   const advanceMotion=(now:number)=>{
    if(motionLast){motionClock+=Math.max(0,Math.min(80,now-motionLast))*activeMotionSpeed[mode]}
    motionLast=now;
   };
   const coarse=matchMedia('(pointer:coarse)').matches || innerWidth<650;
   let yaw=-.26,pitch=-.18,zoom=1,panX=0,panY=0,width=1,height=1,dpr=1,last=0,raf=0,visible=true;
   let interacting=false,interactionEnd=0,renderPending=false,lastPaint=0;
   const idleInterval=coarse?1000/24:1000/40;
   const dragInterval=coarse?1000/30:1000/50;
   let pointCache:{m:Mark;x:number;y:number;r:number;depth:number}[]=[];
   let focus:Mark|null=null;
   const clamp=(n:number,a:number,b:number)=>Math.max(a,Math.min(b,n));
   const pos=(m:Mark):Vec=>{
    // Every real record is embedded in 3D, with stable positions based on its ID.
    const depth=hash('depth:'+m.section+':'+m.key)*2-1;
    const radial=.65+.35*hash('radial:'+m.key);
    return [(m.x-.5)*3.0*radial,(m.y-.5)*1.85*radial,depth*.90];
   };
   const rotate=([x,y,z]:Vec):Vec=>{
    const cy=Math.cos(yaw),sy=Math.sin(yaw),cx=Math.cos(pitch),sx=Math.sin(pitch);
    const x1=x*cy+z*sy,z1=-x*sy+z*cy;
    return [x1,y*cx-z1*sx,y*sx+z1*cx];
   };
   const project=(p:Vec)=>{
    const [x,y,z]=rotate(p);
    const perspective=3.9/(3.9-z*.29);
    const scale=(width<650?Math.max(width*.51,height*.30):Math.min(width*.34,height*.53))*zoom;
    return {x:width*.5+panX+x*scale*perspective,y:height*.525+panY+y*scale*perspective,z,scale:perspective};
   };
   // Murmurgrove V6.4: no cellular icons, leaves, skins or isolated glyphs.
   // Each record is the anchor for a sparse flock of directed micro-traces.
   // The density and reach of its traces depend on documented associations.
   // They are visual material, NOT additional archive records or connections.
   const drawOrganicNode=(m:Mark,x:number,y:number,r:number,alpha:number,phase:number,heading:number,fast:boolean)=>{
    const weight=clamp(m.growth??m.directionStrength??0,0,1.65);
    const structural=m.section==='concepts'||m.section==='institutions'||m.section==='people';
    const isConcept=m.section==='concepts';
    const isInstitution=m.section==='institutions';
    const isPeople=m.section==='people';
    const quiet=zoom>=3.2?Math.max(0,(5-zoom)/1.8):1;
    const activity=clamp(m.activity??.3,0,1);
    const a=clamp(alpha*(.44+activity*.19+weight*.13),.20,.9);
    const spread=(structural?11+weight*10:3.2+weight*2.1)*quiet;
    const lengthFactor=isConcept?1.45:isInstitution?1.20:isPeople?1.30:.85;
    const desired=fast?Math.ceil((structural?11:3)+(weight*5)):
      Math.ceil((isConcept?20:isInstitution?17:isPeople?15:m.section==='writing'?7:4)+weight*(isConcept?19:structural?13:3));
    const count=coarse?Math.min(19,Math.ceil(desired*.55)):Math.min(52,desired);
    // At extreme zoom the real record anchor and actual relationship paths emerge.
    // The suggested surrounding motion disappears instead of multiplying forever.
    if(spread>.25){
      ctx.save();ctx.translate(x,y);ctx.rotate(heading);
      ctx.lineCap='round';
      const baseSeed='wing:'+m.section+':'+m.key;
      for(let i=0;i<count;i++){
        const u=hash(baseSeed+':a:'+i),v=hash(baseSeed+':b:'+i),w=hash(baseSeed+':c:'+i);
        const orbit=Math.sqrt(u),theta=(i*2.399963+v*.5);
        let dx=Math.cos(theta)*orbit*spread*lengthFactor;
        let dy=Math.sin(theta)*orbit*spread*(isInstitution?.55:isConcept?.48:.65);
        // Flocking motion bends the microscale current; roots move much less.
        const flow=reduce.matches?0:(isInstitution?.1:isConcept?.42:.63);
        dx+=Math.sin(phase*.16+i*1.71)*flow*2.3;
        dy+=Math.cos(phase*.14+i*.87)*flow*1.6;
        const len=(.65+w*1.7)*(isConcept?1.3:1)*(.85+Math.min(weight,.9)*.4);
        ctx.beginPath();
        ctx.moveTo(dx-len*.55,dy+len*.12);
        ctx.quadraticCurveTo(dx,dy-len*.24,dx+len*.56,dy-len*.03);
        ctx.lineWidth=isInstitution?.65:.55;
        ctx.strokeStyle=`rgba(13,101,73,${clamp(a*(.16+(1-orbit)*.34)*(isConcept?1.06:1),.035,.48)})`;
        ctx.stroke();
      }
      ctx.restore();
    }
    // There is one actual selectable locus per archive record.
    const anchorRadius=zoom>3?r*.92:structural?r*.46:r*.36;
    ctx.fillStyle=`rgba(11,93,67,${clamp(a*(zoom>2.3?.77:.42),.11,.76)})`;
    ctx.beginPath();ctx.arc(x,y,Math.max(.5,anchorRadius),0,TAU);ctx.fill();
   };
   // RELATIONAL ECOLOGY v2: deterministic spatial organisation driven by real links.
   // There are no visual category icons: roles are encoded by how records move.
   // Institutions anchor; exhibitions grow toward their contexts; people bridge;
   // concepts create distributed influence fields.  Complexity scales with
   // vertices + local neighbours + edges, not with every pair of records.
   const nodeKey=(m:Mark)=>`${m.section}:${m.key}`;
   const roleInertia=(section:string)=>section==='institutions'?.055:section==='concepts'?.20:section==='people'?.28:section==='writing'?.18:section==='photography'?.36:.43;
   let nodePositions=new Map<string,Vec>();
   let rootPaths:({from:Vec;to:Vec;fromKey:string;toKey:string;weight:number;kind:'direct'|'shared';seed:number})[]=[];
   let influence=new Map<string,{bridge:Vec;concept:Vec;strength:number}>();
   const rebuildRoots=()=>{
    const nodes=current.map(m=>({key:nodeKey(m),m,base:pos(m),p:pos(m),v:[0,0,0] as Vec}));
    const byKey=new Map(nodes.map((n,i)=>[n.key,i]));
    const edges=currentRoots.flatMap(root=>{
      const i=byKey.get(root.from),j=byKey.get(root.to);
      return i===undefined||j===undefined||i===j?[]:[{i,j,weight:Math.min(3,Math.max(.4,root.weight)),kind:root.kind}];
    });
    // A repeatable, bounded force relaxation. Spatial buckets avoid an N^2
    // all-pairs calculation as the archive grows toward thousands of records.
    const iterations=Math.min(72,Math.max(34,Math.round(55-Math.log2(Math.max(1,nodes.length)/180)*3)));
    for(let pass=0;pass<iterations;pass++){
      const force=nodes.map(n=>[0,0,0] as Vec);
      for(const e of edges){
        const a=nodes[e.i],b=nodes[e.j];
        const dx=b.p[0]-a.p[0],dy=b.p[1]-a.p[1],dz=b.p[2]-a.p[2];
        const dist=Math.max(.001,Math.hypot(dx,dy,dz));
        const desired=e.kind==='shared'?.45:.52;
        const pull=(dist-desired)*(.010+.003*Math.log1p(e.weight));
        const ai=roleInertia(a.m.section),bi=roleInertia(b.m.section);
        for(let d=0;d<3;d++){
          const delta=([dx,dy,dz][d]/dist)*pull;
          force[e.i][d]+=delta*ai;
          force[e.j][d]-=delta*bi;
        }
      }
      // Local avoidance, stable grid order. Inactive nodes still occupy space.
      const buckets=new Map<string,number[]>();
      const cell=.31;
      const cellAt=(p:Vec)=>[Math.floor(p[0]/cell),Math.floor(p[1]/cell),Math.floor(p[2]/cell)];
      const coords=nodes.map(n=>cellAt(n.p));
      coords.forEach((c,i)=>{const key=c.join('/');const arr=buckets.get(key)||[];arr.push(i);buckets.set(key,arr)});
      for(let i=0;i<nodes.length;i++){
        const c=coords[i],p=nodes[i].p;
        for(let x=-1;x<=1;x++)for(let y=-1;y<=1;y++)for(let z=-1;z<=1;z++){
          const list=buckets.get(`${c[0]+x}/${c[1]+y}/${c[2]+z}`);
          if(!list)continue;
          for(const j of list){if(j<=i)continue;
            const q=nodes[j].p,dx=p[0]-q[0],dy=p[1]-q[1],dz=p[2]-q[2];
            const ds=dx*dx+dy*dy+dz*dz+.0001;
            if(ds>.13)continue;
            const magnitude=Math.min(.010,.00055/ds);
            for(let d=0;d<3;d++){
              const delta=([dx,dy,dz][d])*magnitude;
              force[i][d]+=delta;force[j][d]-=delta;
            }
          }
        }
      }
      for(let i=0;i<nodes.length;i++){
        const n=nodes[i],inertia=roleInertia(n.m.section);
        // Structural memory: institutions remain near their fixed anchors.
        const anchor=n.m.section==='institutions'?.055:n.m.section==='concepts'?.036:.026;
        for(let d=0;d<3;d++){
          const step=(force[i][d]+(n.base[d]-n.p[d])*anchor)*(.55+inertia);
          n.v[d]=n.v[d]*.57+step;
          n.p[d]=clamp(n.p[d]+n.v[d],d===0?-1.72:d===1?-1.28:-1.12,d===0?1.72:d===1?1.28:1.12);
        }
      }
    }
    nodePositions=new Map(nodes.map(n=>[n.key,n.p]));
    liveTargetPositions.clear();
    rootPaths=edges.map(e=>({from:nodes[e.i].p,to:nodes[e.j].p,fromKey:nodes[e.i].key,toKey:nodes[e.j].key,weight:e.weight,kind:e.kind,seed:hash(nodes[e.i].key+'|'+nodes[e.j].key)}));
    // Convert connected relationships into movement influences once per rebuild.
    const aggregate=new Map<string,{bridge:Vec;concept:Vec;strength:number}>();
    nodes.forEach(n=>aggregate.set(n.key,{bridge:[0,0,0],concept:[0,0,0],strength:0}));
    for(const e of edges){
      const a=nodes[e.i],b=nodes[e.j];
      for(const [source,target] of [[a,b],[b,a]]){
        const out=aggregate.get(source.key)!;
        const dx=target.p[0]-source.p[0],dy=target.p[1]-source.p[1],dz=target.p[2]-source.p[2];
        const dest=target.m.section==='concepts'?out.concept:out.bridge;
        const weight=target.m.section==='concepts'?.95:.33;
        dest[0]+=dx*weight;dest[1]+=dy*weight;dest[2]+=dz*weight;
        out.strength++;
      }
    }
    influence=aggregate;
   };
   rebuildRoots();
   const requestDraw=()=>{if(!renderPending){renderPending=true;requestAnimationFrame(t=>{renderPending=false;lastPaint=t;draw(t)})}};
   const resize=()=>{
    width=innerWidth;height=innerHeight;
    // Constrain backing pixels on phones, especially high-DPI Safari devices.
    dpr=Math.min(devicePixelRatio||1,coarse?1.25:1.75);
    canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);requestDraw();
   };
   const draw=(time:number)=>{
    const fast=interacting || time<interactionEnd;
    last=time;
    advanceMotion(time);
    ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,width,height);
    // No rings, leaf silhouettes or translucent membranes. Material is carried
    // exclusively by actual archive records and their documented relationships.
    // Subtle relation-following motion: concept fields modulate nearby records;
    // people bridge regions more freely; institutions mostly stay anchored.
    // A deployed state service is authoritative. The browser interpolates toward
    // its latest received positions; rotating the camera never changes the body.
    if(!historyActive && sharedOnline && liveTargetPositions.size){
      for(const [key,target] of liveTargetPositions){
        const here=nodePositions.get(key);
        if(!here)continue;
        const rate=fast?.24:.085;
        nodePositions.set(key,[here[0]+(target[0]-here[0])*rate,
                               here[1]+(target[1]-here[1])*rate,
                               here[2]+(target[2]-here[2])*rate]);
      }
    }
    const animatedPositions=new Map<string,Vec>();
    for(const m of current){
      const key=nodeKey(m),base=nodePositions.get(key)||pos(m),field=influence.get(key);
      const t=reduce.matches?0:motionClock*timebase;
      const phase=t+hash('phase'+key)*TAU;
      const role=sharedOnline&&!historyActive?0:(m.section==='institutions'?.002:m.section==='writing'?.013:m.section==='people'?.017:.009)*(0.35+(m.activity??.4)*.65);
      const inv=field?1/Math.max(1,field.strength):0;
      const c=field?.concept||[0,0,0],bridge=field?.bridge||[0,0,0];
      const sway=Math.sin(phase*.31),flow=Math.cos(phase*.23);
      animatedPositions.set(key,[
       base[0]+role*sway+(sharedOnline&&!historyActive?0:.035*c[0]*inv*flow+.014*bridge[0]*inv*sway),
       base[1]+role*flow+(sharedOnline&&!historyActive?0:.035*c[1]*inv*flow+.014*bridge[1]*inv*sway),
       base[2]+role*.7*sway+(sharedOnline&&!historyActive?0:.035*c[2]*inv*flow+.014*bridge[2]*inv*sway)
      ]);
    }
    // Interwoven roots are real, recorded associations. At Whole scale only
    // SHORT local root segments appear. Long cross-body edges must not become
    // a decorative knowledge graph; they are revealed under magnification.
    const rootLimit=fast?(coarse?32:70):(coarse?100:180);
    const rootsToDraw=rootPaths.length>rootLimit?
      rootPaths.filter((_,i)=>i%Math.ceil(rootPaths.length/rootLimit)===0).slice(0,rootLimit):rootPaths;
    for(const b of rootsToDraw){
      const from=animatedPositions.get(b.fromKey)||b.from,to=animatedPositions.get(b.toKey)||b.to;
      const dx=to[0]-from[0],dy=to[1]-from[1],dz=to[2]-from[2];
      const distance=Math.hypot(dx,dy,dz);
      // Dense, local relationships weave material. Distant relationships are
      // available when zooming in, not drawn as global threads at 100%.
      if(zoom<2.1&&distance>.42)continue;
      const close=clamp(1-distance/(zoom<2.1?.92:2.4),.14,1);
      const strength=Math.log1p(b.weight);
      const bend=(b.seed-.5)*(.15+distance*.12);
      const side=[-dy,dx,dz*.2] as Vec;
      const copies=fast?1:(zoom<2.1?4:2);
      for(let k=0;k<copies;k++){
        const drift=(k-(copies-1)/2)*.023;
        const c1:Vec=[from[0]*.70+to[0]*.30+side[0]*(bend+drift),from[1]*.70+to[1]*.30+side[1]*(bend+drift),from[2]*.70+to[2]*.30+side[2]*(bend+drift)];
        const c2:Vec=[from[0]*.30+to[0]*.70+side[0]*(-bend*.55+drift),from[1]*.30+to[1]*.70+side[1]*(-bend*.55+drift),from[2]*.30+to[2]*.70+side[2]*(-bend*.55+drift)];
        const n=fast?4:coarse?6:10;
        ctx.beginPath();
        for(let j=0;j<=n;j++){
          const t=j/n,u=1-t;
          const v=project([
           u*u*u*from[0]+3*u*u*t*c1[0]+3*u*t*t*c2[0]+t*t*t*to[0],
           u*u*u*from[1]+3*u*u*t*c1[1]+3*u*t*t*c2[1]+t*t*t*to[1],
           u*u*u*from[2]+3*u*u*t*c1[2]+3*u*t*t*c2[2]+t*t*t*to[2]]);
          if(!j)ctx.moveTo(v.x,v.y);else ctx.lineTo(v.x,v.y);
        }
        ctx.lineWidth=.44+(k===0?.19:0)+Math.min(.34,strength*.15);
        ctx.strokeStyle=`rgba(28,103,77,${clamp((zoom<2.1?.13:.07)*close*(1+strength*.24),.025,.24)})`;
        ctx.stroke();
      }
    }
    // All visible points ARE archive records, each with a real link.
    pointCache=[];
    const ordered=current.map(m=>({m,p:animatedPositions.get(nodeKey(m))||pos(m)}));
    if(!fast&&!coarse)ordered.sort((a,b)=>rotate(a.p)[2]-rotate(b.p)[2]);
    for(const {m,p} of ordered){
     const v=project(p);
     if(v.x< -45||v.x>width+45||v.y< -45||v.y>height+45)continue;
     const depthAlpha=clamp(.65+v.z*.25,.20,1);
     const growthWeight=clamp(m.growth??m.directionStrength??0,0,1.65);
     const structuralBoost=m.section==='concepts'?1.22:m.section==='institutions'?1.04:m.section==='people'?.98:m.section==='writing'?.58:.2;
     const radius=clamp((zoom>1.2?2.0:1.22)*v.scale*zoom**.19+.48*m.strength+growthWeight*structuralBoost,.78,m.section==='concepts'?11.4:m.section==='institutions'?9.8:m.section==='people'?8.8:4.7);
     const field=influence.get(nodeKey(m));
     const dir=field?[field.bridge[0]+field.concept[0]*1.3,field.bridge[1]+field.concept[1]*1.3,field.bridge[2]+field.concept[2]*1.3] as Vec:[.1,.1,0] as Vec;
     const tip=project([p[0]+dir[0]*.14,p[1]+dir[1]*.14,p[2]+dir[2]*.14]);
     const heading=Math.atan2(tip.y-v.y,tip.x-v.x)+(hash('heading:'+m.key)-.5)*.48;
     drawOrganicNode(m,v.x,v.y,radius,depthAlpha,(reduce.matches?0:motionClock*timebase)+hash('phase'+nodeKey(m))*TAU,heading,fast);
     pointCache.push({m,x:v.x,y:v.y,r:radius,depth:v.z});
    }
    if(focus){const dot=pointCache.find(p=>p.m.key===focus?.key&&p.m.section===focus?.section);if(dot){ctx.strokeStyle='rgba(26,142,85,.77)';ctx.lineWidth=1;ctx.beginPath();ctx.arc(dot.x,dot.y,Math.max(7,dot.r+5),0,TAU);ctx.stroke()}}
   };
   const closeTip=()=>{tooltip.hidden=true;focus=null};
   const nearest=(x:number,y:number)=>{
    let hit:typeof pointCache[number]|null=null,d=Infinity;
    for(const p of pointCache){const sq=(p.x-x)**2+(p.y-y)**2;const r=Math.max(11,Math.min(19,p.r+6));if(sq<r*r&&sq<d){hit=p;d=sq}}
    return hit;
   };
   const tip=(p:typeof pointCache[number])=>{
    focus=p.m;tooltip.hidden=false;recordType.textContent=p.m.section;recordLink.textContent=p.m.title;recordLink.href=p.m.url;
    tooltip.style.left=`${clamp(p.x,8,width-Math.min(290,width*.78)-25)}px`;
    tooltip.style.top=`${clamp(p.y,135,height-150)}px`;
   };
   // V6.1: Point-anchored zoom, with NO free panning. At 100% always return
   // to the original centred composition, regardless of prior focal points.
   const setZoom=(n:number,atX=width/2,atY=height*.525)=>{
    const old=zoom;
    zoom=clamp(n,1,10);
    if(zoom<=1.000001){
      zoom=1;panX=0;panY=0;
    }else{
      const factor=zoom/old;
      panX=(atX-width*.5)+(panX-(atX-width*.5))*factor;
      panY=(atY-height*.525)+(panY-(atY-height*.525))*factor;
      // If a pointer is in an empty edge of the canvas, prevent the body
      // centre from being thrown completely beyond the viewport.
      const safeX=(zoom-1)*width*.51;
      const safeY=(zoom-1)*height*.51;
      panX=clamp(panX,-safeX,safeX);
      panY=clamp(panY,-safeY,safeY);
    }
    if(zoomLabel)zoomLabel.textContent=`${Math.round(zoom*100)}%`;
    closeTip();interactionEnd=performance.now()+240;requestDraw();
   };
   document.querySelectorAll<HTMLButtonElement>('.grove-zoom').forEach(b=>b.addEventListener('click',()=>setZoom(zoom*(b.dataset.zoom==='in'?1.4:1/1.4))));
   document.getElementById('grove-reset')?.addEventListener('click',()=>{yaw=-.26;pitch=-.18;panX=0;panY=0;setZoom(1)});
   // Single pointer drag = 3D rotation at ALL zoom levels, never translation.
   // Wheel and pinch zoom around the pointer/fixed pinch centre. Tap = record.
   const held=new Map<number,{x:number;y:number}>();
   let lastPointer:{x:number;y:number}|null=null;
   let pinch:{distance:number;zoom:number;x:number;y:number}|null=null;
   let dragged=false,downPoint:{x:number;y:number}|null=null;
   area.addEventListener('pointerdown',e=>{
    if((e.target as HTMLElement).closest('a,button,summary'))return;
    held.set(e.pointerId,{x:e.clientX,y:e.clientY});
    interacting=true;
    if(held.size===1){lastPointer={x:e.clientX,y:e.clientY};downPoint={x:e.clientX,y:e.clientY};dragged=false}
    if(held.size===2){const [a,b]=[...held.values()];pinch={distance:Math.hypot(a.x-b.x,a.y-b.y),zoom,x:(a.x+b.x)/2,y:(a.y+b.y)/2};lastPointer=null;dragged=true}
    area.setPointerCapture(e.pointerId);
   });
   area.addEventListener('pointermove',e=>{
    if(held.has(e.pointerId)){
     held.set(e.pointerId,{x:e.clientX,y:e.clientY});
    interacting=true;
     if(held.size===2&&pinch){const [a,b]=[...held.values()];setZoom(pinch.zoom*Math.hypot(a.x-b.x,a.y-b.y)/Math.max(1,pinch.distance),pinch.x,pinch.y);dragged=true;return}
     if(lastPointer){const dx=e.clientX-lastPointer.x,dy=e.clientY-lastPointer.y;
      if(Math.hypot(e.clientX-(downPoint?.x||0),e.clientY-(downPoint?.y||0))>5)dragged=true;
      if(dragged){yaw+=dx*.0065;pitch=clamp(pitch+dy*.0055,-1.48,1.48);closeTip();requestDraw()}
      lastPointer={x:e.clientX,y:e.clientY};return}
    }
    if(fine.matches){
      if(historyActive){canvas.style.cursor='grab';closeTip();return}
      const p=nearest(e.clientX,e.clientY);canvas.style.cursor=p?'pointer':'grab';if(p)tip(p);else closeTip()
    }
   },{passive:true});
   // A selected record is a real HTML link. On touch devices its pointer events
   // must not bubble to the canvas handler, which would hide it before click.
   tooltip.addEventListener('pointerdown',e=>e.stopPropagation());
   tooltip.addEventListener('pointerup',e=>e.stopPropagation());
   tooltip.addEventListener('pointercancel',e=>e.stopPropagation());
   tooltip.addEventListener('click',e=>e.stopPropagation());
   recordLink.addEventListener('click',e=>{e.stopPropagation();});
   const end=(e:PointerEvent)=>{if((e.target as HTMLElement).closest('#grove-record-tooltip'))return;
    const hit=!historyActive&&!dragged&&held.size===1?nearest(e.clientX,e.clientY):null;
    if(area.hasPointerCapture(e.pointerId))area.releasePointerCapture(e.pointerId);
    held.delete(e.pointerId);if(held.size<2){pinch=null;lastPointer=null}if(!held.size){lastPointer=null;downPoint=null;interacting=false;interactionEnd=performance.now()+260;requestDraw()}
    if(hit){if(fine.matches)window.location.assign(hit.m.url);else tip(hit)}else if(!dragged)closeTip();
   };
   area.addEventListener('pointerup',end,{passive:true});
   area.addEventListener('pointercancel',e=>{held.delete(e.pointerId);pinch=null;lastPointer=null;dragged=false;interacting=false;interactionEnd=performance.now()+260;requestDraw()},{passive:true});
   // On the homepage, a normal mouse wheel or trackpad scroll zooms the organism.
   // Normalize wheel units (pixels, lines, or pages) and use a continuous scale,
   // rather than a fixed jump per event; keep touch pinch and +/- unchanged.
   area.addEventListener('wheel',e=>{
    if(e.deltaY===0)return;
    e.preventDefault();
    const pixels=e.deltaY*(e.deltaMode===1?16:e.deltaMode===2?height:1);
    const limited=clamp(pixels,-180,180);
    setZoom(zoom*Math.exp(-limited*.0015),e.clientX,e.clientY);
   },{passive:false});
   // Past morphology is observation only. Fetch a selected historical state on
   // demand; never embed all archived content into the homepage bundle.
   const setCurrent=()=>{
     historyLoadGeneration++;
     historyActive=false;
     activeMotionSpeed=data.motionSpeed||{whole:3,growth:3,movement:10};
     current=data.marks||[];currentRoots=data.roots||[];
     density=data.relationDensity||0;fingerprint=data.fingerprint||0;
     rebuildRoots();
     historyRange.value=String(history.length);
     if(historyDate)historyDate.textContent=' · Live';
     if(historyMeta)historyMeta.textContent='Current';
     if(recordLink)recordLink.removeAttribute('tabindex');
     closeTip();requestDraw();
   };
   const selectHistory=async(index:number)=>{
     if(index>=history.length){setCurrent();return}
     const entry=history[index];if(!entry)return;
     const generation=++historyLoadGeneration;
     historyActive=true;
     historyRange.value=String(index);
     closeTip();
     if(historyDate)historyDate.textContent=' · Loading';
     if(historyMeta)historyMeta.textContent='Loading saved morphology…';
     try{
       let item=historyCache.get(entry.id);
       if(!item){
         const response=await fetch(entry.url,{cache:'force-cache'});
         if(!response.ok)throw new Error(`HTTP ${response.status}`);
         item=await response.json() as HistoryState;
         if(!Array.isArray(item.marks)||!Array.isArray(item.roots))throw new Error('Invalid morphology snapshot');
         historyCache.set(entry.id,item);
         // Avoid unbounded client memory during exploration.
         while(historyCache.size>3)historyCache.delete(historyCache.keys().next().value!);
       }
       if(generation!==historyLoadGeneration)return;
       activeMotionSpeed=item.motionSpeed||{whole:1,growth:1,movement:1.65};
       current=item.marks;currentRoots=item.roots||[];
       density=item.relationDensity||0;
       fingerprint=current.reduce((sum,m)=>sum+Math.round(m.strength*7+m.related*2+m.seed*23),0);
       rebuildRoots();
       if(historyDate)historyDate.textContent=` · ${entry.capturedAt.slice(0,10)}`;
       if(historyMeta)historyMeta.textContent='Observation only';
       requestDraw();
     }catch(error){
       if(generation!==historyLoadGeneration)return;
       setCurrent();
       if(historyMeta)historyMeta.textContent='History could not be loaded. Showing current organism.';
     }
   };
   const loadHistoryIndex=async()=>{
     if(history.length)return;
     if(historyMeta)historyMeta.textContent='Loading history index…';
     try{
       const response=await fetch(historyIndexURL,{cache:'no-cache'});
       if(!response.ok)throw new Error(String(response.status));
       const result=await response.json() as {snapshots:HistoryEntry[]};
       if(!Array.isArray(result.snapshots))throw new Error('Invalid history index');
       history=result.snapshots.filter(entry=>entry.url?.startsWith('/murmurgrove/history/')&&entry.url.endsWith('.json'));
       historyRange.max=String(history.length);
       historyRange.value=String(history.length);
       if(historyMeta)historyMeta.textContent='';
       if(historyDate)historyDate.textContent=' · Live';
     }catch(error){
       if(historyMeta)historyMeta.textContent='History index unavailable. Current organism remains accessible.';
     }
   };
   historyToggle?.addEventListener('click',()=>{
     historyPanel.hidden=!historyPanel.hidden;
     historyToggle.setAttribute('aria-expanded',String(!historyPanel.hidden));
     if(!historyPanel.hidden)void loadHistoryIndex();
   });
   historyRange?.addEventListener('input',()=>void selectHistory(Number(historyRange.value)));
   document.getElementById('grove-history-live')?.addEventListener('click',setCurrent);
   // Optional shared-state connection. This service requires a separate Worker
   // deployment and signed graph ingest; until configured, the older local
   // visualisation remains available but is NOT a shared persistent organism.
   const pollSharedState=async()=>{
     if(!data.sharedStateEndpoint||document.hidden)return;
     try{
       const origin=new URL(data.sharedStateEndpoint).origin;
       if(!origin.startsWith('https://')&&!origin.startsWith('http://localhost'))return;
       const response=await fetch(origin+'/state',{cache:'no-store',signal:AbortSignal.timeout(4500)});
       if(!response.ok)throw new Error('Shared service unavailable');
       const packet=await response.json() as {ready?:boolean;version?:string;organs?:{id:string;p:number[]}[]};
       if(!packet.ready||packet.version!==data.sharedVersion||!Array.isArray(packet.organs)){
         sharedOnline=false;liveTargetPositions.clear();return;
       }
       for(const organ of packet.organs){
         if(!nodePositions.has(organ.id)||organ.p?.length!==3||!organ.p.every(Number.isFinite))continue;
         liveTargetPositions.set(organ.id,[organ.p[0],organ.p[1],organ.p[2]]);
       }
       sharedOnline=liveTargetPositions.size>0;
     }catch(error){sharedOnline=false;liveTargetPositions.clear();}
   };
   if(data.sharedStateEndpoint){
     void pollSharedState();
     setInterval(()=>void pollSharedState(),5000);
   }
   const animate=(t:number)=>{
    raf=0;if(!visible||document.hidden)return;
    const frameInterval=interacting||t<interactionEnd?dragInterval:idleInterval;
    if(!renderPending && t-lastPaint>=frameInterval){lastPaint=t;draw(t)}
    if(!reduce.matches||interacting||t<interactionEnd)raf=requestAnimationFrame(animate);
   };
   const sync=()=>{
    if(raf)cancelAnimationFrame(raf);raf=0;
    if(visible&&!document.hidden&&!reduce.matches)raf=requestAnimationFrame(animate);
    else requestDraw();
   };
   if('IntersectionObserver' in window){new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??true;sync()}).observe(area)}
   addEventListener('resize',resize,{passive:true});document.addEventListener('visibilitychange',sync);reduce.addEventListener('change',sync);
   resize();setCurrent();sync();
  }
 }
</script>
