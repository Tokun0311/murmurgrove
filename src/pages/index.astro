---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { createMurmurgrove } from '../lib/murmurgrove';
const [exhibitions,people,institutions,concepts]=await Promise.all([
  getCollection('exhibitions'),getCollection('people'),getCollection('institutions'),getCollection('concepts')
]);
const organism=createMurmurgrove({
  exhibitions:exhibitions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  people:people.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  institutions:institutions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  concepts:concepts.map(x=>({id:x.id,data:x.data as Record<string,any>})),
});
const historyModules=import.meta.glob('../data/murmurgrove-history/*.json',{eager:true,import:'default'});
const history=Object.values(historyModules).sort((a:any,b:any)=>String(a.capturedAt||a.capturedOn).localeCompare(String(b.capturedAt||b.capturedOn)));
const pageData={marks:organism.marks,counts:organism.counts,relationDensity:organism.relationDensity,fingerprint:organism.fingerprint,history};
---
<Base title="TOW ARCHIVE | Murmurgrove" description="A living archive whose form is generated by exhibitions, institutions, people and concepts.">
  <section class="grove-home" aria-label="Murmurgrove, a living archive">
    <div class="grove-figure" id="murmurgrove" data-fingerprint={organism.fingerprint}>
      <div class="grove-canvas-area" id="grove-canvas-area">
        <div class="grove-haze" aria-hidden="true"></div>
        <canvas id="grove-canvas" role="img" aria-label="An interactive archive organism. Zoom in to explore dots representing individual archive records."></canvas>
        <div id="grove-record-tooltip" class="grove-record-tooltip" hidden>
          <span id="grove-record-type"></span><a id="grove-record-link" href="#"></a>
        </div>
      </div>
      <div class="grove-footer">
        <button type="button" class="grove-tiny grove-history-toggle" id="grove-history-toggle" aria-expanded="false" aria-controls="grove-history-panel" title="Browse saved archive states"><span aria-hidden="true">◷</span> History</button>
        <div class="grove-controls" role="group" aria-label="Observe Murmurgrove">
          <button type="button" class="grove-mode is-selected" data-mode="whole" aria-pressed="true">Whole</button>
          <button type="button" class="grove-mode" data-mode="growth" aria-pressed="false">Growth</button>
          <button type="button" class="grove-mode" data-mode="movement" aria-pressed="false">Movement</button>
        </div>
        <div class="grove-tools">
          <button type="button" class="grove-tiny grove-zoom" data-zoom="out" aria-label="Zoom out" title="Zoom out">−</button>
          <span id="grove-zoom-label" aria-live="polite">100%</span>
          <button type="button" class="grove-tiny grove-zoom" data-zoom="in" aria-label="Zoom in to archive records" title="Zoom in">+</button>
          <button type="button" class="grove-tiny" id="grove-reset" aria-label="Reset view" title="Reset view">↺</button>
          <details class="grove-info"><summary aria-label="About Murmurgrove" title="About Murmurgrove">i</summary>
            <p>The form is generated from your archive. Zoom in to discover individual records: each visible record dot leads to its page. Move or pinch to explore. History uses saved content snapshots; a new snapshot is recorded when the repository updates, if GitHub Actions is enabled.</p>
          </details>
        </div>
      </div>
      <div class="grove-history-panel" id="grove-history-panel" hidden>
        <label for="grove-history-range">Archive state <span id="grove-history-date"></span></label>
        <input id="grove-history-range" type="range" min="0" max={Math.max(0,history.length)} value={history.length} step="1" />
        <button id="grove-history-live" class="grove-tiny" type="button">Current</button>
        <span id="grove-history-meta" aria-live="polite"></span>
      </div>
      <span class="sr-only" id="grove-announcement" aria-live="polite"></span>
    </div>
  </section>
  <script type="application/json" id="grove-data" set:html={JSON.stringify(pageData).replace(/</g,'\u003c')}></script>
</Base>
<style>
.grove-home{padding:0;min-height:calc(100svh - 155px)}
.grove-figure{position:relative;min-height:calc(100svh - 155px);isolation:isolate;display:flex;flex-direction:column}
.grove-canvas-area{position:relative;width:100%;height:clamp(460px,69svh,820px);overflow:hidden;touch-action:pan-y;background:radial-gradient(ellipse 55% 46% at 50% 50%,rgba(183,233,201,.075),transparent 80%)}
.grove-haze{pointer-events:none;position:absolute;inset:5% 6%;z-index:0;background:radial-gradient(ellipse at 48% 48%,rgba(185,239,198,.075),transparent 57%)}
#grove-canvas{display:block;position:absolute;inset:0;width:100%;height:100%;z-index:1;cursor:zoom-in}
.grove-record-tooltip{position:absolute;z-index:4;width:max-content;max-width:min(310px,80vw);padding:9px 13px;border:1px solid #c9e5d1;border-radius:8px;background:rgba(255,255,255,.97);box-shadow:0 8px 25px rgba(49,98,64,.09);pointer-events:auto;font-size:12px;line-height:1.5;transform:translate(10px,12px)}
.grove-record-tooltip[hidden]{display:none}
#grove-record-type{font-size:9px;text-transform:uppercase;letter-spacing:.11em;color:#79a28b;display:block;margin-bottom:3px}
#grove-record-link{color:#087b55;text-decoration:none;display:block;overflow-wrap:anywhere}
#grove-record-link:hover{text-decoration:underline}
.grove-footer{position:relative;z-index:5;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;margin:clamp(44px,6.5vh,78px) 2.5% 16px;min-height:42px}
.grove-controls{display:flex;align-items:center;gap:3px;white-space:nowrap;padding:4px;border-radius:40px;background:rgba(255,255,255,.78);border:1px solid rgba(145,191,163,.27)}
.grove-mode,.grove-tiny{appearance:none;border:1px solid transparent;background:transparent;color:#63957a;font:inherit;font-size:11px;line-height:1.3;letter-spacing:.01em;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.grove-mode{border-radius:32px;padding:7px 13px}
.grove-mode:hover,.grove-tiny:hover{background:rgba(226,245,232,.7);color:#087a55}
.grove-mode.is-selected{background:rgba(220,242,227,.7);border-color:rgba(124,190,148,.34);color:#087a55}
.grove-mode:focus-visible,.grove-tiny:focus-visible,.grove-info summary:focus-visible{outline:2px solid #168760;outline-offset:3px}
.grove-tiny{padding:6px 8px;border-radius:20px;white-space:nowrap}
.grove-tools{display:flex;align-items:center;justify-self:end;gap:4px;color:#679b7c}
.grove-history-toggle{justify-self:start;border:1px solid rgba(145,191,163,.25);padding:8px 12px}
#grove-zoom-label{font-size:10px;color:#82a892;min-width:32px;text-align:center;font-variant-numeric:tabular-nums}
.grove-info{position:relative;color:#679b7c}
.grove-info summary{list-style:none;display:grid;place-items:center;border:1px solid rgba(137,187,155,.42);width:23px;height:23px;border-radius:50%;font-size:12px;font-family:Georgia,serif;font-style:italic;cursor:pointer;background:rgba(255,255,255,.72)}
.grove-info summary::-webkit-details-marker{display:none}
.grove-info p{position:absolute;right:0;bottom:32px;width:min(300px,77vw);padding:13px 15px;margin:0;background:rgba(255,255,255,.97);border:1px solid #d9e9df;border-radius:8px;color:#54866b;font-size:11px;line-height:1.8;box-shadow:0 9px 24px rgba(49,98,64,.05)}
.grove-history-panel{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:12px 3%;margin-bottom:18px;font-size:11px;color:#6b9a7b}
.grove-history-panel[hidden]{display:none}
.grove-history-panel input{accent-color:#268e62;flex:1;min-width:120px}
.grove-history-panel label{white-space:nowrap}
#grove-history-date{color:#087b55;font-variant-numeric:tabular-nums}
#grove-history-meta{font-size:10px;color:#82a892}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:650px){
 .grove-home,.grove-figure{min-height:calc(100svh - 116px)}
 .grove-canvas-area{height:clamp(370px,58svh,630px)}
 .grove-footer{margin:clamp(45px,7svh,78px) 0 20px;grid-template-columns:1fr auto;row-gap:13px}
 .grove-controls{grid-column:1/-1;grid-row:1;justify-self:center}
 .grove-mode{font-size:10px;padding:7px 12px}
 .grove-history-toggle{grid-column:1;grid-row:2}
 .grove-tools{grid-column:2;grid-row:2}
 .grove-history-panel{margin-top:4px;padding:12px 0}
}
@media(prefers-reduced-motion:reduce){.grove-mode,.grove-tiny{transition:none}}
</style>
<script>
  type Mark={key:string;section:string;title:string;url:string;strength:number;recency:number;related:number;x:number;y:number;seed:number};
  const dataEl=document.getElementById('grove-data');
  const canvas=document.getElementById('grove-canvas') as HTMLCanvasElement | null;
  const area=document.getElementById('grove-canvas-area') as HTMLElement | null;
  if(dataEl && canvas && area){
    const data=JSON.parse(dataEl.textContent||'{}') as {marks:Mark[];relationDensity:number;fingerprint:number;history:{capturedOn:string;marks:Mark[];relationDensity:number;counts:Record<string,number>}[]};
    const ctx=canvas.getContext('2d',{alpha:true});
    if(ctx){
      const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
      const fine=window.matchMedia('(pointer: fine)');
      const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('.grove-mode'));
      const announcement=document.getElementById('grove-announcement');
      const names:Record<string,string>={whole:'Whole archive: accumulated records',growth:'Recent growth: newer encounters highlighted',movement:'Movement: collective motion emphasized'};
      let mode:'whole'|'growth'|'movement'='whole';
      let zoom=1,panX=0,panY=0,selectedHistory=-1;
      const tooltip=document.getElementById('grove-record-tooltip') as HTMLElement|null;
      const link=document.getElementById('grove-record-link') as HTMLAnchorElement|null;
      const typeLabel=document.getElementById('grove-record-type');
      const historyPanel=document.getElementById('grove-history-panel') as HTMLElement|null;
      const historyToggle=document.getElementById('grove-history-toggle') as HTMLButtonElement|null;
      const historyRange=document.getElementById('grove-history-range') as HTMLInputElement|null;
      const historyDate=document.getElementById('grove-history-date');
      const historyMeta=document.getElementById('grove-history-meta');
      const zoomLabel=document.getElementById('grove-zoom-label');
      const history=data.history||[];
      let density=data.relationDensity||0,fingerprint=data.fingerprint||0;
      const markFrom=(m:Mark,i:number)=>({...m,index:i,phase:seed(m.key+'phase')*TAU,positionX:0,positionY:0});
      let frame=0,last=0,visible=true,width=0,height=0,dpr=1;
      let pointer={x:-500,y:-500,active:false};
      const TAU=Math.PI*2;
      const seed=(s:string)=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return(h>>>0)/4294967295};
      let marks=(data.marks||[]).map(markFrom);
      // A stable multi-branch structure. Archive density thickens roots;
      // distinct collection relationships influence the overall spread.
      // Root count expands slowly with archive diversity. At any scale we draw
      // aggregated organization, while all individual records remain available on zoom.
      const buildRoots=()=>{
        const count=Math.min(76,Math.max(19,Math.round(11+Math.sqrt(marks.length)*.68+Math.log1p(marks.length)*1.8)));
        return Array.from({length:count},(_,i)=>({
          i,angle:(i/count)*TAU+.18*Math.sin(i*2.1),
          bend:.12+.27*seed('bend'+i), reach:.54+.37*seed('reach'+i), phase:seed('branch'+i)*TAU,
          influence:marks.reduce((sum,m)=>{
            const mAngle=Math.atan2(m.y-.5,m.x-.5);
            const delta=Math.atan2(Math.sin(mAngle-(i/count)*TAU),Math.cos(mAngle-(i/count)*TAU));
            return sum+(Math.abs(delta)<.18+.15/Math.sqrt(count/19)?Math.log1p(m.related)*.6+m.strength*.7:0);
          },0)
        }));
      };
      let roots=buildRoots();
      const buildFlock=()=>Array.from({length:Math.min(650,Math.max(155,Math.round(95+Math.sqrt(marks.length)*20)))},(_,i)=>({
        i,angle:seed('flockangle'+i)*TAU,r:.08+.88*Math.sqrt(seed('flockradius'+i)),
        phase:seed('flockphase'+i)*TAU,speed:.58+seed('flockspeed'+i)*.9,
        size:.5+seed('flocksize'+i)*1.4,fade:.22+.6*seed('flockfade'+i)
      }));
      let flock=buildFlock();
      const resize=()=>{
        const rect=area.getBoundingClientRect();
        width=Math.max(1,rect.width);height=Math.max(1,rect.height);
        dpr=Math.min(window.devicePixelRatio||1,2);
        canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
        ctx.setTransform(dpr,0,0,dpr,0,0);
        draw(last||0);
      };
      const nodePosition=(m:typeof marks[number],t:number,scaleX:number,scaleY:number)=>{
        const sway=reduce.matches?0:Math.sin(t*.00023+m.phase)*.008;
        const spread=Math.min(1.19,.87+Math.sqrt(Math.max(1,marks.length))/75);
        const xx=(m.x-.5)*spread+Math.sin(m.phase+t*.00015)*.018+sway;
        const yy=(m.y-.5)*spread+Math.cos(m.phase*1.7+t*.00014)*.019;
        return [width*.5+xx*scaleX,height*.49+yy*scaleY] as const;
      };
      const draw=(t:number)=>{
        if(!width||!height)return;
        ctx.setTransform(dpr,0,0,dpr,0,0);
        ctx.clearRect(0,0,width,height);
        ctx.save();
        ctx.translate(width*.5+panX,height*.49+panY);
        ctx.scale(zoom,zoom);
        ctx.translate(-width*.5,-height*.49);
        const mobile=width<560;
        const sx=width*(mobile ? .93 : .85), sy=height*(mobile ? .85 : .87);
        const cX=width*.5,cY=height*.49;
        const growth=mode==='growth',movement=mode==='movement';
        // Slow translucent tissue layers form a single continuous body.
        const layers=Math.min(9,5+Math.floor(Math.log2(Math.max(1,marks.length)/140+1)*1.6));
        for(let layer=layers-1;layer>=0;layer--){
          const radius=(.29+layer*.045)*Math.min(sx,sy)*1.23*(1+Math.min(.13,Math.log1p(marks.length)/90));
          ctx.beginPath();
          for(let j=0;j<=150;j++){
            const a=j/150*TAU;
            const relationBoost=Math.min(.12,density*.018);
            const ripple=1+.11*Math.sin(a*4+fingerprint*.009+layer*.63)+relationBoost*Math.sin(a*5.8+layer*.4)
              +.075*Math.sin(a*7.7+layer*1.7)
              +(reduce.matches?0:.032*Math.cos(a*5-t*.00019+layer));
            const x=cX+Math.cos(a)*radius*ripple*(mobile?1.05:1.7);
            const y=cY+Math.sin(a)*radius*ripple*.88;
            if(j===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
          }
          ctx.closePath();
          ctx.fillStyle=`rgba(140,211,165,${.016+(layers-layer)*.004})`;
          ctx.fill();
          ctx.lineWidth=.65;
          ctx.strokeStyle=`rgba(94,174,125,${.06+(layers-layer)*.014})`;
          ctx.stroke();
        }
        // Mangrove principle: anchored ramifications, not a concepts-style line graph.
        roots.forEach(branch=>{
          const variation=Math.log1p(branch.influence)*.115;
          const growthLength=branch.reach*(.85+Math.min(.35,variation));
          const angle=branch.angle;
          const cx=cX+Math.cos(angle)*sx*.12;
          const cy=cY+Math.sin(angle)*sy*.09;
          const ex=cX+Math.cos(angle+Math.sin(angle*3+branch.phase)*.22)*sx*(.27+growthLength*.2);
          const ey=cY+Math.sin(angle)*sy*(.22+growthLength*.16);
          const bend=branch.bend;
          ctx.beginPath();ctx.moveTo(cx,cy);
          ctx.bezierCurveTo(cx+Math.cos(angle+bend)*sx*.13,cy+Math.sin(angle-bend)*sy*.14,
            ex-Math.cos(angle-.38)*sx*.1,ey-Math.sin(angle+.23)*sy*.11,ex,ey);
          ctx.strokeStyle=`rgba(50,138,93,${(growth ? .19 : .14)+Math.min(.18,variation)})`;
          ctx.lineWidth=.65+Math.min(1.5,Math.log1p(branch.influence)*.3);
          ctx.stroke();
          for(let k=0;k<3;k++){
            const r=.45+k*.15;
            const bx=cx+(ex-cx)*r,by=cy+(ey-cy)*r;
            const branchAngle=angle+(k%2===0?1:-1)*(.4+branch.bend);
            const len=(.04+.025*seed('twig'+branch.i+':'+k))*Math.min(sx,sy);
            ctx.beginPath();ctx.moveTo(bx,by);
            ctx.quadraticCurveTo(bx+len*.3*Math.cos(branchAngle),by+len*.36*Math.sin(branchAngle),bx+len*Math.cos(branchAngle),by+len*Math.sin(branchAngle));
            ctx.strokeStyle='rgba(65,148,104,.12)';ctx.lineWidth=.65;ctx.stroke();
          }
        });
        // Record-derived growth sites quietly retain a memory of past additions.
        const markerStride=zoom<1.3?Math.max(1,Math.ceil(marks.length/950)):1;
        for(const m of marks){
          // At overview scale, preserve visual restraint for large future archives.
          if(zoom<1.3 && marks.length>950 && m.index%markerStride!==0)continue;
          const [x,y]=nodePosition(m,t,sx,sy);
          if(zoom>1.25){const visibleX=(x-width*.5)*zoom+width*.5+panX,visibleY=(y-height*.49)*zoom+height*.49+panY;
            if(visibleX< -35||visibleX>width+35||visibleY< -35||visibleY>height+35)continue;}

          m.positionX=x;m.positionY=y;
          const intensity=growth?m.recency*.72+.06:.21+m.strength*.14;
          const radius=1.1+Math.sqrt(m.strength)*2.5+(growth?m.recency*2.4:0)+(zoom>1.25?1.15:0);
          const halo=ctx.createRadialGradient(x,y,0,x,y,radius*8);
          halo.addColorStop(0,`rgba(51,171,94,${Math.min(.2,intensity*.5)})`);
          halo.addColorStop(1,'rgba(51,171,94,0)');
          ctx.fillStyle=halo;ctx.beginPath();ctx.arc(x,y,radius*8,0,TAU);ctx.fill();
          ctx.fillStyle=`rgba(23,125,79,${Math.min(.67,intensity+.09)})`;
          ctx.beginPath();ctx.arc(x,y,Math.max(.6,radius*.48),0,TAU);ctx.fill();
        }
        // Murmuration principle: hundreds of smaller units flow collectively
        // through the tissue. Motion is coherent, not per-label jitter.
        const speed=movement?1.8:.8;
        // At detail scale all visible dots are real linked records, not ornamental flock particles.
        if(zoom<1.25)for(const f of flock){
          const u=f.angle+(reduce.matches?0:t*.000033*speed*f.speed);
          const swirl=.13*Math.sin(u*3+f.phase + (reduce.matches?0:t*.00018*speed));
          const r=f.r*(1+.12*Math.sin(u*2.1+fingerprint*.013));
          const px=cX+Math.cos(u+swirl)*sx*(.39*r);
          const py=cY+Math.sin(u*.91+swirl)*sy*(.38*r);
          let x=px,y=py;
          if(pointer.active&&!reduce.matches){
            const dx=px-pointer.x,dy=py-pointer.y;
            const d=Math.hypot(dx,dy);
            const range=Math.min(145,width*.24);
            if(d<range&&d>0){const push=(1-d/range)**2*24;x+=dx/d*push;y+=dy/d*push;}
          }
          ctx.beginPath();ctx.arc(x,y,Math.min(1.9,f.size*(mobile ? .8 : 1)),0,TAU);
          ctx.fillStyle=`rgba(38,136,85,${Math.min(.65,f.fade*(growth ? .28 : movement ? .82 : .64))})`;
          ctx.fill();
        }
        // A few subtle luminous folds communicate collective movement.
        if(!reduce.matches){
          ctx.beginPath();
          for(let j=0;j<=85;j++){
            const u=j/85;
            const x=cX+sx*(u-.5)*.86;
            const y=cY+Math.sin(u*TAU*2.4+t*.00027)*sy*.087;
            if(j===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
          }
          ctx.lineWidth=.5;ctx.strokeStyle='rgba(76,171,111,.095)';ctx.stroke();
        }
        ctx.restore();
      };
      const tick=(time:number)=>{
        frame=0;last=time;
        if(!visible||document.hidden)return;
        draw(time);
        if(!reduce.matches)frame=requestAnimationFrame(tick);
      };
      const sync=()=>{
        if(frame){cancelAnimationFrame(frame);frame=0;}
        if(visible&&!document.hidden){
          draw(last||0);
          if(!reduce.matches)frame=requestAnimationFrame(tick);
        }
      };
      buttons.forEach(button=>button.addEventListener('click',()=>{
        const next=button.dataset.mode;
        if(next!=='whole'&&next!=='growth'&&next!=='movement')return;
        mode=next;
        buttons.forEach(b=>{const active=b===button;b.classList.toggle('is-selected',active);b.setAttribute('aria-pressed',String(active));});
        if(announcement)announcement.textContent=names[mode];
        draw(last||0);
      }));
      const closeTip=()=>{if(tooltip)tooltip.hidden=true;};
      const screenPosition=(m:typeof marks[number])=>{
        const mobile=width<560,sx=width*(mobile?.93:.85),sy=height*(mobile?.85:.87);
        const [x,y]=nodePosition(m,last||0,sx,sy);
        return {x:width*.5+(x-width*.5)*zoom+panX,y:height*.49+(y-height*.49)*zoom+panY};
      };
      const nearest=(x:number,y:number)=>{
        if(zoom<1.25)return null;
        let match:typeof marks[number]|null=null,closest=Infinity;
        for(const m of marks){
          const p=screenPosition(m);if(Math.abs(p.x-x)>18||Math.abs(p.y-y)>18)continue;
          const d=(p.x-x)**2+(p.y-y)**2;
          if(d<closest){match=m;closest=d;}
        }
        return closest<=Math.max(105,zoom*zoom*15)?match:null;
      };
      const showTip=(m:typeof marks[number],x:number,y:number)=>{
        if(!tooltip||!link)return;
        tooltip.hidden=false;
        link.href=m.url;link.textContent=m.title;
        if(typeLabel)typeLabel.textContent=m.section;
        tooltip.style.left=`${Math.max(8,Math.min(width-235,x))}px`;
        tooltip.style.top=`${Math.max(8,Math.min(height-84,y))}px`;
      };
      const constrainPan=()=>{
        const limX=width*(zoom-1)*.52+20,limY=height*(zoom-1)*.52+20;
        panX=Math.max(-limX,Math.min(limX,panX));panY=Math.max(-limY,Math.min(limY,panY));
      };
      const setZoom=(next:number,atX=width*.5,atY=height*.49)=>{
        const before=zoom;zoom=Math.max(1,Math.min(7,next));
        panX=(panX+width*.5-atX)*(zoom/before)+atX-width*.5;
        panY=(panY+height*.49-atY)*(zoom/before)+atY-height*.49;
        if(zoom===1){panX=0;panY=0;}
        constrainPan();
        if(zoomLabel)zoomLabel.textContent=`${Math.round(zoom*100)}%`;
        area.style.touchAction=zoom>1.1?'none':'pan-y';
        canvas.style.cursor=zoom>1.1?'grab':'zoom-in';
        closeTip();draw(last||0);
      };
      document.querySelectorAll<HTMLButtonElement>('.grove-zoom').forEach(btn=>btn.addEventListener('click',()=>setZoom(zoom*(btn.dataset.zoom==='in'?1.55:1/1.55))));
      document.getElementById('grove-reset')?.addEventListener('click',()=>setZoom(1));
      area.addEventListener('wheel',e=>{
        // Wheel/trackpad zoom remains local to the organism, not the entire page.
        if(!e.ctrlKey&&!e.altKey)return; // normal page scrolling still works
        e.preventDefault();const r=area.getBoundingClientRect();
        setZoom(zoom*(e.deltaY<0?1.18:1/1.18),e.clientX-r.left,e.clientY-r.top);
      },{passive:false});
      const held=new Map<number,{x:number;y:number}>();
      let pointerStart:{x:number;y:number;panX:number;panY:number}|null=null;
      let pinchStart:{distance:number;zoom:number;centerX:number;centerY:number}|null=null;
      let dragged=false;
      area.addEventListener('pointerdown',e=>{
        if((e.target as HTMLElement).closest('a'))return;
        const rect=area.getBoundingClientRect();const x=e.clientX-rect.left,y=e.clientY-rect.top;
        held.set(e.pointerId,{x,y});dragged=false;
        pointerStart={x,y,panX,panY};
        if(held.size===2){const [a,b]=[...held.values()];pinchStart={distance:Math.hypot(a.x-b.x,a.y-b.y),zoom,centerX:(a.x+b.x)/2,centerY:(a.y+b.y)/2};}
        if(zoom>1.1)area.setPointerCapture(e.pointerId);
        pointer={x:width*.5+(x-width*.5-panX)/zoom,y:height*.49+(y-height*.49-panY)/zoom,active:true};
      },{passive:true});
      area.addEventListener('pointermove',e=>{
        const rect=area.getBoundingClientRect(),x=e.clientX-rect.left,y=e.clientY-rect.top;
        if(held.has(e.pointerId))held.set(e.pointerId,{x,y});
        if(held.size===2&&pinchStart){
          const [a,b]=[...held.values()];const dis=Math.hypot(a.x-b.x,a.y-b.y);
          setZoom(pinchStart.zoom*dis/Math.max(1,pinchStart.distance),pinchStart.centerX,pinchStart.centerY);
          dragged=true;closeTip();return;
        }
        if(zoom>1.1&&held.size===1&&pointerStart){
          if(Math.hypot(x-pointerStart.x,y-pointerStart.y)>5)dragged=true;
          if(dragged){panX=pointerStart.panX+x-pointerStart.x;panY=pointerStart.panY+y-pointerStart.y;constrainPan();closeTip();draw(last||0);return;}
        }
        pointer={x:width*.5+(x-width*.5-panX)/zoom,y:height*.49+(y-height*.49-panY)/zoom,active:true};
        if(fine.matches){const m=nearest(x,y);canvas.style.cursor=m?'pointer':zoom>1.1?'grab':'zoom-in';if(m)showTip(m,x,y);else closeTip();}
      },{passive:true});
      area.addEventListener('pointerup',e=>{
        const r=area.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;
        const m=!dragged?nearest(x,y):null;
        held.delete(e.pointerId);
        if(held.size<2)pinchStart=null;
        if(held.size===0){pointerStart=null;pointer.active=false;}
        if(m){
          if(fine.matches){window.location.assign(m.url);}
          else showTip(m,x,y); // touch: expose readable link, avoid accidental navigation
        } else if(!dragged&&zoom<1.25){setZoom(1.8,x,y);}
        else if(!dragged)closeTip();
      },{passive:true});
      area.addEventListener('pointercancel',e=>{held.delete(e.pointerId);pinchStart=null;pointerStart=null;pointer.active=false;},{passive:true});
      area.addEventListener('pointerleave',()=>{if(held.size===0){pointer.active=false;if(fine.matches)closeTip();}},{passive:true});
      // Saved, immutable snapshots represent actual captured source states, not reconstructed visits.
      const setHistory=(index:number)=>{
        selectedHistory=index;
        const item=index<0?null:history[index];
        marks=(item?.marks||data.marks||[]).map(markFrom);
        density=item?.relationDensity||data.relationDensity||0;
        fingerprint=marks.reduce((v,m)=>v+Math.round(m.strength*7+m.related*2+m.seed*23),0);
        roots=buildRoots();flock=buildFlock();
        if(historyRange)historyRange.value=String(index<0?history.length:index);
        if(historyDate)historyDate.textContent=item?.capturedAt?new Date(item.capturedAt).toLocaleString(undefined,{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}):item?.capturedOn||'Now';
        if(historyMeta)historyMeta.textContent=item?`${marks.length} records · saved source state`:`${marks.length} records · current archive`;
        closeTip();draw(last||0);
      };
      historyToggle?.addEventListener('click',()=>{
        if(!historyPanel)return;
        historyPanel.hidden=!historyPanel.hidden;
        historyToggle.setAttribute('aria-expanded',String(!historyPanel.hidden));
      });
      historyRange?.addEventListener('input',()=>{
        const index=Number(historyRange.value);
        setHistory(index>=history.length?-1:index);
      });
      document.getElementById('grove-history-live')?.addEventListener('click',()=>setHistory(-1));
      setHistory(-1);
      let observer:IntersectionObserver|null=null;
      if('IntersectionObserver' in window){observer=new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??true;sync();},{threshold:.01});observer.observe(area);}
      window.addEventListener('resize',resize,{passive:true});
      document.addEventListener('visibilitychange',sync);
      reduce.addEventListener('change',sync);
      resize();sync();
    }
  }
</script>
