---
import Base from '../layouts/Base.astro';
---
<Base title="Murmurgrove | TOW ARCHIVE" description="An evolving research organism grown from the real exhibitions, people, institutions and concepts of TOW ARCHIVE.">
  <section class="grove-home" aria-label="Murmurgrove, a living research archive">
    <iframe
      class="grove-embedded-view"
      id="murmurgrove-view"
      src="/murmurgrove/organism/index.html?embedded=1"
      title="Murmurgrove interactive organism and research history"
      loading="eager"
      referrerpolicy="same-origin"
    ></iframe>
    <p class="sr-only">Explore the research organism using drag, scroll, pinch, keyboard-focusable controls, or the History panel. Select an archive point to open its reading card.</p>
  </section>
</Base>
<script is:inline>
  // The shared layout retains its original language on other archive pages.
  document.documentElement.lang = "en";
</script>
<style>
  /* Only the immersive HOME is full-viewport; Base.astro remains identical
     to all TOW ARCHIVE pages, including its logo, rule and both nav systems. */
  .grove-home{position:fixed;inset:0;z-index:0;overflow:hidden;background:#fafbf8}
  .grove-embedded-view{display:block;width:100%;height:100%;height:100dvh;border:0;background:#fafbf8}
  @media(prefers-reduced-motion:reduce){.grove-embedded-view{scroll-behavior:auto}}
</style>
