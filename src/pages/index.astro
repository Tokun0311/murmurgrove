---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { createMurmurgrove } from '../lib/murmurgrove';
const [exhibitions,people,institutions,concepts]=await Promise.all([
  getCollection('exhibitions'),getCollection('people'),getCollection('institutions'),getCollection('concepts')
]);
const organism=createMurmurgrove({
  exhibitions:exhibitions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  people:people.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  institutions:institutions.map(x=>({id:x.id,data:x.data as Record<string,any>})),
  concepts:concepts.map(x=>({id:x.id,data:x.data as Record<string,any>})),
});
const pageData={marks:organism.marks,counts:organism.counts,relationDensity:organism.relationDensity,fingerprint:organism.fingerprint};
---
<Base title="TOW ARCHIVE | Murmurgrove" description="An evolving archive of encounters, institutions, people and concepts. A living form shaped by the archive as a whole.">
  <section class="grove-home" aria-label="Murmurgrove, a living archive">
    <div class="grove-figure" id="murmurgrove" data-fingerprint={organism.fingerprint}>
      <div class="grove-canvas-area" id="grove-canvas-area">
        <div class="grove-haze" aria-hidden="true"></div>
        <canvas id="grove-canvas" aria-label="Animated organic illustration representing the connected archive. Its changing form is derived from exhibitions, institutions, people and concepts." role="img"></canvas>
      </div>
      <div class="grove-controls" role="group" aria-label="Observe Murmurgrove">
        <button type="button" class="grove-mode is-selected" data-mode="whole" aria-pressed="true" aria-label="Whole archive" title="Whole archive">Whole</button>
        <button type="button" class="grove-mode" data-mode="growth" aria-pressed="false" aria-label="Recent growth" title="Recent growth">Growth</button>
        <button type="button" class="grove-mode" data-mode="movement" aria-pressed="false" aria-label="Collective movement" title="Collective movement">Movement</button>
      </div>
      <details class="grove-info">
        <summary aria-label="About this living form" title="About this living form">i</summary>
        <p>This living form is generated from exhibitions, institutions, people and concepts. Its structure changes when the archive is updated; its movement continues between updates.</p>
      </details>
      <span class="sr-only" id="grove-announcement" aria-live="polite"></span>
    </div>
  </section>
  <script type="application/json" id="grove-data" set:html={JSON.stringify(pageData).replace(/</g,'\\u003c')}></script>
</Base>
<style>
/* Preserve the shared masthead divider from Base; no extra section borders. */
.grove-home{padding:0;min-height:calc(100svh - 150px)}
.grove-figure{position:relative;isolation:isolate;min-height:calc(100svh - 150px)}
.grove-canvas-area{position:relative;width:100%;height:max(510px,calc(100svh - 155px));overflow:hidden;touch-action:pan-y;background:radial-gradient(ellipse 55% 46% at 50% 50%,rgba(183,233,201,.075),transparent 80%)}
.grove-haze{pointer-events:none;position:absolute;inset:5% 6%;z-index:0;background:radial-gradient(ellipse at 48% 48%,rgba(185,239,198,.075),transparent 57%)}
#grove-canvas{display:block;position:absolute;inset:0;width:100%;height:100%;z-index:1}
.grove-controls{position:absolute;z-index:3;bottom:clamp(14px,3.3vh,34px);left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:4px;white-space:nowrap;padding:4px;border-radius:40px;background:rgba(255,255,255,.72);border:1px solid rgba(145,191,163,.22);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.grove-mode{appearance:none;border:1px solid transparent;background:transparent;color:#63957a;border-radius:32px;font:inherit;font-size:11px;line-height:1.3;letter-spacing:.01em;padding:7px 13px;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.grove-mode:hover{background:rgba(226,245,232,.7);color:#087a55}
.grove-mode.is-selected{background:rgba(220,242,227,.7);border-color:rgba(124,190,148,.34);color:#087a55}
.grove-mode:focus-visible,.grove-info summary:focus-visible{outline:2px solid #168760;outline-offset:3px}
.grove-info{position:absolute;z-index:4;bottom:clamp(20px,3.9vh,40px);right:clamp(8px,2vw,28px);font:inherit;color:#679b7c}
.grove-info summary{list-style:none;display:grid;place-items:center;border:1px solid rgba(137,187,155,.42);width:23px;height:23px;border-radius:50%;font-size:12px;font-family:Georgia,serif;font-style:italic;cursor:pointer;background:rgba(255,255,255,.72)}
.grove-info summary::-webkit-details-marker{display:none}
.grove-info p{position:absolute;right:0;bottom:29px;width:min(285px,76vw);padding:13px 15px;margin:0;background:rgba(255,255,255,.96);border:1px solid #d9e9df;border-radius:8px;color:#54866b;font-size:11px;line-height:1.75;box-shadow:0 9px 24px rgba(49,98,64,.04)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:650px){
  .grove-home,.grove-figure{min-height:calc(100svh - 116px)}
  .grove-canvas-area{height:max(400px,calc(100svh - 120px))}
  .grove-controls{bottom:25px;gap:1px;padding:3px}
  .grove-mode{font-size:10px;padding:7px 10px}
  .grove-info{bottom:34px;right:7px}
}
@media(prefers-reduced-motion:reduce){.grove-mode{transition:none}}
</style>
<script>
  type Mark={key:string;section:string;strength:number;recency:number;related:number;x:number;y:number;seed:number};
  const dataEl=document.getElementById('grove-data');
  const canvas=document.getElementById('grove-canvas') as HTMLCanvasElement | null;
  const area=document.getElementById('grove-canvas-area') as HTMLElement | null;
  if(dataEl && canvas && area){
    const data=JSON.parse(dataEl.textContent||'{}') as {marks:Mark[];relationDensity:number;fingerprint:number};
    const ctx=canvas.getContext('2d',{alpha:true});
    if(ctx){
      const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
      const fine=window.matchMedia('(pointer: fine)');
      const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('.grove-mode'));
      const announcement=document.getElementById('grove-announcement');
      const names:Record<string,string>={whole:'Whole archive: accumulated records',growth:'Recent growth: newer encounters highlighted',movement:'Movement: collective motion emphasized'};
      let mode:'whole'|'growth'|'movement'='whole';
      let frame=0,last=0,visible=true,width=0,height=0,dpr=1;
      let pointer={x:-500,y:-500,active:false};
      const TAU=Math.PI*2;
      const seed=(s:string)=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return(h>>>0)/4294967295};
      const marks=(data.marks||[]).map((m,i)=>({...m,index:i,phase:seed(m.key+'phase')*TAU,positionX:0,positionY:0}));
      // A stable multi-branch structure. Archive density thickens roots;
      // distinct collection relationships influence the overall spread.
      const roots=Array.from({length:19},(_,i)=>({
        i,angle:(i/19)*TAU + .18*Math.sin(i*2.1),
        bend:.12+.27*seed('bend'+i),
        reach:.54+.37*seed('reach'+i),
        phase:seed('branch'+i)*TAU,
        influence:marks.filter(m=>Math.abs(Math.atan2(Math.sin(Math.atan2(m.y-.5,m.x-.5)-(i/19)*TAU),Math.cos(Math.atan2(m.y-.5,m.x-.5)-(i/19)*TAU)))<.35).reduce((sum,m)=>sum+Math.min(6,m.related)*.42+m.strength*.7,0)
      }));
      const flock=Array.from({length:Math.min(580,Math.max(155,Math.round(95+marks.length*2.2)))},(_,i)=>({
        i,angle:seed('flockangle'+i)*TAU,r:.08+.88*Math.sqrt(seed('flockradius'+i)),
        phase:seed('flockphase'+i)*TAU,speed:.58+seed('flockspeed'+i)*.9,
        size:.5+seed('flocksize'+i)*1.4,fade:.22+.6*seed('flockfade'+i)
      }));
      const resize=()=>{
        const rect=area.getBoundingClientRect();
        width=Math.max(1,rect.width);height=Math.max(1,rect.height);
        dpr=Math.min(window.devicePixelRatio||1,2);
        canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
        ctx.setTransform(dpr,0,0,dpr,0,0);
        draw(last||0);
      };
      const nodePosition=(m:typeof marks[number],t:number,scaleX:number,scaleY:number)=>{
        const sway=reduce.matches?0:Math.sin(t*.00023+m.phase)*.008;
        const spread=Math.min(1.19,.87+Math.sqrt(Math.max(1,marks.length))/75);
        const xx=(m.x-.5)*spread+Math.sin(m.phase+t*.00015)*.018+sway;
        const yy=(m.y-.5)*spread+Math.cos(m.phase*1.7+t*.00014)*.019;
        return [width*.5+xx*scaleX,height*.49+yy*scaleY] as const;
      };
      const draw=(t:number)=>{
        if(!width||!height)return;
        ctx.clearRect(0,0,width,height);
        const mobile=width<560;
        const sx=width*(mobile ? .93 : .85), sy=height*(mobile ? .85 : .87);
        const cX=width*.5,cY=height*.49;
        const growth=mode==='growth',movement=mode==='movement';
        // Slow translucent tissue layers form a single continuous body.
        const layers=5;
        for(let layer=layers-1;layer>=0;layer--){
          const radius=(.29+layer*.045)*Math.min(sx,sy)*1.23;
          ctx.beginPath();
          for(let j=0;j<=150;j++){
            const a=j/150*TAU;
            const relationBoost=Math.min(.12,(data.relationDensity||0)*.018);
            const ripple=1+.11*Math.sin(a*4+data.fingerprint*.009+layer*.63)+relationBoost*Math.sin(a*5.8+layer*.4)
              +.075*Math.sin(a*7.7+layer*1.7)
              +(reduce.matches?0:.032*Math.cos(a*5-t*.00019+layer));
            const x=cX+Math.cos(a)*radius*ripple*(mobile?1.05:1.7);
            const y=cY+Math.sin(a)*radius*ripple*.88;
            if(j===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
          }
          ctx.closePath();
          ctx.fillStyle=`rgba(140,211,165,${.016+(layers-layer)*.004})`;
          ctx.fill();
          ctx.lineWidth=.65;
          ctx.strokeStyle=`rgba(94,174,125,${.06+(layers-layer)*.014})`;
          ctx.stroke();
        }
        // Mangrove principle: anchored ramifications, not a concepts-style line graph.
        roots.forEach(branch=>{
          const variation=(branch.influence/Math.max(1,marks.length))*.8;
          const growthLength=branch.reach*(.85+Math.min(.35,variation));
          const angle=branch.angle;
          const cx=cX+Math.cos(angle)*sx*.12;
          const cy=cY+Math.sin(angle)*sy*.09;
          const ex=cX+Math.cos(angle+Math.sin(angle*3+branch.phase)*.22)*sx*(.27+growthLength*.2);
          const ey=cY+Math.sin(angle)*sy*(.22+growthLength*.16);
          const bend=branch.bend;
          ctx.beginPath();ctx.moveTo(cx,cy);
          ctx.bezierCurveTo(cx+Math.cos(angle+bend)*sx*.13,cy+Math.sin(angle-bend)*sy*.14,
            ex-Math.cos(angle-.38)*sx*.1,ey-Math.sin(angle+.23)*sy*.11,ex,ey);
          ctx.strokeStyle=`rgba(50,138,93,${(growth ? .19 : .14)+Math.min(.18,variation)})`;
          ctx.lineWidth=.8+branch.influence/Math.max(1,marks.length)*3;
          ctx.stroke();
          for(let k=0;k<3;k++){
            const r=.45+k*.15;
            const bx=cx+(ex-cx)*r,by=cy+(ey-cy)*r;
            const branchAngle=angle+(k%2===0?1:-1)*(.4+branch.bend);
            const len=(.04+.025*seed('twig'+branch.i+':'+k))*Math.min(sx,sy);
            ctx.beginPath();ctx.moveTo(bx,by);
            ctx.quadraticCurveTo(bx+len*.3*Math.cos(branchAngle),by+len*.36*Math.sin(branchAngle),bx+len*Math.cos(branchAngle),by+len*Math.sin(branchAngle));
            ctx.strokeStyle='rgba(65,148,104,.12)';ctx.lineWidth=.65;ctx.stroke();
          }
        });
        // Record-derived growth sites quietly retain a memory of past additions.
        for(const m of marks){
          const [x,y]=nodePosition(m,t,sx,sy);
          m.positionX=x;m.positionY=y;
          const intensity=growth?m.recency*.72+.06:.21+m.strength*.14;
          const radius=1.1+Math.sqrt(m.strength)*2.5+(growth?m.recency*2.4:0);
          const halo=ctx.createRadialGradient(x,y,0,x,y,radius*8);
          halo.addColorStop(0,`rgba(51,171,94,${Math.min(.2,intensity*.5)})`);
          halo.addColorStop(1,'rgba(51,171,94,0)');
          ctx.fillStyle=halo;ctx.beginPath();ctx.arc(x,y,radius*8,0,TAU);ctx.fill();
          ctx.fillStyle=`rgba(23,125,79,${Math.min(.67,intensity+.09)})`;
          ctx.beginPath();ctx.arc(x,y,Math.max(.6,radius*.48),0,TAU);ctx.fill();
        }
        // Murmuration principle: hundreds of smaller units flow collectively
        // through the tissue. Motion is coherent, not per-label jitter.
        const speed=movement?1.8:.8;
        for(const f of flock){
          const u=f.angle+(reduce.matches?0:t*.000033*speed*f.speed);
          const swirl=.13*Math.sin(u*3+f.phase + (reduce.matches?0:t*.00018*speed));
          const r=f.r*(1+.12*Math.sin(u*2.1+data.fingerprint*.013));
          const px=cX+Math.cos(u+swirl)*sx*(.39*r);
          const py=cY+Math.sin(u*.91+swirl)*sy*(.38*r);
          let x=px,y=py;
          if(pointer.active&&!reduce.matches){
            const dx=px-pointer.x,dy=py-pointer.y;
            const d=Math.hypot(dx,dy);
            const range=Math.min(145,width*.24);
            if(d<range&&d>0){const push=(1-d/range)**2*24;x+=dx/d*push;y+=dy/d*push;}
          }
          ctx.beginPath();ctx.arc(x,y,Math.min(1.9,f.size*(mobile ? .8 : 1)),0,TAU);
          ctx.fillStyle=`rgba(38,136,85,${Math.min(.65,f.fade*(growth ? .28 : movement ? .82 : .64))})`;
          ctx.fill();
        }
        // A few subtle luminous folds communicate collective movement.
        if(!reduce.matches){
          ctx.beginPath();
          for(let j=0;j<=85;j++){
            const u=j/85;
            const x=cX+sx*(u-.5)*.86;
            const y=cY+Math.sin(u*TAU*2.4+t*.00027)*sy*.087;
            if(j===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
          }
          ctx.lineWidth=.5;ctx.strokeStyle='rgba(76,171,111,.095)';ctx.stroke();
        }
      };
      const tick=(time:number)=>{
        frame=0;last=time;
        if(!visible||document.hidden)return;
        draw(time);
        if(!reduce.matches)frame=requestAnimationFrame(tick);
      };
      const sync=()=>{
        if(frame){cancelAnimationFrame(frame);frame=0;}
        if(visible&&!document.hidden){
          draw(last||0);
          if(!reduce.matches)frame=requestAnimationFrame(tick);
        }
      };
      buttons.forEach(button=>button.addEventListener('click',()=>{
        const next=button.dataset.mode;
        if(next!=='whole'&&next!=='growth'&&next!=='movement')return;
        mode=next;
        buttons.forEach(b=>{const active=b===button;b.classList.toggle('is-selected',active);b.setAttribute('aria-pressed',String(active));});
        if(announcement)announcement.textContent=names[mode];
        draw(last||0);
      }));
      let contactTimer=0;
      area.addEventListener('pointerdown',e=>{
        const rect=area.getBoundingClientRect();
        pointer={x:e.clientX-rect.left,y:e.clientY-rect.top,active:true};
        window.clearTimeout(contactTimer);
        if(!fine.matches)contactTimer=window.setTimeout(()=>{pointer.active=false},1050);
      },{passive:true});
      area.addEventListener('pointermove',e=>{
        if(!fine.matches && e.buttons===0)return;
        const rect=area.getBoundingClientRect();
        pointer={x:e.clientX-rect.left,y:e.clientY-rect.top,active:true};
      },{passive:true});
      area.addEventListener('pointerleave',()=>{pointer.active=false;},{passive:true});
      area.addEventListener('pointercancel',()=>{pointer.active=false;},{passive:true});
      let observer:IntersectionObserver|null=null;
      if('IntersectionObserver' in window){observer=new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??true;sync();},{threshold:.01});observer.observe(area);}
      window.addEventListener('resize',resize,{passive:true});
      document.addEventListener('visibilitychange',sync);
      reduce.addEventListener('change',sync);
      resize();sync();
    }
  }
</script>
