---
import Base from '../layouts/Base.astro';
---
<Base title="murmurgrove" description="An evolving research organism grown from the real exhibitions, people, institutions and concepts of murmurgrove.">
  <section class="grove-home" aria-label="murmurgrove, a living research archive">
    <iframe
      class="grove-embedded-view"
      id="murmurgrove-view"
      src="/murmurgrove/organism/?embedded=1&amp;panel=2"
      title="murmurgrove interactive organism and research history"
      loading="eager"
      referrerpolicy="same-origin"
    ></iframe>
    <div id="home-view-controls" class="grove-view-controls" role="group" aria-label="Organism zoom and information" hidden>
      <button type="button" data-view-action="minus" aria-label="Zoom out">−</button>
      <span id="home-view-zoom">65%</span>
      <button type="button" data-view-action="plus" aria-label="Zoom in">+</button>
      <span class="grove-view-divider" aria-hidden="true"></span>
      <button type="button" data-view-action="about" aria-label="Viewer information" aria-expanded="false">ⓘ</button>
    </div>
    <p class="sr-only">Explore the research organism using drag, scroll, pinch, keyboard-focusable controls, or the History panel. Select an archive point to open its reading card.</p>
  </section>
</Base>
<script is:inline>
  // The shared layout retains its original language on other archive pages.
  document.documentElement.lang = "en";
  // Parent stays on its original paper background until the organism reports
  // that its real, source-verified Canvas2D frame has been drawn.
  // This avoids exposing the browser's transient iframe/compositor surface.
  // The archive's luminous cursor belongs to Base.astro (outside the iframe).
  // Relaying pointer coordinates lets that SAME cursor follow the mouse across
  // the organism without changing the global header or cursor implementation.
  const organismFrame = document.getElementById('murmurgrove-view');
  const organismHome = document.querySelector('.grove-home');
  // The visible controls and their hit targets are the SAME native buttons
  // in the parent document. No transparent hit proxies or coordinate mapping.
  const homeControls = document.getElementById('home-view-controls');
  const homeZoom = document.getElementById('home-view-zoom');
  const homeButtons = [...homeControls.querySelectorAll('[data-view-action]')];
  let viewerControls = null;
  let controlStateObserver;
  function connectViewControls() {
    controlStateObserver?.disconnect();
    viewerControls = null;
    homeControls.hidden = true;
    let doc;
    try { doc = organismFrame.contentDocument; } catch { return; }
    const toolbar = doc?.getElementById('zoomBox');
    const zoomLabel = doc?.getElementById('zoomLabel');
    const about = doc?.getElementById('about');
    if (!toolbar || !zoomLabel || !about ||
        !homeButtons.every(button => doc.getElementById(button.dataset.viewAction))) return;
    viewerControls = doc;
    const sync = () => {
      homeZoom.textContent = zoomLabel.textContent;
      homeControls.querySelector('[data-view-action="about"]').setAttribute(
        'aria-expanded', about.getAttribute('aria-expanded') || 'false');
    };
    sync();
    controlStateObserver = new MutationObserver(sync);
    controlStateObserver.observe(zoomLabel, {childList:true, characterData:true, subtree:true});
    controlStateObserver.observe(about, {attributes:true, attributeFilter:['aria-expanded']});
    // Preserve the viewer's original layout and action handlers, but remove
    // its duplicate visual controls and keyboard stops on the embedded home.
    toolbar.style.visibility = 'hidden';
    toolbar.inert = true;
    homeControls.hidden = false;
  }
  for (const button of homeButtons) {
    button.addEventListener('click', () => {
      const action = viewerControls?.getElementById(button.dataset.viewAction);
      if (action) action.click();
    });
  }
  homeControls.addEventListener('keydown', event => {
    if (event.key === 'Escape' &&
        viewerControls?.getElementById('about')?.getAttribute('aria-expanded') === 'true') {
      event.preventDefault();
      viewerControls.getElementById('about').click();
    }
  });
  let revealTimeout;
  organismFrame?.addEventListener('load', () => {
    connectViewControls();
    // If verification fails, reveal the iframe's own readable error panel.
    revealTimeout = window.setTimeout(() => organismHome?.classList.add('is-ready'), 10000);
  });
  window.addEventListener('message', (event) => {
    if (event.origin !== window.location.origin ||
        event.source !== organismFrame?.contentWindow) return;
    if (event.data?.type === 'murmurgrove:first-painted-frame') {
      window.clearTimeout(revealTimeout);
      if (!viewerControls) connectViewControls();
      organismHome?.classList.add('is-ready');
      return;
    }
    if (event.data?.type !== 'murmurgrove:pointer-position' ||
        !window.matchMedia('(pointer:fine)').matches) return;
    const {x,y} = event.data;
    if (!Number.isFinite(x) || !Number.isFinite(y)) return;
    const box = organismFrame.getBoundingClientRect();
    if (x < 0 || y < 0 || x > box.width || y > box.height) return;
    window.dispatchEvent(new PointerEvent('pointermove', {
      clientX: box.left + x, clientY: box.top + y,
      pointerType: 'mouse', bubbles: false
    }));
  });
</script>
<style>
  /* Only the immersive HOME is full-viewport; Base.astro remains identical
     to all murmurgrove pages, including its logo, rule and both nav systems. */
  .grove-home{position:fixed;inset:0;z-index:0;overflow:hidden;background:#fafbf8;color-scheme:light}
  .grove-embedded-view{display:block;width:100%;height:100%;height:100dvh;border:0;background:#fafbf8;color-scheme:light;opacity:0;transition:opacity 180ms ease-out}
  .grove-home.is-ready .grove-embedded-view{opacity:1}
  .grove-view-controls{position:absolute;z-index:8;right:24px;bottom:max(19px,env(safe-area-inset-bottom));height:48px;display:flex;align-items:center;gap:2px;padding:0 6px;box-sizing:border-box;color:#728b7f;font-family:"Noto Sans SC",Inter,"Helvetica Neue",Arial,sans-serif;pointer-events:none;white-space:nowrap}
  .grove-view-controls[hidden],.grove-home:not(.is-ready) .grove-view-controls{display:none}
  .grove-view-controls button{box-sizing:border-box;display:grid;place-items:center;flex:0 0 25px;width:25px;height:28px;padding:0;margin:0;border:0;background:transparent;color:#728b7f;font:300 15px/1 "Noto Sans SC",Inter,"Helvetica Neue",Arial,sans-serif;pointer-events:auto;touch-action:manipulation}
  .grove-view-controls #home-view-zoom{font-size:11px;min-width:36px;text-align:center;color:#738b81}
  .grove-view-divider{height:15px;width:1px;background:#d7e2da;margin:0 2px;flex:none}
  @media(max-width:600px){.grove-view-controls{right:10px}.grove-view-controls button{width:22px;flex-basis:22px}.grove-view-controls #home-view-zoom{min-width:34px}}
  @media(prefers-reduced-motion:reduce){.grove-embedded-view{scroll-behavior:auto;transition:none}}
</style>
