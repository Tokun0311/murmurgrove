---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const [exhibitions,people,institutions,concepts]=await Promise.all([getCollection('exhibitions'),getCollection('people'),getCollection('institutions'),getCollection('concepts')]);
const records=[
  ...exhibitions.map(r=>({type:'Exhibitions',path:'/exhibitions/'+r.id+'/',title:r.data.title,terms:[r.id,r.data.region,r.data.location]})),
  ...people.map(r=>({type:'People',path:'/people/'+r.id+'/',title:r.data.name,terms:[r.id,r.data.sortName||'',r.data.reading||'']})),
  ...institutions.map(r=>({type:'Institutions',path:'/institutions/'+r.id+'/',title:r.data.name,terms:[r.id,r.data.city||'',r.data.venueName||'']})),
  ...concepts.map(r=>({type:'Concepts',path:'/concepts/'+r.id+'/',title:r.data.title,terms:[r.id]})),
].sort((a,b)=>a.title.localeCompare(b.title));
---
<Base title="Search | murmurgrove" description="Search the public research archive." noindex={true}>
  <section class="archive archive-search">
    <h1 class="sr-only">Search the archive</h1>
    <label class="sr-only" for="archive-query">Search the archive</label>
    <input id="archive-query" type="search" autocomplete="off" placeholder="Find a record" />
    <div class="search-controls">
      <div class="filter-languages" role="group" aria-label="Record category">
        {['All','Exhibitions','People','Institutions','Concepts'].map((name,i)=><button type="button" data-search-category={name} aria-pressed={i===0?'true':'false'}>{name}</button>)}
      </div>
      <p id="archive-search-count" role="status" aria-live="polite"></p>
    </div>
    <ol class="archive-list search-list">
      {records.map(r=><li class="archive-entry" data-search-type={r.type} data-search-path={r.path} data-search-terms={[r.title,...r.terms].join(' ')} hidden><a href={r.path}>{r.title}</a><span>{r.type}</span></li>)}
    </ol>
    <noscript><p>Search is available with JavaScript. The archive sections remain accessible through navigation.</p></noscript>
  </section>
</Base>
<style>
.archive-search{max-width:900px;margin:0 auto}.archive-search input{width:100%;font-size:clamp(20px,3vw,30px);color:var(--ink);padding:12px 0}.search-controls{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:22px 0}.search-controls p{font-size:12px;color:var(--quiet);margin:0}.search-list .archive-entry{display:flex;justify-content:space-between;align-items:baseline;gap:20px}.search-list .archive-entry[hidden]{display:none!important}.search-list .archive-entry span{font-size:12px;color:var(--quiet);white-space:nowrap}@media(max-width:650px){.search-list .archive-entry{gap:8px}.search-list .archive-entry span{font-size:10px}}
</style>
<script>
const query=document.querySelector<HTMLInputElement>('#archive-query');
const count=document.getElementById('archive-search-count');
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-search-category]')];
const rows=[...document.querySelectorAll<HTMLLIElement>('[data-search-type]')];
const normalize=(s:string)=>s.normalize('NFKD').toLocaleLowerCase().replace(/[\p{M}\p{P}\p{Z}\s]/gu,'');
let category='All';
const aliases=new Map<string,string[]>();
function renderSearch(){
  const q=normalize(query?.value||'');
  let found=0;
  for(const row of rows){
    const names=[row.dataset.searchTerms||'',...(aliases.get(row.dataset.searchPath||'')||[])];
    const match=(category==='All'||row.dataset.searchType===category)&&(!q||names.some(name=>normalize(name).includes(q)));
    row.hidden=!match;if(match)found++;
  }
  if(count)count.textContent=found===0?'No matching records':found+' '+(found===1?'record':'records');
}
buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.searchCategory||'All';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));renderSearch()}));
query?.addEventListener('input',renderSearch);
const previous=history.state?.murmurgroveSearch;
if(previous){if(query&&typeof previous.query==='string')query.value=previous.query;if(buttons.some(b=>b.dataset.searchCategory===previous.category))category=previous.category;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.searchCategory===category)));}
window.addEventListener('pagehide',()=>{try{history.replaceState({...history.state,murmurgroveSearch:{query:query?.value||'',category}},'')}catch{}});
renderSearch();
fetch('/murmurgrove/research/current.json').then(r=>r.ok?r.json():null).then(graph=>{
  if(!Array.isArray(graph?.records))return;
  for(const record of graph.records)if(typeof record.path==='string'&&Array.isArray(record.aliases))aliases.set(record.path,record.aliases.filter((v:unknown)=>typeof v==='string'));
  renderSearch();
}).catch(()=>{});
</script>
