---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {recordNames} from '../../lib/record-names.mjs';
import {aliasesForPath} from '../../lib/archive-navigation.mjs';
const [exhibitions,people,institutions,concepts]=await Promise.all([getCollection('exhibitions'),getCollection('people'),getCollection('institutions'),getCollection('concepts')]);
const records=[
  ...exhibitions.map(r=>({type:'Exhibitions',path:'/exhibitions/'+r.id+'/',title:r.data.title,terms:[r.id,r.data.region,r.data.location]})),
  ...people.map(r=>({type:'People',path:'/people/'+r.id+'/',title:recordNames(r.data,'people',r.id).primary,terms:[...recordNames(r.data,'people',r.id).terms,r.id,r.data.sortName||'',r.data.reading||'',r.data.nativeName||'',...r.data.alternativeNames,...r.data.practiceFields,...r.data.roles,r.data.birthplace||'',r.data.basedIn||'']})),
  ...institutions.map(r=>({type:'Institutions',path:'/institutions/'+r.id+'/',title:recordNames(r.data,'institutions',r.id).primary,terms:[...recordNames(r.data,'institutions',r.id).terms,r.id,r.data.city||'',r.data.venueName||'',r.data.nativeName||'',...r.data.alternativeNames,...r.data.institutionTypes,r.data.country||'']})),
  ...concepts.map(r=>({type:'Concepts',path:'/concepts/'+r.id+'/',title:r.data.title,terms:[r.id,r.data.nativeName||'',...r.data.alternativeNames]})),
].sort((a,b)=>a.title.localeCompare(b.title));
---
<Base title="Search | murmurgrove" description="Search the public research archive." noindex={true}>
  <section class="archive archive-search">
    <h1 class="sr-only">Search the archive</h1>
    <label class="sr-only" for="archive-query">Search the archive</label>
    <div class="search-line">
      <svg class="search-symbol" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
      <input id="archive-query" type="search" autocomplete="off" placeholder="Find a record" enterkeyhint="search" />
      <button id="search-clear" type="button" aria-label="Clear search" hidden><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"/></svg></button>
    </div>
    <p class="sr-only" id="archive-search-count" role="status" aria-live="polite"></p>
    <p id="search-empty" hidden>No matching records</p>
    <div class="search-results">
      {['Exhibitions','People','Institutions','Concepts'].map(type=><section class="search-group" data-search-group={type} aria-label={type} hidden>
        <h2>{type}</h2>
        <ol class="search-list">
          {records.filter(r=>r.type===type).map(r=><li data-search-terms={[r.title,...r.terms,...aliasesForPath(r.path)].join(' ')} hidden><a href={r.path}>{r.title}</a></li>)}
        </ol>
      </section>)}
    </div>
    <noscript><p>Search is available with JavaScript. The archive sections remain accessible through navigation.</p></noscript>
  </section>
</Base>
<style is:global>
.archive-search{max-width:680px;margin:0 auto;padding-top:clamp(42px,9vh,108px);min-width:0}
.archive-search .search-line{display:flex;align-items:center;gap:13px;min-height:53px;border-bottom:1px solid var(--rule)!important}
.archive-search .search-line:focus-within{border-bottom-color:var(--ink)!important}
.archive-search .search-symbol{flex:none;color:var(--quiet)}
html body .archive-search #archive-query{min-width:0;flex:1;width:100%;padding:12px 0;color:var(--ink);font-size:clamp(20px,2.5vw,28px);line-height:1.4;border:0!important;background:transparent!important;appearance:none}
html body .archive-search #archive-query:focus-visible{border:0!important;text-decoration:none!important}
.archive-search #archive-query::placeholder{color:var(--quiet);opacity:.72}
.archive-search #archive-query::-webkit-search-cancel-button{display:none}
.archive-search #search-clear{flex:none;display:grid;place-items:center;width:44px;height:44px;padding:0;background:transparent;color:var(--quiet);cursor:pointer}
.archive-search #search-clear:hover{color:var(--ink)}
.archive-search #search-clear:focus-visible svg{color:var(--ink);background:radial-gradient(ellipse,rgba(87,174,118,.2),transparent 75%)}
.archive-search [hidden]{display:none!important}
.archive-search .search-results{margin-top:37px}
.archive-search .search-group{margin:0 0 32px}
.archive-search .search-group h2{font-size:12px;color:var(--quiet);font-weight:500;margin:0 0 11px;letter-spacing:.035em}
.archive-search .search-list{list-style:none;padding:0;margin:0}
.archive-search .search-list li{margin:0;padding:0}
.archive-search .search-list a{display:block;padding:8px 0;font-size:clamp(15px,1.6vw,19px);line-height:1.5;overflow-wrap:anywhere}
.archive-search #search-empty{margin-top:30px;font-size:13px;color:var(--quiet)}
@media(max-width:650px){.archive-search{padding-top:38px}.archive-search .search-results{margin-top:28px}.archive-search .search-group{margin-bottom:26px}.archive-search .search-list a{padding:10px 0}}
</style>
<script>
const query=document.querySelector<HTMLInputElement>('#archive-query');
const count=document.getElementById('archive-search-count');
const clear=document.querySelector<HTMLButtonElement>('#search-clear');
const empty=document.getElementById('search-empty');
const groups=[...document.querySelectorAll<HTMLElement>('[data-search-group]')];
const normalize=(s:string)=>s.normalize('NFKD').toLocaleLowerCase().replace(/[\p{M}\p{P}\p{Z}\s]/gu,'');
function renderSearch(){
  const raw=query?.value||'';
  const q=normalize(raw);
  let found=0;
  for(const group of groups){
    let groupCount=0;
    for(const row of group.querySelectorAll<HTMLLIElement>('[data-search-terms]')){
      const match=Boolean(q)&&normalize(row.dataset.searchTerms||'').includes(q);
      row.hidden=!match;
      if(match)groupCount++;
    }
    group.hidden=groupCount===0;
    found+=groupCount;
  }
  if(clear)clear.hidden=!raw;
  if(empty)empty.hidden=!q||found!==0;
  if(count)count.textContent=!q?'':found===0?'No matching records':found+' '+(found===1?'record':'records');
}
function clearSearch(){if(query){query.value='';renderSearch();query.focus();}}
query?.addEventListener('input',renderSearch);
query?.addEventListener('keydown',event=>{if(event.key==='Escape'&&query.value){event.preventDefault();clearSearch();}});
clear?.addEventListener('click',clearSearch);
const previous=history.state?.murmurgroveSearch;
if(query&&typeof previous?.query==='string')query.value=previous.query;
function rememberSearch(){try{history.replaceState({...history.state,murmurgroveSearch:{query:query?.value||''}},'')}catch{}}
window.addEventListener('pagehide',rememberSearch);
document.querySelector('.search-results')?.addEventListener('click',event=>{if(event.target instanceof Element&&event.target.closest('a[href]'))rememberSearch();});
renderSearch();
</script>
