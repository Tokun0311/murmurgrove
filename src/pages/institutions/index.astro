import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const items=(await getCollection('institutions')).sort((a,b)=>a.data.name.localeCompare(b.data.name));

const cityMeta = {
  Tokyo: { country: 'Japan' },
  Yokohama: { country: 'Japan' },
  Fukuoka: { country: 'Japan' },
  Kitakyushu: { country: 'Japan' },
  Kyoto: { country: 'Japan' },
  Hiroshima: { country: 'Japan' },
  Gero: { country: 'Japan' },
  Tokamachi: { country: 'Japan' },
  Seoul: { country: 'South Korea' },
  Gwangju: { country: 'South Korea' },
  Busan: { country: 'South Korea' },
  'Hong Kong': { country: 'Hong Kong' },
  Singapore: { country: 'Singapore' },
  'East Java': { country: 'Indonesia' },
  Phuket: { country: 'Thailand' },
  Berlin: { country: 'Germany' },
  Copenhagen: { country: 'Denmark' },
  London: { country: 'United Kingdom' },
  Arles: { country: 'France' },
};

const countryZones = {
  Japan: { left: 73.8, top: 28.8, width: 11.4, height: 24.5, radius: '18% 34% 24% 30%' },
  'South Korea': { left: 70.2, top: 33.4, width: 3.8, height: 7.3, radius: '24% 28% 22% 26%' },
  'Hong Kong': { left: 65.1, top: 46.0, width: 2.2, height: 2.8, radius: '24px' },
  Singapore: { left: 62.2, top: 59.0, width: 1.9, height: 2.1, radius: '24px' },
  Indonesia: { left: 65.8, top: 63.0, width: 8.2, height: 4.3, radius: '18px' },
  Thailand: { left: 60.3, top: 49.5, width: 3.2, height: 6.4, radius: '18px' },
  Germany: { left: 49.2, top: 25.7, width: 2.9, height: 5.8, radius: '16px' },
  Denmark: { left: 49.8, top: 22.2, width: 1.9, height: 3.1, radius: '16px' },
  'United Kingdom': { left: 45.8, top: 23.6, width: 2.5, height: 6.0, radius: '16px' },
  France: { left: 46.5, top: 28.2, width: 3.3, height: 5.9, radius: '16px' },
};

const countryEntries = Object.entries(
  Object.groupBy(
    items.filter((item) => item.data.city && cityMeta[item.data.city]?.country),
    (item) => cityMeta[item.data.city].country,
  ),
)
  .map(([country, entries]) => ({
    country,
    entries: entries.sort((a,b)=>a.data.name.localeCompare(b.data.name)),
    cities: Object.entries(Object.groupBy(entries, (item) => item.data.city))
      .map(([city, cityEntries]) => ({
        city,
        entries: cityEntries.sort((a,b)=>a.data.name.localeCompare(b.data.name)),
      }))
      .sort((a,b)=>a.city.localeCompare(b.city)),
    zone: countryZones[country],
  }))
  .filter((group) => group.zone)
  .sort((a,b)=>a.country.localeCompare(b.country));

const unmapped = items.filter(item => !item.data.city || !cityMeta[item.data.city]?.country);
---
<Base title="Institutions & Spaces | TOW ARCHIVE">
  <section class="archive institutions-page">
    <h1 class="section-title">Institutions & Spaces</h1>

    <section class="world-map-section" aria-label="Institution locations around the world">
      <div class="map-heading"><span>WORLD MAP</span><span>{countryEntries.length} countries · {items.length} entries</span></div>
      <div class="map-shell" id="institution-map-shell">
        <div class="world-map" id="institution-world-map" role="group" aria-label="Interactive world map of institutions, grouped by country">
          <div class="map-stage" id="institution-map-stage">
            <img class="map-base" src="/world-institutions.svg" alt="" draggable="false" />
            {countryEntries.map(({country, cities, entries, zone}) => (
              <div class="map-country" style={`left:${zone.left}%;top:${zone.top}%;width:${zone.width}%;height:${zone.height}%;border-radius:${zone.radius};`} data-country={country}>
                <button type="button" class="country-zone" aria-label={`${country}: ${entries.length} ${entries.length===1?'entry':'entries'}`} aria-expanded="false" title={country}></button>
                <div class="map-popup" hidden>
                  <div class="map-popup-country">{country}<span>{entries.length}</span></div>
                  <div class="map-popup-groups">
                    {cities.map(({city, entries}) => (
                      <section class="map-popup-group">
                        <h3>{city}</h3>
                        <ul>{entries.map(item=><li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}</ul>
                      </section>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="map-tooltip" id="institution-map-tooltip" hidden aria-live="polite"></div>
      </div>
      <p class="map-note">Country-level locations only. Hover or tap a highlighted country area to view institutions grouped by city.</p>
    </section>

    <div class="map-heading archive-list-heading"><span>ALL INSTITUTIONS</span><span>{items.length} entries</span></div>
    <ol class="archive-list">{items.map(item=><li class="archive-entry"><span class="eyebrow">{item.data.city ?? 'INDEX'}</span><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}</ol>
    {unmapped.length>0 && <p class="map-note">Some entries have no city marker yet; all are included in the index below.</p>}
  </section>
</Base>

<style>
  .world-map-section{margin:2.1rem 0 2.8rem}
  .map-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center;font-size:.72rem;letter-spacing:.12em;color:#668075;text-transform:uppercase;margin:0 0 .9rem}
  .map-shell{position:relative;border:1px solid #dbe7df;border-radius:3px;background:#f4f7f5;isolation:isolate}
  .world-map{position:relative;width:100%;aspect-ratio:1200/500;overflow:hidden;outline-offset:3px}
  .map-stage{position:absolute;inset:0}
  .map-base{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none;-webkit-user-drag:none}
  .map-country{position:absolute;z-index:1}
  .country-zone{display:block;width:100%;height:100%;padding:0;border:1.5px solid rgba(36,118,92,.58);background:rgba(36,118,92,.18);box-shadow:0 1px 4px rgba(35,71,56,.10);cursor:pointer;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease}
  .country-zone:hover,.country-zone:focus-visible,.map-country.is-open .country-zone{background:rgba(36,118,92,.32);border-color:#145b45;box-shadow:0 0 0 2px rgba(20,91,69,.14)}
  .map-popup{display:none}
  .map-tooltip{position:absolute;right:12px;top:12px;z-index:21;width:min(310px,calc(100% - 24px));max-height:min(390px,calc(100% - 24px));overflow:auto;background:#fff;border:1px solid #bdd4c5;box-shadow:0 7px 24px #354b3e26;padding:12px 14px;text-align:left}
  .map-tooltip[hidden]{display:none}
  .map-popup-country{display:flex;justify-content:space-between;gap:1rem;color:#175f47;font-size:.95rem;font-weight:650;margin-bottom:.65rem}
  .map-popup-country span{color:#789084;font-weight:400}
  .map-popup-groups{display:grid;gap:.8rem}
  .map-popup-group h3{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#6f8478;margin:0 0 .24rem}
  .map-popup-group ul{list-style:none;margin:0;padding:0}
  .map-popup-group li+li{border-top:1px solid #ecf1ec}
  .map-popup-group li a{display:block;padding:.4rem 0;font-size:.83rem;line-height:1.4;text-decoration:none;color:#24372d}
  .map-popup-group li a:hover,.map-popup-group li a:focus-visible{color:#087d55;text-decoration:underline;text-underline-offset:3px}
  .map-note{font-size:.78rem;color:#738479;margin-top:.65rem;line-height:1.6}
  .archive-list-heading{margin-bottom:0}
  @media(max-width:680px){.world-map{aspect-ratio:1.15}.world-map-section{margin:1.5rem 0 2rem}.map-heading{font-size:.64rem}.map-tooltip{position:static;width:auto;max-height:none;border-top:1px solid #e4ece7;border-left:0;border-right:0;border-bottom:0;box-shadow:none;margin-top:0;padding:12px 14px}}
  @media(prefers-reduced-motion:reduce){.country-zone{transition:none}}
</style>
<script>
  const shell = document.getElementById('institution-map-shell');
  const tooltip = document.getElementById('institution-map-tooltip');
  if (shell && tooltip) {
    let activeCountry = null;
    let locked = false;
    let closeTimer;
    const countries = [...shell.querySelectorAll('.map-country')];

    function hideTip() {
      clearTimeout(closeTimer);
      activeCountry?.classList.remove('is-open');
      activeCountry?.querySelector('.country-zone')?.setAttribute('aria-expanded','false');
      activeCountry = null;
      locked = false;
      tooltip.hidden = true;
      tooltip.replaceChildren();
    }

    function showTip(countryEl, keep = false) {
      if (!countryEl) return;
      clearTimeout(closeTimer);
      activeCountry?.classList.remove('is-open');
      activeCountry?.querySelector('.country-zone')?.setAttribute('aria-expanded','false');
      activeCountry = countryEl;
      locked = keep;
      countryEl.classList.add('is-open');
      countryEl.querySelector('.country-zone')?.setAttribute('aria-expanded','true');
      tooltip.replaceChildren(...[...countryEl.querySelector('.map-popup').children].map((child) => child.cloneNode(true)));
      tooltip.hidden = false;
    }

    countries.forEach((countryEl) => {
      const button = countryEl.querySelector('.country-zone');
      countryEl.addEventListener('mouseenter', () => { if (!locked) showTip(countryEl); });
      countryEl.addEventListener('mouseleave', () => {
        if (!locked) closeTimer = setTimeout(() => { if (!tooltip.matches(':hover')) hideTip(); }, 180);
      });
      button?.addEventListener('focus', () => showTip(countryEl, true));
      button?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeCountry === countryEl && locked) hideTip();
        else showTip(countryEl, true);
      });
    });

    tooltip.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    tooltip.addEventListener('mouseleave', () => { if (!locked) hideTip(); });
    document.addEventListener('pointerdown', (e) => { if (!shell.contains(e.target)) hideTip(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideTip(); });
  }
</script>
