  body.globe-country-focused .world-map-section .map-tooltip{position:fixed!important;left:clamp(24px,5vw,100px)!important;right:auto!important;top:clamp(160px,19vh,220px)!important;width:min(335px,32vw)!important;max-width:335px!important;max-height:min(380px,48vh)!important;z-index:16!important;pointer-events:auto!important}
  .world-map-section .map-tooltip{background:rgba(255,255,255,.47)!important;-webkit-backdrop-filter:blur(2px)!important;backdrop-filter:blur(2px)!important;border:1px solid rgba(83,149,121,.30)!important;box-shadow:0 10px 36px rgba(32,81,58,.055)!important;color:#174833!important;scrollbar-width:none}
  .world-map-section .map-tooltip::-webkit-scrollbar{display:none}
  .world-map-section .map-tooltip a{color:#194b37!important}
  .world-map-section .map-tooltip .map-popup-country,.world-map-section .map-tooltip h3{color:#17553e!important}
  /* Focus zoom controls, not a second navigation screen. All institutions resets the view. */
  .globe-zoom-controls{display:flex;gap:6px;align-items:center;position:absolute;top:12px;left:14px;z-index:11;pointer-events:auto}
  .globe-zoom-controls[hidden]{display:none!important}
  .globe-zoom-controls button{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border:1px solid rgba(83,149,121,.35);background:rgba(255,255,255,.59);color:#216347;font:400 20px/1 system-ui,sans-serif;cursor:pointer}
  .globe-zoom-controls button:hover,.globe-zoom-controls button:focus-visible{background:rgba(231,247,237,.85)}
  body.globe-country-focused .globe-zoom-controls{position:fixed!important;top:clamp(115px,16vh,160px)!important;left:clamp(24px,5vw,100px)!important;z-index:18!important}
  @media(max-width:960px){.world-map-section .globe-index-layout{grid-template-columns:minmax(0,1fr) minmax(0,.93fr)!important;column-gap:20px!important}.world-map-section .geo-index{padding:10px 0!important}}
  @media(max-width:700px){.world-map-section .globe-index-layout,body.globe-country-focused .world-map-section .globe-index-layout{display:flex!important;flex-direction:column!important;gap:10px!important}.world-map-section .map-shell,body.globe-country-focused .world-map-section .map-shell{position:relative!important;left:auto!important;width:100%!important;height:clamp(320px,85vw,490px)!important;pointer-events:auto!important}.world-map-section .geo-index{width:100%!important;padding:10px 0!important}.world-map-section .map-tooltip,body.globe-country-focused .world-map-section .map-tooltip{position:static!important;max-width:100%!important;width:100%!important;max-height:320px!important}.world-map-section .world-map,body.globe-country-focused .world-map-section .world-map{position:relative!important;inset:auto!important;width:100%!important;height:100%!important;pointer-events:auto!important}body.globe-country-focused .globe-zoom-controls{position:absolute!important;top:10px!important;left:12px!important}}
</style>
<script>
  const institutionGroups=[...document.querySelectorAll<HTMLElement>('[data-institution-group]')];
  const institutionCount=document.querySelector<HTMLElement>('#institution-filter-count');
  const geoButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-jump-country]')];
  const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
  function filterCountry(country:string,scroll=false){
    geoButtons.forEach(b=>{const active=b.dataset.jumpCountry===country;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});
    let total=0;
    institutionGroups.forEach(group=>{
      group.hidden=country!=='all'&&group.dataset.institutionGroup!==country;
      if(!group.hidden)total+=group.querySelectorAll('.institution-city-list li').length;
    });
    if(institutionCount)institutionCount.textContent=`${total} ${total===1?'institution':'institutions'}`;
    if(scroll)document.querySelector('.institution-geography-index')?.scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});
  }
  let focusGlobeCountry:(country:string)=>void=()=>{};
  geoButtons.forEach(button=>button.addEventListener('click',()=>{
    const country=button.dataset.jumpCountry||'all';
    filterCountry(country);
    focusGlobeCountry(country);
  }));
  const shell = document.getElementById('institution-map-shell') as HTMLElement | null;
  const map = document.getElementById('institution-world-map') as HTMLElement | null;
  const canvas = document.getElementById('institution-globe') as HTMLCanvasElement | null;
  const dotsCanvas = document.getElementById('institution-dots') as HTMLCanvasElement | null;
  const tooltip = document.getElementById('institution-map-tooltip') as HTMLElement | null;
  const details = document.getElementById('institution-map-details') as HTMLElement | null;
  const loading = document.getElementById('globe-loading');
  if (shell && map && canvas instanceof HTMLCanvasElement && dotsCanvas instanceof HTMLCanvasElement && tooltip && details) {
    // One representative location per country. No political borders or cluster counts.
    type CityMarker={country:string,lon:number,lat:number,count:number};
    const cityDataElement=document.querySelector('#globe-city-data');
    const cities:CityMarker[]=cityDataElement?.textContent ? JSON.parse(cityDataElement.textContent) : [];
    type FocusCity={city:string,country:string,lon:number,lat:number,count:number};
    type PreciseSite={country:string,city:string,name:string,id:string,lon:number,lat:number};
    const preciseSites:PreciseSite[]=JSON.parse(document.querySelector('#globe-site-data')?.textContent||'[]');
    const focusCityElement=document.querySelector('#globe-focus-city-data');
    const focusCities:FocusCity[]=focusCityElement?.textContent?JSON.parse(focusCityElement.textContent):[];
    const dotCtx=dotsCanvas.getContext('2d');
    const clamp = (n:number,a:number,b:number) => Math.min(b,Math.max(a,n));
    const PI = Math.PI;
    let longitude = 75 * PI / 180, latitude = 19 * PI / 180, zoom = 1;
    let selectedGlobeCountry:string|null=null;
    const defaultGlobe={lon:longitude,lat:latitude,zoom:1};
    // Framing for recorded cities: enough zoom to distinguish nearby places while
    // retaining the larger geographic context in the full-window background.
    const countryViewOverrides:Record<string,{lon:number,lat:number,zoom:number}>={
      'Japan':{lon:136.2,lat:35.9,zoom:4.5},
      'South Korea':{lon:127.8,lat:36.0,zoom:5.7},
      'Hong Kong':{lon:114.17,lat:22.31,zoom:7.0},
      'Singapore':{lon:103.82,lat:1.29,zoom:7.0},
      'Indonesia':{lon:112.7,lat:-7.6,zoom:6.0},
      'Thailand':{lon:98.35,lat:7.9,zoom:6.0},
      'Germany':{lon:10.4,lat:51.0,zoom:5.0},
      'Denmark':{lon:12.3,lat:55.9,zoom:6.0},
      'United Kingdom':{lon:-1.8,lat:53.3,zoom:5.2},
      'France':{lon:4.8,lat:43.8,zoom:6.0},
    };
    function getCountryFocus(country:string){
      const pts=focusCities.filter(p=>p.country===country);
      const override=countryViewOverrides[country];
      if(override){
        return {lon:override.lon*PI/180,lat:clamp(override.lat*PI/180,-PI*.44,PI*.44),zoom:override.zoom};
      }
      if(!pts.length)return {lon:defaultGlobe.lon,lat:defaultGlobe.lat,zoom:1};
      const lons=pts.map(p=>p.lon), lats=pts.map(p=>p.lat);
      const focusLon=((Math.min(...lons)+Math.max(...lons))/2)*PI/180;
      const focusLat=((Math.min(...lats)+Math.max(...lats))/2)*PI/180;
      const lonRange=Math.max(...lons)-Math.min(...lons);
      const latRange=Math.max(...lats)-Math.min(...lats);
      const span=Math.max(Math.max(4.4,lonRange*1.18),Math.max(3.8,latRange*1.75));
      const focusZoom=clamp(39/span,2.8,6.2);
      return {lon:focusLon,lat:clamp(focusLat,-PI*.44,PI*.44),zoom:focusZoom};
    }
    const zoomControls=shell.querySelector<HTMLElement>('#globe-zoom-controls');
    let width=1,height=1,cx=0,cy=0,radius=1;
    let dragging: {id:number,x:number,y:number,lon:number,lat:number}|null=null;
    let moved=false, activeCountry:string|null=null, pinned=false, closeTimer:any;
    let frame=0;
    let turnAnimation=0;

    const gl=canvas.getContext('webgl',{alpha:true,antialias:true,premultipliedAlpha:false,preserveDrawingBuffer:false});
    if (!gl) {
      loading!.textContent='This globe requires WebGL. Please enable hardware acceleration.';
    } else {
      const vertex=`attribute vec2 pos;
        void main(){gl_Position=vec4(pos,0.0,1.0);}`;
      const fragment=`precision highp float;
        uniform vec2 center;
        uniform float sphereRadius;
        uniform float lonRotation;
        uniform float latRotation;
        uniform sampler2D landMask;
        void main(){
          vec2 p=(gl_FragCoord.xy-center)/sphereRadius;
          float rr=dot(p,p);
          if(rr>=1.0)discard;
          float z=sqrt(max(0.0,1.0-rr));
          float cl=cos(lonRotation),sl=sin(lonRotation);
          float ct=cos(latRotation),st=sin(latRotation);
          float wx=p.x*cl+z*ct*sl-p.y*st*sl;
          float wy=p.y*ct+z*st;
          float wz=-p.x*sl+z*ct*cl-p.y*st*cl;
          float lng=atan(wx,wz);
          float lat=asin(clamp(wy,-1.0,1.0));
          float scale=3.14159265359/6.0;
          float lonDist=abs(fract((lng+scale*.5)/scale)-.5)*scale;
          float latDist=abs(fract((lat+scale*.5)/scale)-.5)*scale;
          float lonPx=1.0/max(1.0,sphereRadius*max(.12,cos(lat)));
          float latPx=1.0/max(1.0,sphereRadius);
          float meridian=1.0-smoothstep(.0,lonPx*.96,lonDist);
          float parallel=1.0-smoothstep(.0,latPx*.96,latDist);
          float grid=max(meridian,parallel)*.37;
          // Sample a merged land mask. Countries share the same fill and have NO internal borders.
          vec2 uv=vec2(fract(lng/6.28318530718+.5),clamp(lat/3.14159265359+.5,0.001,.999));
          float land=texture2D(landMask,uv).a;
          vec3 color=mix(vec3(1.0),vec3(.927,.955,.969),land*.62);
          color=mix(color,vec3(.70,.80,.83),grid*.32);
          float edge=1.0-smoothstep(.65/max(sphereRadius,1.0),2.2/max(sphereRadius,1.0),1.0-sqrt(rr));
          color=mix(color,vec3(.70,.83,.84),edge*.23);
          gl_FragColor=vec4(color,1.0-smoothstep(.998,1.0,rr));
        }`;
      const compile=(source:string,type:number)=>{
        const shader=gl.createShader(type)!;
        gl.shaderSource(shader,source);gl.compileShader(shader);
        if(!gl.getShaderParameter(shader,gl.COMPILE_STATUS))throw new Error(gl.getShaderInfoLog(shader)||'Globe shader failed');
        return shader;
      };
      const program=gl.createProgram()!;
      gl.attachShader(program,compile(vertex,gl.VERTEX_SHADER));
      gl.attachShader(program,compile(fragment,gl.FRAGMENT_SHADER));
      gl.linkProgram(program);
      if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw new Error(gl.getProgramInfoLog(program)||'Globe program failed');
      gl.useProgram(program);
      const quad=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,quad);
      gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
      const attr=gl.getAttribLocation(program,'pos');gl.enableVertexAttribArray(attr);
      gl.vertexAttribPointer(attr,2,gl.FLOAT,false,0,0);
      const uniforms={
        size:gl.getUniformLocation(program,'viewSize'),center:gl.getUniformLocation(program,'center'),
        radius:gl.getUniformLocation(program,'sphereRadius'),lon:gl.getUniformLocation(program,'lonRotation'),
        lat:gl.getUniformLocation(program,'latRotation'),
        land:gl.getUniformLocation(program,'landMask')
      };
      const landTexture=gl.createTexture()!;
      gl.activeTexture(gl.TEXTURE0);gl.bindTexture(gl.TEXTURE_2D,landTexture);
      gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,1,1,0,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array([0,0,0,0]));
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
      gl.uniform1i(uniforms.land,0);
      const landImage=new Image();
      landImage.onload=()=>{
        gl.activeTexture(gl.TEXTURE0);gl.bindTexture(gl.TEXTURE_2D,landTexture);
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL,true);
        gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,landImage);
        requestDraw();
      };
      landImage.src='/land-mask.png';
      loading?.setAttribute('hidden','');

      function requestDraw(){if(!frame)frame=requestAnimationFrame(()=>{frame=0;draw()})}
      // Smoothly align the chosen country with the viewer, without moving the page.
      focusGlobeCountry=(country:string)=>{
        if(turnAnimation)cancelAnimationFrame(turnAnimation);
        hideTip();
        selectedGlobeCountry=country==='all'?null:country;
        document.body.classList.toggle('globe-country-focused',!!selectedGlobeCountry);
        zoomControls?.toggleAttribute('hidden',!selectedGlobeCountry);
        const focus=selectedGlobeCountry?getCountryFocus(selectedGlobeCountry):defaultGlobe;
        const targetLon=focus.lon;
        const targetLat=focus.lat;
        // Adjust zoom by the country's recorded geographic spread so the overall country area reads more clearly.
        const targetZoom=focus.zoom;
        const shift=Math.atan2(Math.sin(targetLon-longitude),Math.cos(targetLon-longitude));
        const startLon=longitude,startLat=latitude,startZoom=zoom;
        if(reducedMotion.matches){longitude+=shift;latitude=targetLat;zoom=targetZoom;resize();return;}
        const start=performance.now(),duration=850;
        const tick=(time:number)=>{
          const t=Math.min(1,(time-start)/duration),ease=t*t*(3-2*t);
          longitude=startLon+shift*ease;
          latitude=startLat+(targetLat-startLat)*ease;
          zoom=startZoom+(targetZoom-startZoom)*ease;
          resize();
          if(t<1)turnAnimation=requestAnimationFrame(tick);else turnAnimation=0;
        };
        turnAnimation=requestAnimationFrame(tick);
      };
      function draw(){
        gl.viewport(0,0,width,height);
        gl.clearColor(1,1,1,0);gl.clear(gl.COLOR_BUFFER_BIT);
        gl.uniform2f(uniforms.size,width,height);
        gl.uniform2f(uniforms.center,cx,height-cy);
        gl.uniform1f(uniforms.radius,radius);
        gl.uniform1f(uniforms.lon,longitude);
        gl.uniform1f(uniforms.lat,latitude);
        gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
        drawDots();
      }
      function dotPosition(lonDeg:number,latDeg:number){
        const lon=lonDeg*PI/180,lat=latDeg*PI/180;
        const wx=Math.sin(lon)*Math.cos(lat),wy=Math.sin(lat),wz=Math.cos(lon)*Math.cos(lat);
        const cl=Math.cos(longitude),sl=Math.sin(longitude),ct=Math.cos(latitude),st=Math.sin(latitude);
        const x=wx*cl-wz*sl;
        const t=wx*sl+wz*cl;
        const y=wy*ct-t*st;
        const depth=wy*st+t*ct;
        return depth>0?[cx+x*radius,cy-y*radius]:null;
      }
      type GeographicPoint=CityMarker|FocusCity|PreciseSite;
      type ProjectedPoint={x:number,y:number,point:GeographicPoint};
      let visiblePoints:ProjectedPoint[]=[];
      const isSite=(p:GeographicPoint):p is PreciseSite=>'id' in p;
      const isCity=(p:GeographicPoint):p is FocusCity=>'city' in p && !('id' in p);
      function drawDots(){
        if(!dotCtx)return;
        dotCtx.clearRect(0,0,width,height);
        visiblePoints=[];
        const dpr=Math.min(window.devicePixelRatio||1,2);
        const points:GeographicPoint[]=selectedGlobeCountry
          ? [...focusCities.filter(p=>p.country===selectedGlobeCountry),...preciseSites.filter(p=>p.country===selectedGlobeCountry)]
          : cities;
        // All points use actual geographic projections; never render hidden hemisphere dots.
        for(const point of points){
          const pos=dotPosition(point.lon,point.lat);if(!pos)continue;
          const [x,y]=pos;
          if(x<0||x>width||y<0||y>height)continue;
          visiblePoints.push({x,y,point});
          const selected=!!selectedGlobeCountry;
          const density=Math.min(1,Math.log1p('count' in point?point.count:1)/Math.log(41));
          const spread=(selected?20:21)+(selected?10:27)*density;
          const glow=dotCtx.createRadialGradient(x,y,0,x,y,spread*dpr);
          glow.addColorStop(0,`rgba(21,125,92,${(selected?.30:.13)+.23*density})`);
          glow.addColorStop(.45,`rgba(65,161,123,${(selected?.14:.05)+.12*density})`);
          glow.addColorStop(1,'rgba(64,162,119,0)');
          dotCtx.fillStyle=glow;
          dotCtx.beginPath();dotCtx.arc(x,y,spread*dpr,0,2*PI);dotCtx.fill();
          dotCtx.beginPath();dotCtx.arc(x,y,(selected?4.2:2.2)*dpr,0,2*PI);
          dotCtx.fillStyle='rgba(255,255,255,.96)';dotCtx.fill();
          dotCtx.beginPath();dotCtx.arc(x,y,(selected?2.8:1.7)*dpr,0,2*PI);
          dotCtx.fillStyle='rgba(25,112,80,.95)';dotCtx.fill();
          if(selected){
            dotCtx.save();
            dotCtx.font=`${(isSite(point)?10:12)*dpr}px system-ui, sans-serif`;
            dotCtx.textBaseline='bottom';
            dotCtx.lineWidth=3.5*dpr;
            dotCtx.strokeStyle='rgba(255,255,255,.96)';
            dotCtx.fillStyle='rgba(23,86,62,.98)';
            const title=isSite(point)?point.name:(isCity(point)?point.city:point.country);
            dotCtx.strokeText(title,x+7*dpr,y-7*dpr);
            dotCtx.fillText(title,x+7*dpr,y-7*dpr);
            dotCtx.restore();
          }
        }
      }
      function pointAt(clientX:number,clientY:number):GeographicPoint|null{
        const b=map.getBoundingClientRect();
        const x=(clientX-b.left)*width/b.width,y=(clientY-b.top)*height/b.height;
        const dpr=Math.min(window.devicePixelRatio||1,2);
        const nearest=visiblePoints.map(p=>({p,d:Math.hypot(x-p.x,y-p.y)})).sort((a,b)=>a.d-b.d)[0];
        return nearest && nearest.d<(selectedGlobeCountry?24:17)*dpr?nearest.p.point:null;
      }
      function showPointTip(point:GeographicPoint,keep=false){
        if(isSite(point)){
          clearTimeout(closeTimer);
          tooltip.replaceChildren();
          const heading=document.createElement('div');heading.className='map-popup-country';heading.textContent=point.name;
          const link=document.createElement('a');link.href=`/institutions/${point.id}/`;link.textContent='View institution record';link.className='cluster-city-link';
          tooltip.append(heading,link);tooltip.hidden=false;activeCountry=point.country;pinned=keep;
          return;
        }
        showTip(point.country,keep,isCity(point)?point.city:undefined);
      }
      function resize(){
        const b=map.getBoundingClientRect();
        const dpr=Math.min(window.devicePixelRatio||1,2);
        width=Math.max(1,Math.round(b.width*dpr));height=Math.max(1,Math.round(b.height*dpr));
        if(canvas.width!==width||canvas.height!==height){canvas.width=width;canvas.height=height;}
        if(dotsCanvas.width!==width||dotsCanvas.height!==height){dotsCanvas.width=width;dotsCanvas.height=height;}
        const focused=!!selectedGlobeCountry;
        cx=width*(focused?.305:.49);
        cy=height*(focused?.52:.51);
        const baseRadius=focused?Math.min(width*.31,height*.48):Math.min(width*.46,height*.47);
        radius=baseRadius*zoom;
        requestDraw();
      }
      function hideTip(){clearTimeout(closeTimer);activeCountry=null;pinned=false;tooltip.hidden=true;tooltip.replaceChildren()}
      function showTip(country:string,keep=false,city?:string){
        clearTimeout(closeTimer);
        const el=Array.from(details.children).find(e=>e.getAttribute('data-country-details')===country);
        if(!el)return;
        if(activeCountry!==country||tooltip.hidden||city){
          const children=Array.from(el.children).map(c=>c.cloneNode(true) as HTMLElement);
          if(city){
            const groups=children.find(c=>c.classList.contains('map-popup-groups'));
            groups?.querySelectorAll<HTMLElement>('.map-popup-group').forEach(group=>{
              if(group.querySelector('h3')?.textContent!==city)group.remove();
            });
          }
          tooltip.replaceChildren(...children);
        }
        activeCountry=country;pinned=keep;tooltip.hidden=false;
      }
      zoomControls?.querySelectorAll<HTMLButtonElement>('[data-map-action]').forEach(button=>button.addEventListener('click',()=>{
        if(!selectedGlobeCountry)return;
        if(turnAnimation){cancelAnimationFrame(turnAnimation);turnAnimation=0;}
        const factor=button.dataset.mapAction==='zoom-in'?1.28:1/1.28;
        zoom=clamp(zoom*factor,1.65,10.5);
        resize();
      }));
      map.addEventListener('pointerdown',e=>{
        if(e.button!==0)return;
        if(turnAnimation)cancelAnimationFrame(turnAnimation);
        dragging={id:e.pointerId,x:e.clientX,y:e.clientY,lon:longitude,lat:latitude};moved=false;
        map.setPointerCapture(e.pointerId);
      });
      map.addEventListener('pointermove',e=>{
        if(!dragging||dragging.id!==e.pointerId){
          if(!pinned){const point=pointAt(e.clientX,e.clientY);if(point)showPointTip(point);else if(activeCountry)hideTip()}
          return;
        }
        if(Math.abs(e.clientX-dragging.x)+Math.abs(e.clientY-dragging.y)>4)moved=true;
        if(moved){
          map.classList.add('is-dragging');
          const b=map.getBoundingClientRect();
          longitude=dragging.lon-(e.clientX-dragging.x)/b.width*4.0;
          latitude=clamp(dragging.lat+(e.clientY-dragging.y)/b.height*2.6,-PI*.46,PI*.46);
          requestDraw();
        }
      });
      map.addEventListener('pointerup',e=>{
        if(dragging?.id!==e.pointerId)return;
        if(!moved){const point=pointAt(e.clientX,e.clientY);if(point){showPointTip(point,true)}else hideTip()}
        dragging=null;map.classList.remove('is-dragging');
      });
      map.addEventListener('pointercancel',()=>{dragging=null;map.classList.remove('is-dragging')});
      map.addEventListener('pointerleave',()=>{if(!pinned)hideTip()});
      map.addEventListener('keydown',e=>{
        if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();longitude+=(e.key==='ArrowLeft'?1:-1)*.17;requestDraw()}
        else if(e.key==='ArrowUp'||e.key==='ArrowDown'){e.preventDefault();latitude=clamp(latitude+(e.key==='ArrowUp'?-1:1)*.15,-1.44,1.44);requestDraw()}
        else if(e.key==='Escape')hideTip();
      });
      tooltip.addEventListener('pointerenter',()=>clearTimeout(closeTimer));
      tooltip.addEventListener('pointerleave',()=>{if(!pinned)hideTip()});
      document.addEventListener('pointerdown',e=>{if(!shell.contains(e.target as Node))hideTip()});
      const observer=new ResizeObserver(resize);observer.observe(map);
      resize();
    }
  }
</script>
