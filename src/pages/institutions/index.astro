---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import geoPaths from '../../data/world-country-paths.json';
const items=await getCollection('institutions');

const cityMeta = {
  Tokyo: { country: 'Japan' },
  Yokohama: { country: 'Japan' },
  Fukuoka: { country: 'Japan' },
  Kitakyushu: { country: 'Japan' },
  Kyoto: { country: 'Japan' },
  Hiroshima: { country: 'Japan' },
  Gero: { country: 'Japan' },
  Tokamachi: { country: 'Japan' },
  Seoul: { country: 'South Korea' },
  Gwangju: { country: 'South Korea' },
  Busan: { country: 'South Korea' },
  'Hong Kong': { country: 'Hong Kong' },
  Singapore: { country: 'Singapore' },
  'East Java': { country: 'Indonesia' },
  Phuket: { country: 'Thailand' },
  Berlin: { country: 'Germany' },
  Copenhagen: { country: 'Denmark' },
  London: { country: 'United Kingdom' },
  Arles: { country: 'France' },
};

const countryOrder = ['Japan','South Korea','Hong Kong','Singapore','Indonesia','Thailand','Germany','Denmark','United Kingdom','France'];
const cityOrder = Object.keys(cityMeta);
const countryEntries = Object.entries(
  Object.groupBy(
    items.filter((item) => item.data.city && cityMeta[item.data.city]?.country),
    (item) => cityMeta[item.data.city].country,
  ),
).map(([country, entries]) => ({
  country,
  entries: entries.sort((a,b)=>a.data.name.localeCompare(b.data.name)),
  cities: Object.entries(Object.groupBy(entries, item => item.data.city))
    .map(([city, cityEntries]) => ({city, entries: cityEntries.sort((a,b)=>a.data.name.localeCompare(b.data.name))}))
    .sort((a,b)=>cityOrder.indexOf(a.city)-cityOrder.indexOf(b.city)),
})).sort((a,b)=>countryOrder.indexOf(a.country)-countryOrder.indexOf(b.country));
const featuredCountries = new Map(countryEntries.map(group => [group.country,group]));
const unmapped = items.filter(item => !item.data.city || !cityMeta[item.data.city]?.country);
---
<Base title="Institutions & Spaces | TOW ARCHIVE">
  <section class="archive institutions-page">
    <h1 class="sr-only">Institutions &amp; Spaces</h1>

    <section class="world-map-section" aria-label="Institution locations by country and region">
      <div class="map-heading"><span>WORLD GLOBE</span><span>{countryEntries.length} places · {items.length} entries</span></div>
      <div class="map-shell" id="institution-map-shell">
        <div class="map-controls" aria-label="Map navigation">
          <button type="button" class="map-control" data-map-action="in" aria-label="Zoom in" title="Zoom in">+</button>
          <button type="button" class="map-control" data-map-action="out" aria-label="Zoom out" title="Zoom out">−</button>
          <button type="button" class="map-control map-reset" data-map-action="reset" title="Reset map view">Reset</button>
        </div>
        <div class="world-map" id="institution-world-map" role="group" aria-label="Interactive globe. Drag to rotate, scroll to zoom, and select a highlighted country to explore institutions." tabindex="0">
          <canvas class="globe-canvas" id="institution-globe" aria-hidden="true"></canvas>
          <div class="globe-loading" id="globe-loading">Loading globe…</div>
        </div>
        <div class="map-tooltip" id="institution-map-tooltip" hidden aria-live="polite"></div>
        <div id="institution-map-details" hidden>
          {countryEntries.map(({country,cities,entries}) => (
            <section data-country-details={country}>
              <div class="map-popup-country">{country}<span>{entries.length}</span></div>
              <div class="map-popup-groups">
                {cities.map(({city,entries}) => (
                  <section class="map-popup-group">
                    <h3>{city}</h3>
                    <ul>{entries.map(item=><li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}</ul>
                  </section>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <p class="map-note">Drag to rotate the globe. Scroll or use + / − to zoom. Select a green country to explore institutions by city. Keyboard: arrows to rotate, + / − to zoom.</p>
    </section>

    <div class="map-heading archive-list-heading"><span>ALL INSTITUTIONS</span><span>{items.length} entries · grouped by country and city</span></div>
    <div class="filters institution-filters">
      <div class="filter-languages" aria-label="Country and region filters">
        <button type="button" data-institution-region="all" aria-pressed="true">All</button>
        {countryEntries.map(({country})=><button type="button" data-institution-region={country} aria-pressed="false">{country}</button>)}
        {unmapped.length > 0 && <button type="button" data-institution-region="unmapped" aria-pressed="false">Other</button>}
      </div>
    </div>
    <p class="institution-filter-count" id="institution-filter-count" role="status" aria-live="polite">{items.length} institutions</p>
    <div class="institution-geography-index">
      {countryEntries.map(({country,cities,entries}) => (
        <section class="institution-country-group" data-institution-group={country} aria-label={`${country} institutions`}>
          <header class="institution-country-header">
            <h2>{country}</h2>
            <span>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</span>
          </header>
          {cities.map(({city,entries:cityEntries}) => (
            <section class="institution-city-group" aria-label={`${city} institutions`}>
              <h3>{city}</h3>
              <ul class="institution-city-list">
                {cityEntries.map(item => <li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}
              </ul>
            </section>
          ))}
        </section>
      ))}
      {unmapped.length > 0 && (
        <section class="institution-country-group" data-institution-group="unmapped" aria-label="Unclassified institutions">
          <header class="institution-country-header"><h2>Location not yet specified</h2><span>{unmapped.length} entries</span></header>
          <ul class="institution-city-list institution-ungrouped-list">
            {unmapped.map(item => <li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </section>
</Base>

<style>
  .world-map-section{margin:2.1rem 0 2.8rem}
  .map-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center;font-size:.72rem;letter-spacing:.12em;color:#668075;text-transform:uppercase;margin:0 0 .9rem}
  .map-shell{position:relative;border:1px solid #dbe7df;border-radius:3px;background:#f4f7f5;isolation:isolate}
  .world-map{position:relative;width:100%;aspect-ratio:1200/520;overflow:hidden;cursor:grab;touch-action:none;outline-offset:3px;user-select:none;-webkit-user-select:none;background:radial-gradient(ellipse at center,#f7faf8 0%,#f4f7f5 72%)}
  .world-map.is-dragging{cursor:grabbing}
  .globe-canvas{width:100%;height:100%;display:block;pointer-events:none}
  .globe-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#789084;letter-spacing:.08em;pointer-events:none}
  .globe-loading[hidden]{display:none}
  .map-controls{position:absolute;top:12px;left:12px;z-index:20;display:flex;gap:5px;align-items:center}
  .map-control{min-width:31px;height:31px;padding:0 8px;background:#fff;border:1px solid #bed3c5;color:#225c49;font:500 15px/1 inherit;cursor:pointer;border-radius:3px;box-shadow:0 1px 5px #24493513}
  .map-reset{font-size:12px;min-width:58px}
  .map-control:hover,.map-control:focus-visible{background:#eaf3ed;border-color:#78a18a}
  .map-tooltip{position:absolute;right:12px;top:12px;z-index:21;width:min(310px,calc(100% - 24px));max-height:min(390px,calc(100% - 24px));overflow:auto;background:#fff;border:1px solid #bdd4c5;box-shadow:0 7px 24px #354b3e26;padding:12px 14px;text-align:left}
  .map-tooltip[hidden],#institution-map-details[hidden]{display:none}
  .map-popup-country{display:flex;justify-content:space-between;gap:1rem;color:#175f47;font-size:.94rem;font-weight:650;margin-bottom:.65rem}
  .map-popup-country span{color:#789084;font-weight:400}
  .map-popup-groups{display:grid;gap:.8rem}
  .map-popup-group h3{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#6f8478;margin:0 0 .24rem}
  .map-popup-group ul{list-style:none;margin:0;padding:0}
  .map-popup-group li+li{border-top:1px solid #ecf1ec}
  .map-popup-group li a{display:block;padding:.4rem 0;font-size:.83rem;line-height:1.4;text-decoration:none;color:#24372d}
  .map-popup-group li a:hover,.map-popup-group li a:focus-visible{color:#087d55;text-decoration:underline;text-underline-offset:3px}
  .map-note{font-size:.78rem;color:#738479;margin-top:.65rem;line-height:1.6}
  .archive-list-heading{margin-bottom:0}
  .institution-filters{margin:1.2rem 0 .65rem}
  .institution-filter-count{font-size:.77rem;color:var(--quiet);margin:0 0 1rem}
  .institution-country-group[hidden]{display:none!important}
  .institution-country-group{border-top:1px solid #c6dfd2;padding:1.65rem 0 1.3rem}
  .institution-country-group:last-child{border-bottom:1px solid #c6dfd2}
  .institution-country-header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.1rem}
  .institution-country-header h2{font-size:clamp(22px,2.3vw,29px);font-weight:400;line-height:1.3;letter-spacing:-.02em;margin:0}
  .institution-country-header span{font-size:.73rem;letter-spacing:.05em;color:#738479;white-space:nowrap}
  .institution-city-group{display:grid;grid-template-columns:minmax(110px,19%) minmax(0,1fr);gap:1.2rem;padding:.4rem 0 1.2rem}
  .institution-city-group+.institution-city-group{border-top:1px solid #e4ede7;padding-top:1.1rem}
  .institution-city-group h3{font-size:.83rem;color:#668075;font-weight:500;line-height:1.5;margin:.35rem 0 0}
  .institution-city-list{list-style:none;padding:0;margin:0}
  .institution-city-list li{padding:.45rem 0}
  .institution-city-list li+li{border-top:1px solid #e4ede7}
  .institution-city-list a{font-size:clamp(16px,1.65vw,21px);line-height:1.5;letter-spacing:-.02em;overflow-wrap:anywhere}
  .institution-city-list a:hover,.institution-city-list a:focus-visible{color:#056848;text-decoration:underline;text-underline-offset:4px}
  .institution-ungrouped-list{margin-left:calc(19% + 1.2rem)}
  @media(max-width:680px){.institution-city-group{grid-template-columns:1fr;gap:.25rem}.institution-city-group h3{margin:0;font-size:.8rem}.institution-country-group{padding:1.35rem 0}.institution-ungrouped-list{margin-left:0}.world-map{aspect-ratio:1.4}.world-map-section{margin:1.5rem 0 2rem}.map-heading{font-size:.64rem}.map-tooltip{position:static;width:auto;max-height:none;border-top:1px solid #e4ece7;border-left:0;border-right:0;border-bottom:0;box-shadow:none;margin:0;padding:12px 14px}}
  @media(prefers-reduced-motion:reduce){.world-map{scroll-behavior:auto}}
</style>
<script id="globe-geometry" type="application/json" set:html={JSON.stringify(geoPaths).replaceAll("<", "\\u003c")} />
<script>
  const institutionButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-institution-region]')];
  const institutionGroups=[...document.querySelectorAll<HTMLElement>('[data-institution-group]')];
  const institutionCount=document.querySelector<HTMLElement>('#institution-filter-count');
  institutionButtons.forEach(button=>button.addEventListener('click',()=>{
    const selected=button.dataset.institutionRegion||'all';
    institutionButtons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
    let total=0;
    institutionGroups.forEach(group=>{
      group.hidden=selected!=='all'&&group.dataset.institutionGroup!==selected;
      if(!group.hidden)total+=group.querySelectorAll('.institution-city-list li').length;
    });
    if(institutionCount)institutionCount.textContent=`${total} ${total===1?'institution':'institutions'}`;
  }));
  const shell = document.getElementById('institution-map-shell') as HTMLElement | null;
  const map = document.getElementById('institution-world-map') as HTMLElement | null;
  const canvas = document.getElementById('institution-globe') as HTMLCanvasElement | null;
  const tooltip = document.getElementById('institution-map-tooltip') as HTMLElement | null;
  const details = document.getElementById('institution-map-details') as HTMLElement | null;
  const loading = document.getElementById('globe-loading');
  if (shell && map && canvas instanceof HTMLCanvasElement && tooltip && details) {
    const ctx = canvas.getContext('2d', {alpha:false});
    const texture = document.createElement('canvas');
    texture.width = 1200; texture.height = 520;
    const texCtx = texture.getContext('2d', {willReadFrequently:true});
    const pickCanvas = document.createElement('canvas');
    pickCanvas.width = 1200; pickCanvas.height = 520;
    const pickCtx = pickCanvas.getContext('2d', {willReadFrequently:true});
    const BASE = JSON.parse(document.getElementById('globe-geometry')?.textContent || '{}');
    const countryNames = Object.keys(BASE.featured || {}).filter(n => Array.from(details.children).some(el=>el.getAttribute('data-country-details')===n));
    const clamp=(n,a,b)=>Math.min(b,Math.max(a,n));
    // Geographic centre of the visible hemisphere; rotation is in radians.
    let longitude=75*Math.PI/180, latitude=19*Math.PI/180, zoom=1;
    let W=0,H=0,D=0, CX=0,CY=0,R=0, dragging=null, moved=false;
    let activeCountry=null, pinned=false, closeTimer, frame=0;
    let pixels, picks;
    // The project's original map is a simplified plate-carree-style SVG.
    // Reuse it as the source texture so all existing highlighted regions remain aligned.
    function initializeTextures(){
      texCtx.fillStyle='#f4f7f5'; texCtx.fillRect(0,0,1200,520);
      pickCtx.clearRect(0,0,1200,520);
      for(const region of BASE.base){
        const path=new Path2D(region.d);
        texCtx.fillStyle='#dae5dd';texCtx.strokeStyle='#b8cbbd';texCtx.lineWidth=.65;
        texCtx.fill(path,'evenodd');texCtx.stroke(path);
      }
      countryNames.forEach((name,i)=>{
        const path = new Path2D(BASE.featured[name]);
        texCtx.fillStyle='#8ec6b1';texCtx.strokeStyle='#29866a';texCtx.lineWidth=1.4;
        texCtx.fill(path,'evenodd');texCtx.stroke(path);
        // Unique red channel index + 1, no antialias confusion from neighbouring pixels.
        pickCtx.fillStyle=`rgb(${i+1},0,0)`;pickCtx.fill(path,'evenodd');
      });
      pixels=texCtx.getImageData(0,0,1200,520).data;
      picks=pickCtx.getImageData(0,0,1200,520).data;
      loading?.setAttribute('hidden','');resize();
    }
    function hideTip(){
      clearTimeout(closeTimer);activeCountry=null;pinned=false;
      tooltip.hidden=true;tooltip.replaceChildren();requestDraw();
    }
    function showTip(country,keep=false){
      if(!country)return;
      clearTimeout(closeTimer);
      if(activeCountry===country && !tooltip.hidden && pinned===keep)return;
      const el=Array.from(details.children).find(e=>e.getAttribute('data-country-details')===country);
      if(!el)return;
      if(activeCountry!==country||tooltip.hidden){
        tooltip.replaceChildren(...Array.from(el.children).map(c=>c.cloneNode(true)));
      }
      activeCountry=country;pinned=keep;tooltip.hidden=false;requestDraw();
    }
    function resize(){
      const b=map.getBoundingClientRect();
      const dpr=Math.min(window.devicePixelRatio||1,1.4);
      W=Math.max(1,Math.round(b.width*dpr));H=Math.max(1,Math.round(b.height*dpr));
      // Render at an efficient resolution, then scale up cleanly on HiDPI screens.
      const ratio=Math.min(1,900/Math.max(W,H));W=Math.round(W*ratio);H=Math.round(H*ratio);
      canvas.width=W;canvas.height=H;
      CX=W/2;CY=H/2;R=Math.min(W*.32,H*.455)*zoom;
      requestDraw();
    }
    function requestDraw(){if(!frame)frame=requestAnimationFrame(()=>{frame=0;render()})}
    function inverse(screenX,screenY){
      const x=(screenX-CX)/R,y=(CY-screenY)/R;
      const rr=x*x+y*y;
      if(rr>1)return null;
      const z=Math.sqrt(Math.max(0,1-rr));
      const cosLat=Math.cos(latitude),sinLat=Math.sin(latitude);
      const wx=x*Math.cos(longitude)+z*cosLat*Math.sin(longitude)-y*sinLat*Math.sin(longitude);
      const wy=y*cosLat+z*sinLat;
      const wz=-x*Math.sin(longitude)+z*cosLat*Math.cos(longitude)-y*sinLat*Math.cos(longitude);
      return [Math.atan2(wx,wz),Math.asin(clamp(wy,-1,1)),z];
    }
    function texturePosition(lon,lat){
      const tX=((600+(lon*180/Math.PI)*3.333333)%1200+1200)%1200;
      const tY=clamp(300-(lat*180/Math.PI)*3.15,0,519);
      return [Math.round(tX),Math.round(tY)];
    }
    function render(){
      if(!ctx||!pixels)return;
      const img=ctx.createImageData(W,H), out=img.data;
      // Opaque pale background, softly lit sea and shaded land. No external library/network required.
      for(let y=0;y<H;y++){
        for(let x=0;x<W;x++){
          const p=4*(y*W+x),dx=(x+.5-CX)/R,dy=(CY-y-.5)/R;
          const rr=dx*dx+dy*dy;
          if(rr>1){out[p]=244;out[p+1]=247;out[p+2]=245;out[p+3]=255;continue}
          const loc=inverse(x+.5,y+.5);
          if(!loc)continue;
          const [tx,ty]=texturePosition(loc[0],loc[1]);
          const i=4*(ty*1200+tx);
          // Soft side shading and edge atmosphere help distinguish the sphere from a flat circle.
          const shine=Math.max(0,.45+dx*(-.14)+dy*.25+loc[2]*.5);
          const edge=Math.pow(1-loc[2],3);
          const light=clamp(.84+shine*.16-edge*.10,.64,1.04);
          let r=pixels[i],g=pixels[i+1],b=pixels[i+2];
          const ci=picks[i];
          if(ci>0&&ci<=countryNames.length&&countryNames[ci-1]===activeCountry){r=43;g=155;b=112}
          out[p]=clamp(Math.round(r*light),0,255);
          out[p+1]=clamp(Math.round(g*light),0,255);
          out[p+2]=clamp(Math.round(b*light),0,255);
          out[p+3]=255;
        }
      }
      ctx.putImageData(img,0,0);
      // Thin outline identifies the limb against the almost-white ocean.
      ctx.beginPath();ctx.arc(CX,CY,R,0,Math.PI*2);
      ctx.strokeStyle='rgba(57,117,83,.23)';ctx.lineWidth=Math.max(1,W/950);ctx.stroke();
    }
    function countryAt(clientX,clientY){
      const rect=map.getBoundingClientRect();
      const pos=inverse((clientX-rect.left)*W/rect.width,(clientY-rect.top)*H/rect.height);
      if(!pos||!picks)return null;
      const [tx,ty]=texturePosition(pos[0],pos[1]);
      const code=picks[(ty*1200+tx)*4];
      return countryNames[code-1]||null;
    }
    function changeZoom(next){zoom=clamp(next,.68,2.7);R=Math.min(W*.32,H*.455)*zoom;requestDraw()}
    shell.querySelectorAll<HTMLButtonElement>('[data-map-action]').forEach(button=>button.addEventListener('click',()=>{
      if(button.dataset.mapAction==='in')changeZoom(zoom*1.25);
      if(button.dataset.mapAction==='out')changeZoom(zoom/1.25);
      if(button.dataset.mapAction==='reset'){longitude=75*Math.PI/180;latitude=19*Math.PI/180;changeZoom(1);hideTip()}
    }));
    map.addEventListener('wheel',e=>{e.preventDefault();changeZoom(zoom*(e.deltaY<0?1.12:1/1.12))},{passive:false});
    map.addEventListener('pointerdown',e=>{
      if(e.button!==0)return;
      dragging={id:e.pointerId,x:e.clientX,y:e.clientY,lon:longitude,lat:latitude};moved=false;
      map.setPointerCapture(e.pointerId);
    });
    map.addEventListener('pointermove',e=>{
      if(!dragging||dragging.id!==e.pointerId){
        if(!pinned){const country=countryAt(e.clientX,e.clientY);if(country)showTip(country);else if(activeCountry)hideTip()}
        return;
      }
      if(Math.abs(e.clientX-dragging.x)+Math.abs(e.clientY-dragging.y)>5)moved=true;
      if(moved){
        map.classList.add('is-dragging');
        const rect=map.getBoundingClientRect();
        longitude=dragging.lon-(e.clientX-dragging.x)/rect.width*5;
        latitude=clamp(dragging.lat+(e.clientY-dragging.y)/rect.height*3,-Math.PI*.46,Math.PI*.46);
        requestDraw();
      }
    });
    map.addEventListener('pointerup',e=>{
      if(dragging?.id!==e.pointerId)return;
      if(!moved){const country=countryAt(e.clientX,e.clientY);if(country){if(pinned&&activeCountry===country)hideTip();else showTip(country,true)}else hideTip()}
      dragging=null;map.classList.remove('is-dragging');
    });
    map.addEventListener('pointercancel',()=>{dragging=null;map.classList.remove('is-dragging')});
    map.addEventListener('pointerleave',()=>{if(!pinned)hideTip()});
    map.addEventListener('keydown',e=>{
      if(e.key==='+'||e.key==='='){e.preventDefault();changeZoom(zoom*1.25)}
      else if(e.key==='-'){e.preventDefault();changeZoom(zoom/1.25)}
      else if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();longitude+=(e.key==='ArrowLeft'?1:-1)*.17;requestDraw()}
      else if(e.key==='ArrowUp'||e.key==='ArrowDown'){e.preventDefault();latitude=clamp(latitude+(e.key==='ArrowUp'?-1:1)*.15,-1.44,1.44);requestDraw()}
      else if(e.key==='Escape')hideTip();
    });
    tooltip.addEventListener('pointerenter',()=>clearTimeout(closeTimer));
    tooltip.addEventListener('pointerleave',()=>{if(!pinned)hideTip()});
    document.addEventListener('pointerdown',e=>{if(!shell.contains(e.target as Node))hideTip()});
    window.addEventListener('resize',resize);
    initializeTextures();
  }
</script>
