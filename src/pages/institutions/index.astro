  .map-note{font-size:.78rem;color:#738479;margin-top:.65rem;line-height:1.6}
  .archive-list-heading{margin-bottom:0}
  .geo-all-button{grid-column:1/-1;width:100%;display:flex;justify-content:space-between;background:none;border:0;padding:.45rem 0;margin:0 0 1.15rem;text-align:left;font:inherit;color:#275840;cursor:pointer;font-size:.92rem}
  .geo-all-button span{font-size:.72rem;color:#819b88}
  .geo-all-button.is-active,.geo-country-button.is-active span{color:#148653;font-weight:600}
  .geo-country-button:focus-visible,.geo-all-button:focus-visible{outline:2px solid #67b58e;outline-offset:3px}
  .institution-filter-count{font-size:.77rem;color:var(--quiet);margin:0 0 1rem}
  .institution-country-group[hidden]{display:none!important}
  .institution-country-group{border-top:1px solid #c6dfd2;padding:1.65rem 0 1.3rem}
  .institution-country-group:last-child{border-bottom:1px solid #c6dfd2}
  .institution-country-header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.1rem}
  .institution-country-header h2{font-size:clamp(22px,2.3vw,29px);font-weight:400;line-height:1.3;letter-spacing:-.02em;margin:0}
  .institution-country-header span{font-size:.73rem;letter-spacing:.05em;color:#738479;white-space:nowrap}
  .institution-city-group{display:grid;grid-template-columns:minmax(110px,19%) minmax(0,1fr);gap:1.2rem;padding:.4rem 0 1.2rem}
