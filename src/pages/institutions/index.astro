---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const items=await getCollection('institutions');

const cityMeta = {
  Tokyo: { lon: 139.692, lat: 35.69, country: 'Japan' },
  Takamatsu: { lon: 134.05, lat: 34.34, country: 'Japan' },
  Yokohama: { lon: 139.638, lat: 35.44, country: 'Japan' },
  Fukuoka: { lon: 130.402, lat: 33.59, country: 'Japan' },
  Kitakyushu: { lon: 130.875, lat: 33.88, country: 'Japan' },
  Kyoto: { lon: 135.768, lat: 35.01, country: 'Japan' },
  Hiroshima: { lon: 132.459, lat: 34.39, country: 'Japan' },
  Gero: { lon: 137.245, lat: 35.81, country: 'Japan' },
  Tokamachi: { lon: 138.757, lat: 37.13, country: 'Japan' },
  Seoul: { lon: 126.978, lat: 37.57, country: 'South Korea' },
  Gwangju: { lon: 126.852, lat: 35.16, country: 'South Korea' },
  Busan: { lon: 129.075, lat: 35.18, country: 'South Korea' },
  'Hong Kong': { lon: 114.17, lat: 22.31, country: 'Hong Kong' },
  Singapore: { lon: 103.82, lat: 1.35, country: 'Singapore' },
  'East Java': { lon: 112.75, lat: -7.25, country: 'Indonesia' },
  Phuket: { lon: 98.39, lat: 7.88, country: 'Thailand' },
  Berlin: { lon: 13.405, lat: 52.52, country: 'Germany' },
  Copenhagen: { lon: 12.57, lat: 55.68, country: 'Denmark' },
  London: { lon: -0.128, lat: 51.51, country: 'United Kingdom' },
  Arles: { lon: 4.63, lat: 43.68, country: 'France' },
};

const countryOrder = ['Japan','South Korea','Hong Kong','Singapore','Indonesia','Thailand','Germany','Denmark','United Kingdom','France'];
const cityOrder = Object.keys(cityMeta);
const countryEntries = Object.entries(
  Object.groupBy(
    items.filter((item) => item.data.city && cityMeta[item.data.city]?.country),
    (item) => cityMeta[item.data.city].country,
  ),
).map(([country, entries]) => ({
  country,
  entries: entries.sort((a,b)=>a.data.name.localeCompare(b.data.name)),
  cities: Object.entries(Object.groupBy(entries, item => item.data.city))
    .map(([city, cityEntries]) => ({city, entries: cityEntries.sort((a,b)=>a.data.name.localeCompare(b.data.name))}))
    .sort((a,b)=>cityOrder.indexOf(a.city)-cityOrder.indexOf(b.city)),
})).sort((a,b)=>countryOrder.indexOf(a.country)-countryOrder.indexOf(b.country));
// One representative marker per country, weighted toward documented institutions.
// Compute a spherical mean so positions remain stable even near the date line.
const countryMarkers = countryEntries.map(({country,cities,entries}) => {
  const located = cities.flatMap(({city,entries:cityEntries}) => {
    const known = cityMeta[city];
    const custom = cityEntries.find(entry => entry.data.longitude !== undefined && entry.data.latitude !== undefined);
    const lon = custom?.data.longitude ?? known?.lon;
    const lat = custom?.data.latitude ?? known?.lat;
    return Number.isFinite(lon) && Number.isFinite(lat)
      ? [{lon,lat,count:cityEntries.length}] : [];
  });
  const avg = located.reduce((a,p) => {
    const lon=p.lon*Math.PI/180,lat=p.lat*Math.PI/180;
    a.x+=Math.sin(lon)*Math.cos(lat)*p.count;
    a.y+=Math.sin(lat)*p.count;
    a.z+=Math.cos(lon)*Math.cos(lat)*p.count;
    return a;
  },{x:0,y:0,z:0});
  return {country,lon:Math.atan2(avg.x,avg.z)*180/Math.PI,
    lat:Math.atan2(avg.y,Math.hypot(avg.x,avg.z))*180/Math.PI,
    count:entries.length};
}).filter(p=>Number.isFinite(p.lon)&&Number.isFinite(p.lat));
// A city dot represents a city, not an invented street-level institution address.
// When verified institution coordinates are added to the content, those may be rendered separately.
const focusCityMarkers = countryEntries.flatMap(({country,cities}) => cities.map(({city,entries}) => ({
  country,city,lon:cityMeta[city]?.lon,lat:cityMeta[city]?.lat,count:entries.length
})).filter(p=>Number.isFinite(p.lon)&&Number.isFinite(p.lat)));
const preciseInstitutionMarkers=countryEntries.flatMap(({country,entries})=>entries
  .filter(item=>item.data.longitude!==undefined&&item.data.latitude!==undefined&&item.data.locationType!=='variable')
  .map(item=>({country,city:item.data.city,name:item.data.name,id:item.id,lon:item.data.longitude,lat:item.data.latitude})));
const locationTypes=countryEntries.flatMap(({country,entries})=>entries
  .filter(item=>item.data.locationType==='variable')
  .map(item=>({country,name:item.data.name,id:item.id,city:item.data.city})));
const unmapped = items.filter(item => !item.data.city || !cityMeta[item.data.city]?.country);
---
<Base title="Institutions & Spaces | TOW ARCHIVE">
  <section class="archive institutions-page">
    <h1 class="sr-only">Institutions &amp; Spaces</h1>

    <section class="world-map-section" aria-label="Explore institution locations">
      <div class="map-heading"><span>GEOGRAPHIC INDEX</span><span>{countryEntries.length} countries · {items.length} entries</span></div>
      <div class="globe-index-layout">
      <div class="map-shell" id="institution-map-shell">
        <div class="globe-zoom-controls" id="globe-zoom-controls" hidden aria-label="Focused map zoom">
          <button type="button" data-map-action="zoom-out" aria-label="Zoom out" title="Zoom out">−</button>
          <button type="button" data-map-action="zoom-in" aria-label="Zoom in" title="Zoom in">+</button>
        </div>
        <div class="world-map" id="institution-world-map" role="group" aria-label="Rotatable geographic globe. Choose a country from the geographic index to enlarge its region and reveal recorded cities." tabindex="0">
          <canvas class="globe-canvas" id="institution-globe" aria-hidden="true"></canvas>
          <canvas class="globe-dots" id="institution-dots" aria-hidden="true"></canvas>
          <script id="globe-city-data" type="application/json" set:html={JSON.stringify(countryMarkers).replaceAll("<", "\\u003c")} />
          <script id="globe-focus-city-data" type="application/json" set:html={JSON.stringify(focusCityMarkers).replaceAll('<', "\\u003c")} />
          <script id="globe-site-data" type="application/json" set:html={JSON.stringify(preciseInstitutionMarkers).replaceAll('<','\\u003c')} />
          <script id="globe-variable-data" type="application/json" set:html={JSON.stringify(locationTypes).replaceAll('<','\\u003c')} />
          <div class="globe-loading" id="globe-loading">Preparing globe…</div>
        </div>
        <div class="map-tooltip" id="institution-map-tooltip" hidden aria-live="polite"></div>
        <div id="institution-map-details" hidden>
          {countryEntries.map(({country,cities,entries}) => (
            <section data-country-details={country}>
              <div class="map-popup-country">{country}<span>{entries.length}</span></div><p class="map-location-precision">City dots show approximate city centres, not individual venue addresses.</p>
              <div class="map-popup-groups">
                {cities.map(({city,entries}) => (
                  <section class="map-popup-group">
                    <h3>{city}</h3>
                    <ul>{entries.map(item=><li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}</ul>
                  </section>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <aside class="geo-index" aria-label="Browse institutions by location">
        <p class="geo-index-kicker">EXPLORE BY REGION</p>
        <button type="button" class="geo-all-button is-active" data-jump-country="all" aria-pressed="true">All institutions <span>{items.length}</span></button>
        <div class="geo-index-group"><h2>Asia</h2>
          {countryEntries.filter(g=>['Japan','South Korea','Hong Kong','Singapore','Indonesia','Thailand'].includes(g.country)).map(({country,cities,entries})=>(
            <div class="geo-country"><button type="button" class="geo-country-button" data-jump-country={country} aria-pressed="false"><span>{country}</span><small>{entries.length}</small></button><p>{cities.map(c=>c.city).join(' · ')}</p></div>
          ))}
        </div>
        <div class="geo-index-group"><h2>Europe</h2>
          {countryEntries.filter(g=>['Germany','Denmark','United Kingdom','France'].includes(g.country)).map(({country,cities,entries})=>(
            <div class="geo-country"><button type="button" class="geo-country-button" data-jump-country={country} aria-pressed="false"><span>{country}</span><small>{entries.length}</small></button><p>{cities.map(c=>c.city).join(' · ')}</p></div>
          ))}
        </div>
        <p class="geo-index-help">Select a country to focus the map. Use + / − to zoom further; select All institutions to return.</p>
      </aside>
      </div>
    </section>

    <p class="sr-only" id="institution-filter-count" role="status" aria-live="polite">{items.length} institutions</p>
    <div class="institution-geography-index">
      {countryEntries.map(({country,cities,entries}) => (
        <section class="institution-country-group" data-institution-group={country} aria-label={`${country} institutions`}>
          <header class="institution-country-header">
            <h2>{country}</h2>
            <span>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</span>
          </header>
          {cities.map(({city,entries:cityEntries}) => (
            <section class="institution-city-group" aria-label={`${city} institutions`}>
              <h3>{city}</h3>
              <ul class="institution-city-list">
                {cityEntries.map(item => <li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}
              </ul>
            </section>
          ))}
        </section>
      ))}
      {unmapped.length > 0 && (
        <section class="institution-country-group" data-institution-group="unmapped" aria-label="Unclassified institutions">
          <header class="institution-country-header"><h2>Location not yet specified</h2><span>{unmapped.length} entries</span></header>
          <ul class="institution-city-list institution-ungrouped-list">
            {unmapped.map(item => <li><a href={`/institutions/${item.id}/`}>{item.data.name}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </section>
</Base>

<style>
