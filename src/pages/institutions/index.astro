    updateMobileAtlas(country);
    geoButtons.forEach(b=>{const active=b.dataset.jumpCountry===country;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});
    let total=0;
    const q=normalizeInstitution(institutionSearch?.value||'');
    institutionGroups.forEach(group=>{
      const inCountry=country==='all'||group.dataset.institutionGroup===country;
      let groupCount=0;
      for(const li of group.querySelectorAll<HTMLLIElement>('.institution-city-list li')){
        li.hidden=Boolean(q&&!normalizeInstitution((li.textContent||'')+' '+(li.dataset.nameTerms||'')).includes(q));
        if(!li.hidden)groupCount++;
      }
      for(const city of group.querySelectorAll<HTMLElement>('.institution-city-group')){
        city.hidden=Boolean(q&&!city.querySelector('.institution-city-list li:not([hidden])'));
      }
      group.hidden=!inCountry||(Boolean(q)&&groupCount===0);
      if(!group.hidden)total+=groupCount;
    });
    if(institutionCount)institutionCount.textContent=`${total} ${total===1?'institution':'institutions'}`;
    if(scroll)document.querySelector('.institution-geography-index')?.scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});
  }
