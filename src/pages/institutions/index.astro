    };
    const draw=()=>{
      frame=0;
      if(!mobileCtx)return;
      const d=getDims();
      if(dotsCanvas.width!==d.w||dotsCanvas.height!==d.h){dotsCanvas.width=d.w;dotsCanvas.height=d.h;}
      mobileCtx.clearRect(0,0,d.w,d.h);
