  .institution-city-list li+li{border-top:1px solid #e4ede7}
  .institution-city-list a{font-size:clamp(16px,1.65vw,21px);line-height:1.5;letter-spacing:-.02em;overflow-wrap:anywhere}
  .institution-city-list a:hover,.institution-city-list a:focus-visible{color:#056848;text-decoration:underline;text-underline-offset:4px}
  .institution-ungrouped-list{margin-left:calc(19% + 1.2rem)}
  @media(max-width:680px){.institution-city-group{grid-template-columns:1fr;gap:.25rem}.institution-city-group h3{margin:0;font-size:.8rem}.institution-country-group{padding:1.35rem 0}.institution-ungrouped-list{margin-left:0}.world-map{height:clamp(310px,88vw,480px)}.world-map-section{margin:0 0 2rem}.map-heading{font-size:.64rem}.map-tooltip{position:static;width:auto;max-height:none;border-top:1px solid #e4ece7;border-left:0;border-right:0;border-bottom:0;box-shadow:none;margin:0;padding:12px 14px}}
  @media(prefers-reduced-motion:reduce){.world-map{scroll-behavior:auto}}
  /* The index floats directly on the white page, with no opaque gradient panel. */
