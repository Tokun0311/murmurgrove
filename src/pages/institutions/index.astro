</style>
<script>
  const institutionGroups=[...document.querySelectorAll<HTMLElement>('[data-institution-group]')];
  const institutionCount=document.querySelector<HTMLElement>('#institution-filter-count');
  const geoButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-jump-country]')];
  const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobileAtlas=document.getElementById('mobile-land-atlas');
  const mobileAtlasTap=document.getElementById('mobile-land-atlas-tap');
  const atlasSelection=document.getElementById('mobile-land-atlas-selection');
  const atlasLocations: {country:string,lon:number,lat:number}[]=JSON.parse(document.getElementById('globe-city-data')?.textContent||'[]');
  // The PNG is a full-world equirectangular projection (1600 x 800):
  // longitude -180..180, latitude 90..-90. Use those exact image bounds.
  // The previous cropped-region formula misplaced the marker near the top edge.
  const atlasPosition=(lon:number,lat:number)=>({
    x:Math.max(5,Math.min(95,(lon+180)/360*100)),
    y:Math.max(8,Math.min(92,(90-lat)/180*100))
  });
  function updateMobileAtlas(country:string){
    if(!mobileAtlas||!atlasSelection)return;
    const marker=atlasLocations.find(item=>item.country===country);
    atlasSelection.hidden=!marker;
    if(marker){
      const pos=atlasPosition(marker.lon,marker.lat);
      mobileAtlas.style.setProperty('--atlas-x',`${pos.x}%`);
      mobileAtlas.style.setProperty('--atlas-y',`${pos.y}%`);
    }
  }
  mobileAtlasTap?.addEventListener('click',event=>{
    const box=mobileAtlasTap.getBoundingClientRect();
    const x=(event.clientX-box.left)/box.width;
    const y=(event.clientY-box.top)/box.height;
    const nearest=atlasLocations.map(item=>{
      const pt=atlasPosition(item.lon,item.lat);
      // Equirectangular coordinates, corrected for higher-latitude distortion.
      const dx=(x-pt.x/100)*Math.max(.3,Math.cos(item.lat*Math.PI/180));
      const dy=(y-pt.y/100);
      return {country:item.country,dist:Math.hypot(dx,dy)};
    }).sort((a,b)=>a.dist-b.dist)[0];
    if(nearest && nearest.dist<.115) selectCountry(nearest.country);
  });
  const institutionSearch=document.querySelector<HTMLInputElement>('#institution-search');
  const normalizeInstitution=(value:string)=>value.normalize('NFKD').toLocaleLowerCase().replace(/[\p{M}\p{P}\p{Z}\s]/gu,'');
  let selectedCountry='all';
  function filterCountry(country:string,scroll=false){
