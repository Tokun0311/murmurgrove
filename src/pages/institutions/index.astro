  .map-popup-country span{color:#789084;font-weight:400}
  .map-popup-groups{display:grid;gap:.8rem}
  .map-popup-group h3{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#6f8478;margin:0 0 .24rem}
  .map-popup-group ul{list-style:none;margin:0;padding:0}
  .map-popup-group li+li{border-top:1px solid #ecf1ec}
