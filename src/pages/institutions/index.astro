        const py=(d.cy-y)/d.r;
        for(let x=Math.max(0,Math.floor(d.cx-d.r));x<Math.min(d.w,Math.ceil(d.cx+d.r));x++){
          const px=(x-d.cx)/d.r;
          const rr=px*px+py*py;
          if(rr>=1)continue;
          const z=Math.sqrt(1-rr);
          const wx=px*cl+z*ct*sl-py*st*sl;
          const wy=py*ct+z*st;
          const wz=-px*sl+z*ct*cl-py*st*cl;
          const lng=Math.atan2(wx,wz),lat=Math.asin(clamp(wy,-1,1));
          const ix=Math.min(maskWidth-1,Math.max(0,Math.floor((lng/(2*PI)+.5)*maskWidth)));
          const iy=Math.min(maskHeight-1,Math.max(0,Math.floor((.5-lat/PI)*maskHeight)));
          const land=pixels&&maskWidth?pixels[(iy*maskWidth+ix)*4+3]/255:0;
          const edge=Math.min(1,(1-Math.sqrt(rr))*d.r/2.3);
          const k=Math.max(0,Math.min(1,land));
          const shade=.95+.05*z;
          const idx=(y*d.w+x)*4;
          out[idx]=Math.round((249*(1-k)+211*k)*shade);
          out[idx+1]=Math.round((252*(1-k)+232*k)*shade);
          out[idx+2]=Math.round((250*(1-k)+221*k)*shade);
          out[idx+3]=Math.round(255*edge);
        }
      }
      mobileCtx.putImageData(img,0,0);
      // Discreet outline clarifies that the drawing is a rotating sphere.
      mobileCtx.beginPath();mobileCtx.arc(d.cx,d.cy,d.r,0,PI*2);
      mobileCtx.lineWidth=1;mobileCtx.strokeStyle='rgba(104,165,134,.16)';mobileCtx.stroke();
      renderedPoints=[];
      for(const point of latData){
        const projected=project(point.lon,point.lat,d);if(!projected)continue;
        const active=!selectedCountry||selectedCountry===point.country;
        renderedPoints.push({...projected,country:point.country});
        if(active){
          const glow=mobileCtx.createRadialGradient(projected.x,projected.y,0,projected.x,projected.y,15);
          glow.addColorStop(0,'rgba(21,125,92,.26)');glow.addColorStop(1,'rgba(21,125,92,0)');
