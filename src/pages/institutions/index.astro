    };
    const closest=(clientX:number,clientY:number)=>{
      const box=map.getBoundingClientRect();
      const x=(clientX-box.left)*dotsCanvas.width/box.width;
      const y=(clientY-box.top)*dotsCanvas.height/box.height;
