        mobileCtx.fillStyle=active?'#167b53':'rgba(91,148,117,.40)';mobileCtx.fill();
        mobileCtx.lineWidth=1.6;mobileCtx.strokeStyle='rgba(255,255,255,.92)';mobileCtx.stroke();
      }
    };
    const requestDraw=()=>{if(!frame)frame=requestAnimationFrame(draw)};
    const animateTo=(lon:number,lat:number)=>{
      if(turnFrame)cancelAnimationFrame(turnFrame);
      const fromLon=longitude,fromLat=latitude;
      const delta=Math.atan2(Math.sin(lon-longitude),Math.cos(lon-longitude));
      if(reducedMotion.matches){longitude=fromLon+delta;latitude=lat;requestDraw();return;}
      const start=performance.now();
      const tick=(t:number)=>{
        const p=clamp((t-start)/650,0,1),e=p*p*(3-2*p);
        longitude=fromLon+delta*e;latitude=fromLat+(lat-fromLat)*e;
