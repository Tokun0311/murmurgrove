          if(rr>=1.0)discard;
          float z=sqrt(max(0.0,1.0-rr));
          float cl=cos(lonRotation),sl=sin(lonRotation);
          float ct=cos(latRotation),st=sin(latRotation);
          float wx=p.x*cl+z*ct*sl-p.y*st*sl;
          float wy=p.y*ct+z*st;
          float wz=-p.x*sl+z*ct*cl-p.y*st*cl;
          float lng=atan(wx,wz);
          float lat=asin(clamp(wy,-1.0,1.0));
          float scale=3.14159265359/6.0;
          float lonDist=abs(fract((lng+scale*.5)/scale)-.5)*scale;
          float latDist=abs(fract((lat+scale*.5)/scale)-.5)*scale;
          float lonPx=1.0/max(1.0,sphereRadius*max(.12,cos(lat)));
          float latPx=1.0/max(1.0,sphereRadius);
          float meridian=1.0-smoothstep(.0,lonPx*.96,lonDist);
          float parallel=1.0-smoothstep(.0,latPx*.96,latDist);
          float grid=max(meridian,parallel)*.37;
          // Sample a merged land mask. Countries share the same fill and have NO internal borders.
          vec2 uv=vec2(fract(lng/6.28318530718+.5),clamp(lat/3.14159265359+.5,0.001,.999));
          float land=texture2D(landMask,uv).a;
          // On small screens the ocean, graticule and globe rim vanish completely.
          // The original desktop shader is preserved in the other branch.
          if(mobileLandOnly>0.5){
            float silhouette=smoothstep(.025,.82,land);
            float edgeFade=1.0-smoothstep(.975,1.0,rr);
            gl_FragColor=vec4(.863,.925,.909,silhouette*.79*edgeFade);
            return;
          }
          vec3 color=mix(vec3(1.0),vec3(.927,.955,.969),land*.62);
          color=mix(color,vec3(.70,.80,.83),grid*.32);
          float edge=1.0-smoothstep(.65/max(sphereRadius,1.0),2.2/max(sphereRadius,1.0),1.0-sqrt(rr));
          color=mix(color,vec3(.70,.83,.84),edge*.23);
          gl_FragColor=vec4(color,1.0-smoothstep(.998,1.0,rr));
        }`;
      const compile=(source:string,type:number)=>{
        const shader=gl.createShader(type)!;
        gl.shaderSource(shader,source);gl.compileShader(shader);
        if(!gl.getShaderParameter(shader,gl.COMPILE_STATUS))throw new Error(gl.getShaderInfoLog(shader)||'Globe shader failed');
        return shader;
      };
      const program=gl.createProgram()!;
      gl.attachShader(program,compile(vertex,gl.VERTEX_SHADER));
      gl.attachShader(program,compile(fragment,gl.FRAGMENT_SHADER));
      gl.linkProgram(program);
      if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw new Error(gl.getProgramInfoLog(program)||'Globe program failed');
      gl.useProgram(program);
      const quad=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,quad);
      gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
      const attr=gl.getAttribLocation(program,'pos');gl.enableVertexAttribArray(attr);
      gl.vertexAttribPointer(attr,2,gl.FLOAT,false,0,0);
      const uniforms={
        size:gl.getUniformLocation(program,'viewSize'),center:gl.getUniformLocation(program,'center'),
        radius:gl.getUniformLocation(program,'sphereRadius'),lon:gl.getUniformLocation(program,'lonRotation'),
        lat:gl.getUniformLocation(program,'latRotation'),
        land:gl.getUniformLocation(program,'landMask'),
        mobile:gl.getUniformLocation(program,'mobileLandOnly')
      };
      const landTexture=gl.createTexture()!;
      gl.activeTexture(gl.TEXTURE0);gl.bindTexture(gl.TEXTURE_2D,landTexture);
      gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,1,1,0,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array([0,0,0,0]));
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
      gl.uniform1i(uniforms.land,0);
      const landImage=new Image();
      landImage.onload=()=>{
        gl.activeTexture(gl.TEXTURE0);gl.bindTexture(gl.TEXTURE_2D,landTexture);
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL,true);
        gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,landImage);
        requestDraw();
      };
      landImage.src='/land-mask.png';
      loading?.setAttribute('hidden','');

      function requestDraw(){if(!frame)frame=requestAnimationFrame(()=>{frame=0;draw()})}
      // Animate only the camera. Canvas geometry and page layout stay fixed throughout transitions.
      function getFocusTarget(country:string){
        const pts=focusCities.filter(p=>p.country===country);
        const preset=countryViewOverrides[country];
        if(preset)return {lon:preset.lon*PI/180,lat:preset.lat*PI/180,zoom:compactMobile.matches?1.42:preset.zoom};
        const focus=getCountryFocus(country);
        return compactMobile.matches?{...focus,zoom:1.42}:focus;
      }
      function animateCamera(target:{lon:number,lat:number,zoom:number},duration=1050){
        if(turnAnimation){cancelAnimationFrame(turnAnimation);turnAnimation=0;}
        const from={lon:longitude,lat:latitude,zoom};
        const longitudeDelta=Math.atan2(Math.sin(target.lon-from.lon),Math.cos(target.lon-from.lon));
        if(reducedMotion.matches){longitude=from.lon+longitudeDelta;latitude=target.lat;zoom=target.zoom;requestDraw();return;}
        const start=performance.now();
        const longJourney=Math.abs(longitudeDelta)>0.75;
        const tick=(time:number)=>{
          const t=clamp((time-start)/duration,0,1);
          const ease=t*t*(3-2*t);
          longitude=from.lon+longitudeDelta*ease;
          latitude=from.lat+(target.lat-from.lat)*ease;
          const base=from.zoom+(target.zoom-from.zoom)*ease;
          // Pull the camera out briefly between distant countries to avoid a sideways sweep of an enormous landmass.
          zoom=Math.max(.85,base-(longJourney?Math.min(from.zoom,target.zoom)*.44*Math.sin(PI*t):0));
          requestDraw();
          if(t<1)turnAnimation=requestAnimationFrame(tick);else turnAnimation=0;
        };
        turnAnimation=requestAnimationFrame(tick);
      }
      focusGlobeCountry=(country:string)=>{
        hideTip();
        selectedGlobeCountry=country==='all'?null:country;
        map.classList.remove('is-country-target');
        document.body.classList.toggle('globe-country-focused',!!selectedGlobeCountry);
        zoomControls?.toggleAttribute('hidden',!selectedGlobeCountry);
        const target=selectedGlobeCountry?getFocusTarget(selectedGlobeCountry):defaultGlobe;
        animateCamera(compactMobile.matches?{...target,zoom:Math.min(target.zoom,2.15)}:target);
      };
      function draw(){
        updateProjection();
        gl.viewport(0,0,width,height);
        gl.clearColor(1,1,1,0);gl.clear(gl.COLOR_BUFFER_BIT);
        gl.uniform2f(uniforms.size,width,height);
        gl.uniform2f(uniforms.center,cx,height-cy);
        gl.uniform1f(uniforms.radius,radius);
        gl.uniform1f(uniforms.lon,longitude);
        gl.uniform1f(uniforms.lat,latitude);
        gl.uniform1f(uniforms.mobile,compactMobile.matches?1:0);
        gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
        drawDots();
      }
      function dotPosition(lonDeg:number,latDeg:number){
        const lon=lonDeg*PI/180,lat=latDeg*PI/180;
        const wx=Math.sin(lon)*Math.cos(lat),wy=Math.sin(lat),wz=Math.cos(lon)*Math.cos(lat);
        const cl=Math.cos(longitude),sl=Math.sin(longitude),ct=Math.cos(latitude),st=Math.sin(latitude);
        const x=wx*cl-wz*sl;
        const t=wx*sl+wz*cl;
        const y=wy*ct-t*st;
        const depth=wy*st+t*ct;
        return depth>0?[cx+x*radius,cy-y*radius]:null;
      }
      type GeographicPoint=CityMarker|FocusCity|PreciseSite;
      type ProjectedPoint={x:number,y:number,point:GeographicPoint};
      let visiblePoints:ProjectedPoint[]=[];
      const isSite=(p:GeographicPoint):p is PreciseSite=>'id' in p;
      const isCity=(p:GeographicPoint):p is FocusCity=>'city' in p && !('id' in p);
      function drawDots(){
        if(!dotCtx)return;
        dotCtx.clearRect(0,0,width,height);
        visiblePoints=[];
        const dpr=Math.min(window.devicePixelRatio||1,2);
        const points:GeographicPoint[]=selectedGlobeCountry
          ? focusCities.filter(p=>p.country===selectedGlobeCountry)
          : cities;
        // All points use actual geographic projections; never render hidden hemisphere dots.
        for(const point of points){
          const pos=dotPosition(point.lon,point.lat);if(!pos)continue;
          const [x,y]=pos;
          if(x<0||x>width||y<0||y>height)continue;
          visiblePoints.push({x,y,point});
          if(compactMobile.matches){
            // Keep hit targets at their geographic positions, but don't paint
            // mobile ticks or dots over the land silhouettes.
            continue;
          }
          const selected=!!selectedGlobeCountry;
          const density=Math.min(1,Math.log1p('count' in point?point.count:1)/Math.log(41));
          const spread=(selected?20:21)+(selected?10:27)*density;
          const glow=dotCtx.createRadialGradient(x,y,0,x,y,spread*dpr);
          glow.addColorStop(0,`rgba(21,125,92,${(selected?.30:.13)+.23*density})`);
          glow.addColorStop(.45,`rgba(65,161,123,${(selected?.14:.05)+.12*density})`);
          glow.addColorStop(1,'rgba(64,162,119,0)');
          dotCtx.fillStyle=glow;
          dotCtx.beginPath();dotCtx.arc(x,y,spread*dpr,0,2*PI);dotCtx.fill();
          dotCtx.beginPath();dotCtx.arc(x,y,(selected?4.2:2.2)*dpr,0,2*PI);
          dotCtx.fillStyle='rgba(255,255,255,.96)';dotCtx.fill();
          dotCtx.beginPath();dotCtx.arc(x,y,(selected?2.8:1.7)*dpr,0,2*PI);
          dotCtx.fillStyle='rgba(25,112,80,.95)';dotCtx.fill();
        }
      }
      function pointAt(clientX:number,clientY:number):GeographicPoint|null{
        const b=map.getBoundingClientRect();
        const x=(clientX-b.left)*width/b.width,y=(clientY-b.top)*height/b.height;
        const dpr=Math.min(window.devicePixelRatio||1,2);
        const nearest=visiblePoints.map(p=>({p,d:Math.hypot(x-p.x,y-p.y)})).sort((a,b)=>a.d-b.d)[0];
        return nearest && nearest.d<(selectedGlobeCountry?24:17)*dpr?nearest.p.point:null;
      }
      function showPointTip(point:GeographicPoint,keep=false){
        if(isSite(point)){
          clearTimeout(closeTimer);
          tooltip.replaceChildren();
          const heading=document.createElement('div');heading.className='map-popup-country';heading.textContent=point.name;
          const link=document.createElement('a');link.href=`/institutions/${point.id}/`;link.textContent='View institution record';link.className='cluster-city-link';
          tooltip.append(heading,link);tooltip.hidden=false;activeCountry=point.country;pinned=keep;
          return;
        }
        showTip(point.country,keep,isCity(point)?point.city:undefined);
      }
      function updateProjection(){
        // Stable map coordinate system across global and country views.
        // On mobile, recentre the globe so it acts like a compact exploratory card
        // rather than a cropped background element.
        if(compactMobile.matches){
          const baseRadius=Math.min(width*.47,height*.49);
          radius=baseRadius*zoom;
          cx=width*.5;
          cy=height*.51;
          return;
        }
        const baseRadius=Math.min(width*.205,height*.37);
        radius=baseRadius*zoom;
        cx=width*.285;
        cy=height*.54;
      }
      function resize(){
        const b=map.getBoundingClientRect();
        const dpr=Math.min(window.devicePixelRatio||1,2);
        const nextWidth=Math.max(1,Math.round(b.width*dpr));
        const nextHeight=Math.max(1,Math.round(b.height*dpr));
        width=nextWidth;height=nextHeight;
        if(canvas.width!==width||canvas.height!==height){canvas.width=width;canvas.height=height;}
        if(dotsCanvas.width!==width||dotsCanvas.height!==height){dotsCanvas.width=width;dotsCanvas.height=height;}
        requestDraw();
      }
      function hideTip(){clearTimeout(closeTimer);activeCountry=null;pinned=false;tooltip.hidden=true;tooltip.replaceChildren()}
      function showTip(country:string,keep=false,city?:string){
        clearTimeout(closeTimer);
        const el=Array.from(details.children).find(e=>e.getAttribute('data-country-details')===country);
        if(!el)return;
        if(activeCountry!==country||tooltip.hidden||city){
          const children=Array.from(el.children).map(c=>c.cloneNode(true) as HTMLElement);
          if(city){
            const groups=children.find(c=>c.classList.contains('map-popup-groups'));
            groups?.querySelectorAll<HTMLElement>('.map-popup-group').forEach(group=>{
              if(group.querySelector('h3')?.textContent!==city)group.remove();
            });
          }
          tooltip.replaceChildren(...children);
        }
        activeCountry=country;pinned=keep;tooltip.hidden=false;
      }
      zoomControls?.querySelectorAll<HTMLButtonElement>('[data-map-action]').forEach(button=>button.addEventListener('click',()=>{
        if(!selectedGlobeCountry)return;
        if(turnAnimation){cancelAnimationFrame(turnAnimation);turnAnimation=0;}
        const factor=button.dataset.mapAction==='zoom-in'?1.28:1/1.28;
        animateCamera({lon:longitude,lat:latitude,zoom:clamp(zoom*factor,1.65,10.5)},320);
      }));
      map.addEventListener('pointerdown',e=>{
        if(e.button!==0)return;
        if(turnAnimation)cancelAnimationFrame(turnAnimation);
        dragging={id:e.pointerId,x:e.clientX,y:e.clientY,lon:longitude,lat:latitude};moved=false;
        map.setPointerCapture(e.pointerId);
      });
      map.addEventListener('pointermove',e=>{
        if(!dragging||dragging.id!==e.pointerId){
          const point=pointAt(e.clientX,e.clientY);
          // Hover preview remains unchanged. Only an overview COUNTRY dot is a navigation target.
          map.classList.toggle('is-country-target',!selectedGlobeCountry&&!!point);
          if(!pinned){if(point)showPointTip(point);else if(activeCountry)hideTip()}
          return;
        }
        if(Math.abs(e.clientX-dragging.x)+Math.abs(e.clientY-dragging.y)>4)moved=true;
        if(moved){
          map.classList.add('is-dragging');
          const b=map.getBoundingClientRect();
          longitude=dragging.lon-(e.clientX-dragging.x)/b.width*4.0;
          latitude=clamp(dragging.lat+(e.clientY-dragging.y)/b.height*2.6,-PI*.46,PI*.46);
          requestDraw();
        }
      });
      map.addEventListener('pointerup',e=>{
        if(dragging?.id!==e.pointerId)return;
        if(!moved){
          const point=pointAt(e.clientX,e.clientY);
          if(point){
            if(!selectedGlobeCountry && !isCity(point) && !isSite(point)) {
              // Equivalent to pressing the country name on the geographic index.
              selectCountry(point.country);
            } else {
              // Focused city/institution previews keep their existing pinned-card behavior.
              showPointTip(point,true);
            }
          } else hideTip();
        }
        dragging=null;map.classList.remove('is-dragging');
      });
      map.addEventListener('pointercancel',()=>{dragging=null;map.classList.remove('is-dragging','is-country-target')});
      map.addEventListener('pointerleave',()=>{map.classList.remove('is-country-target');if(!pinned)hideTip()});
      map.addEventListener('keydown',e=>{
        if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();longitude+=(e.key==='ArrowLeft'?1:-1)*.17;requestDraw()}
        else if(e.key==='ArrowUp'||e.key==='ArrowDown'){e.preventDefault();latitude=clamp(latitude+(e.key==='ArrowUp'?-1:1)*.15,-1.44,1.44);requestDraw()}
        else if(e.key==='Escape')hideTip();
      });
      tooltip.addEventListener('pointerenter',()=>clearTimeout(closeTimer));
      tooltip.addEventListener('pointerleave',()=>{if(!pinned)hideTip()});
      document.addEventListener('pointerdown',e=>{if(!shell.contains(e.target as Node))hideTip()});
      function updateMapOverlap(){
        const section=document.querySelector<HTMLElement>('.world-map-section');
        const layout=section?.querySelector<HTMLElement>('.globe-index-layout');
        if(!layout)return;
        // Offset from the page top to the globe layout. The background ends at the bottom of this section.
        const top=layout.getBoundingClientRect().top+window.scrollY;
        layout.style.setProperty('--globe-page-overlap',`${Math.round(top)}px`);
        // Fit the geographic section to the first viewport rather than a capped 675px height.
        // The full-width boundary sits at the fold; the white institution list starts below it.
        // Calculate from document coordinates so scrolling cannot change the layout height.
        if (window.matchMedia('(min-width:761px)').matches) {
          const targetHeight=Math.max(550,Math.round(window.innerHeight-top));
          if(layout.style.minHeight!==`${targetHeight}px`) layout.style.minHeight=`${targetHeight}px`;
        } else if(layout.style.minHeight) {
          layout.style.removeProperty('min-height');
        }
      }
      const observer=new ResizeObserver(()=>{updateMapOverlap();resize()});observer.observe(map);
      updateMapOverlap();
      window.addEventListener('resize',updateMapOverlap,{passive:true});
      resize();
    }
  }
</script>

<style is:global>
.institutions-page #institution-search{display:block;width:min(100%,420px);padding:9px 0;margin:18px 0 8px;font-size:15px;color:var(--ink)}
.institutions-page .institution-search-count{font-size:12px;color:var(--quiet);margin:0 0 24px}
.institutions-page .institution-city-list li[hidden],.institutions-page .institution-city-group[hidden],.institutions-page .institution-country-group[hidden]{display:none!important}
</style>
