      const points=latData.filter(pt=>pt.country===selectedCountry);
      if(!points.length){requestDraw();return;}
      const lon=points.reduce((s,pt)=>s+pt.lon,0)/points.length;
      const lat=points.reduce((s,pt)=>s+pt.lat,0)/points.length;
