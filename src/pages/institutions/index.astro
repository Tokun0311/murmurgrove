  .geo-country-button span{font-size:.78rem}.geo-country-button small{font-size:.67rem;color:#8da498}
  .geo-country-button:hover span,.geo-country-button:focus-visible span{color:#16835b;text-decoration:underline;text-underline-offset:3px}
  .geo-country p{font-size:.63rem;color:#91a499;line-height:1.35;margin:.08rem 0 0}
  .geo-index-help{grid-column:1/-1;font-size:.7rem;color:#8c9e92;line-height:1.5;margin:.25rem 0 0}
  @media(max-width:780px){.globe-index-layout{grid-template-columns:1fr;gap:8px}.geo-index{max-height:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.geo-index-kicker,.geo-index-help{grid-column:1/-1;margin:0}.geo-index-group{margin:0}.world-map{height:clamp(310px,75vw,490px)!important}}
  .map-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center;font-size:.72rem;letter-spacing:.12em;color:#668075;text-transform:uppercase;margin:0 0 .9rem}
  .map-shell{position:relative;border:0;border-radius:0;background:#fff;isolation:isolate;overflow:visible}
  .world-map{position:relative;width:100%;height:clamp(330px,42vw,520px);overflow:hidden;cursor:grab;touch-action:none;outline-offset:3px;user-select:none;-webkit-user-select:none;background:#fff}
  .world-map.is-dragging{cursor:grabbing}
  .globe-canvas,.globe-dots{width:100%;height:100%;display:block;pointer-events:none}
  .globe-dots{position:absolute;inset:0}
  .globe-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#789084;letter-spacing:.08em;pointer-events:none}
  .globe-loading[hidden]{display:none}
  .map-controls{position:absolute;top:16px;left:16px;z-index:20;display:flex;gap:5px;align-items:center}
