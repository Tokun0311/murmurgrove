---
import {institutionListNames} from '../../lib/record-names.mjs';
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const sourceItems=await getCollection('institutions');

import cityRegistry from '../../lib/geographic-index.json';
import {groupCountries} from '../../lib/institution-geography.mjs';
const cityMeta: Record<string,{lon:number;lat:number;country:string;aliases?:string[]}> = cityRegistry;
const cityKey=(s:string)=>s.normalize('NFKC').trim().toLowerCase();
const names=new Map(Object.entries(cityMeta).flatMap(([city,meta])=>[city,...(meta.aliases||[])].map(alias=>[cityKey(alias),city] as const)));
const items=sourceItems.map(item=>({...item,data:{...item.data,city:item.data.city?(names.get(cityKey(item.data.city))||item.data.city):item.data.city}}));

const countryOrder = ['Japan','South Korea','Hong Kong','Singapore','Indonesia','Thailand','Germany','Denmark','United Kingdom','France'];
const cityOrder = Object.keys(cityMeta);
// Keep existing country order; new countries follow in alphabetical order.
const countryRank=(country:string)=>{const i=countryOrder.indexOf(country);return i===-1?countryOrder.length:i;};
const countryEntries = Object.entries(
  Object.groupBy(
    items.filter((item) => item.data.city && cityMeta[item.data.city]?.country),
    (item) => cityMeta[item.data.city].country,
  ),
).map(([country, entries]) => ({
  country,
  entries: entries.sort((a,b)=>institutionListNames(a.data,a.id).display.localeCompare(institutionListNames(b.data,b.id).display,'en')),
  cities: Object.entries(Object.groupBy(entries, item => item.data.city))
    .map(([city, cityEntries]) => ({city, entries: cityEntries.sort((a,b)=>institutionListNames(a.data,a.id).display.localeCompare(institutionListNames(b.data,b.id).display,'en'))}))
    .sort((a,b)=>cityOrder.indexOf(a.city)-cityOrder.indexOf(b.city)),
})).sort((a,b)=>countryRank(a.country)-countryRank(b.country)||a.country.localeCompare(b.country,'en'));
const geographicGroups=groupCountries(countryEntries);
// One representative marker per country, weighted toward documented institutions.
// Compute a spherical mean so positions remain stable even near the date line.
const countryMarkers = countryEntries.map(({country,cities,entries}) => {
  const located = cities.flatMap(({city,entries:cityEntries}) => {
    const known = cityMeta[city];
    const custom = cityEntries.find(entry => entry.data.longitude !== undefined && entry.data.latitude !== undefined);
    const lon = custom?.data.longitude ?? known?.lon;
    const lat = custom?.data.latitude ?? known?.lat;
    return Number.isFinite(lon) && Number.isFinite(lat)
      ? [{lon,lat,count:cityEntries.length}] : [];
  });
  const avg = located.reduce((a,p) => {
    const lon=p.lon*Math.PI/180,lat=p.lat*Math.PI/180;
    a.x+=Math.sin(lon)*Math.cos(lat)*p.count;
    a.y+=Math.sin(lat)*p.count;
    a.z+=Math.cos(lon)*Math.cos(lat)*p.count;
    return a;
  },{x:0,y:0,z:0});
  return {country,lon:Math.atan2(avg.x,avg.z)*180/Math.PI,
    lat:Math.atan2(avg.y,Math.hypot(avg.x,avg.z))*180/Math.PI,
    count:entries.length};
}).filter(p=>Number.isFinite(p.lon)&&Number.isFinite(p.lat));
// A city dot represents a city, not an invented street-level institution address.
// When verified institution coordinates are added to the content, those may be rendered separately.
const focusCityMarkers = countryEntries.flatMap(({country,cities}) => cities.map(({city,entries}) => ({
  country,city,lon:cityMeta[city]?.lon,lat:cityMeta[city]?.lat,count:entries.length
})).filter(p=>Number.isFinite(p.lon)&&Number.isFinite(p.lat)));
const preciseInstitutionMarkers=countryEntries.flatMap(({country,entries})=>entries
  .filter(item=>item.data.longitude!==undefined&&item.data.latitude!==undefined&&item.data.locationType!=='variable')
  .map(item=>({country,city:item.data.city,name:institutionListNames(item.data,item.id).display,id:item.id,lon:item.data.longitude,lat:item.data.latitude})));
const locationTypes=countryEntries.flatMap(({country,entries})=>entries
  .filter(item=>item.data.locationType==='variable')
  .map(item=>({country,name:institutionListNames(item.data,item.id).display,id:item.id,city:item.data.city})));
const unmapped = items.filter(item => !item.data.city || !cityMeta[item.data.city]?.country);
---
<Base title="Institutions & Spaces | murmurgrove" description="Explore the museums, galleries and other spaces documented in the murmurgrove research archive, organized by geography.">
  <section class="archive institutions-page">
    <h1 class="sr-only">Institutions &amp; Spaces</h1>

    <section class="world-map-section" aria-label="Explore institution locations">
      <div class="map-heading"><span class="map-heading-meta">{countryEntries.length} countries · {items.length} entries</span></div>
      <div class="globe-index-layout">
      <!-- Mobile uses a resilient 2D land silhouette instead of alpha WebGL.
           It shares the existing country filter state, without touching desktop. -->
      <div class="mobile-land-atlas" id="mobile-land-atlas" aria-label="Interactive geographic overview">
        <div class="mobile-land-atlas-graphic" id="mobile-land-atlas-graphic">
          <img class="mobile-land-atlas-silhouette" src="/mobile-institutions-land.png" alt="" aria-hidden="true" width="1600" height="800" loading="eager" decoding="async" />
          <button type="button" class="mobile-land-atlas-tap" id="mobile-land-atlas-tap" aria-label="Select the nearest archived country on the map"></button>
          <div class="mobile-land-atlas-selection" id="mobile-land-atlas-selection" hidden aria-hidden="true">
            <span class="mobile-land-atlas-halo"></span>
          </div>
        </div>
      </div>
      <div class="map-shell" id="institution-map-shell">
        <div class="globe-zoom-controls" id="globe-zoom-controls" hidden aria-label="Focused map zoom">
          <button type="button" data-map-action="zoom-out" aria-label="Zoom out" title="Zoom out">−</button>
          <button type="button" data-map-action="zoom-in" aria-label="Zoom in" title="Zoom in">+</button>
        </div>
        <div class="world-map" id="institution-world-map" role="group" aria-label="Rotatable geographic globe. Click a glowing country point or choose a country from the index to enlarge its region and reveal recorded cities." tabindex="0">
          <canvas class="globe-canvas" id="institution-globe" aria-hidden="true"></canvas>
          <canvas class="globe-dots" id="institution-dots" aria-hidden="true"></canvas>
          <script id="globe-city-data" type="application/json" set:html={JSON.stringify(countryMarkers).replaceAll("<", "\\u003c")} />
          <script id="globe-focus-city-data" type="application/json" set:html={JSON.stringify(focusCityMarkers).replaceAll('<', "\\u003c")} />
          <script id="globe-site-data" type="application/json" set:html={JSON.stringify(preciseInstitutionMarkers).replaceAll('<','\\u003c')} />
          <script id="globe-variable-data" type="application/json" set:html={JSON.stringify(locationTypes).replaceAll('<','\\u003c')} />
          <div class="globe-loading" id="globe-loading">Preparing globe…</div>
        </div>
        <div class="map-tooltip" id="institution-map-tooltip" hidden aria-live="polite"></div>
        <div id="institution-map-details" hidden>
          {countryEntries.map(({country,cities,entries}) => (
            <section data-country-details={country}>
              <div class="map-popup-country">{country}<span>{entries.length}</span></div><p class="map-location-precision">City dots show approximate city centres, not individual venue addresses.</p>
              <div class="map-popup-groups">
                {cities.map(({city,entries}) => (
                  <section class="map-popup-group">
                    <h3>{city}</h3>
                    <ul>{entries.map(item=><li><a href={`/institutions/${item.id}/`}>{institutionListNames(item.data,item.id).display}</a></li>)}</ul>
                  </section>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <aside class="geo-index" aria-label="Browse institutions by location">
        <p class="mobile-geo-hint">Dots · archived countries</p>
        <button type="button" class="geo-all-button is-active" data-jump-country="all" aria-pressed="true">All <span>{items.length}</span></button>
        {geographicGroups.map(({region,entries:regionEntries})=>(
          <div class="geo-index-group"><h2>{region}</h2>
            {regionEntries.map(({country,cities,entries})=>(
              <div class="geo-country"><button type="button" class="geo-country-button" data-jump-country={country} aria-pressed="false"><span>{country}</span><small>{entries.length}</small></button><p>{cities.map(c=>c.city).join(' · ')}</p></div>
            ))}
          </div>
        ))}
        {unmapped.length>0&&(
          <div class="geo-index-group"><h2>Unclassified</h2>
            <div class="geo-country"><button type="button" class="geo-country-button" data-jump-country="unmapped" aria-pressed="false"><span>Location not yet specified</span><small>{unmapped.length}</small></button></div>
          </div>
        )}
      </aside>
      </div>
    </section>

    <label class="sr-only" for="institution-search">Find an institution</label>
    <input id="institution-search" type="search" placeholder="Find an institution" autocomplete="off" />
    <p class="institution-search-count" id="institution-filter-count" role="status" aria-live="polite">{items.length} institutions</p>
    <div class="institution-geography-index">
      {countryEntries.map(({country,cities,entries}) => (
        <section class="institution-country-group" data-institution-group={country} aria-label={`${country} institutions`}>
          <header class="institution-country-header">
            <h2>{country}</h2>
            
          </header>
          <div class="institution-country-cities">
            {cities.map(({city,entries:cityEntries}) => (
              <section class="institution-city-group" aria-label={`${city} institutions`}>
                <h3>{city}</h3>
                <ul class="institution-city-list">
                  {cityEntries.map(item => <li data-name-terms={[...institutionListNames(item.data,item.id).terms,item.data.venueName||''].join(' ')}><a href={`/institutions/${item.id}/`}>{institutionListNames(item.data,item.id).display}{institutionListNames(item.data,item.id).related && <small class="institution-related-title">{institutionListNames(item.data,item.id).related}</small>}</a></li>)}
                </ul>
              </section>
            ))}
          </div>
        </section>
      ))}
      {unmapped.length > 0 && (
        <section class="institution-country-group" data-institution-group="unmapped" aria-label="Unclassified institutions">
          <header class="institution-country-header"><h2>Location not yet specified</h2></header>
          <ul class="institution-city-list institution-ungrouped-list">
            {unmapped.map(item => <li data-name-terms={[...institutionListNames(item.data,item.id).terms,item.data.venueName||''].join(' ')}><a href={`/institutions/${item.id}/`}>{institutionListNames(item.data,item.id).display}{institutionListNames(item.data,item.id).related && <small class="institution-related-title">{institutionListNames(item.data,item.id).related}</small>}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </section>
</Base>

<style>
  /* murmurgrove geographic index: one map plane, one text grid, no nested cards. */
  .institutions-page { position:relative; isolation:auto; }
  .world-map-section { position:relative; margin:0; min-height:0; }
  .institutions-page.archive { padding-top:clamp(12px,1.6vw,22px); }
  .map-heading { display:none; }
  .globe-index-layout { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr); gap:clamp(20px,3.6vw,64px); min-height:max(550px,calc(100dvh - 160px)); align-items:center; position:relative; }
  /* The canvas starts at the actual browser edge, *behind* the header, and stops before the institution list. */
  .map-shell { position:absolute; inset:auto; top:calc(-1 * var(--globe-page-overlap, 145px)); left:calc(50% - 50vw); width:100vw; height:calc(100% + var(--globe-page-overlap, 145px)); z-index:0; background:transparent; pointer-events:none; }
  .world-map { position:absolute; inset:0; width:100%; height:100%; overflow:hidden; background:transparent; cursor:grab; touch-action:none; outline-offset:-6px; user-select:none; -webkit-user-select:none; pointer-events:auto; }
  .world-map.is-dragging { cursor:grabbing; }
  .world-map.is-country-target:not(.is-dragging) {cursor:pointer;}
  .globe-canvas,.globe-dots { position:absolute; inset:0; width:100%; height:100%; display:block; pointer-events:none; }
  .globe-loading { position:absolute; inset:0; display:flex; justify-content:center; align-items:center; color:#789084; font-size:.75rem; pointer-events:none; }
  .globe-loading[hidden] {display:none}
  .geo-index { grid-column:2; position:relative; z-index:3; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem 1.35rem; padding:16px 0 22px 8px; background:transparent; align-content:center; }
  .geo-index-kicker {grid-column:1/-1; font-size:.66rem; letter-spacing:.14em; color:#799486; margin:0 0 .55rem;}
  .geo-index-group {min-width:0;}
  .geo-index-group h2 {font-size:.95rem;font-weight:500;color:#276148;margin:0 0 .7rem;}
  .geo-country {margin:0 0 .62rem;}
  .geo-country-button {width:100%; display:flex; justify-content:space-between; gap:8px; padding:.2rem 0; border:0; background:none; color:#254838; font:inherit; cursor:pointer; text-align:left; align-items:baseline;}
  .geo-country-button span {font-size:.81rem;}
  .geo-country-button small {font-size:.68rem; color:#86a096;}
  .geo-country-button:hover span,.geo-country-button:focus-visible span {text-decoration:underline;text-underline-offset:3px;}
  .geo-country-button.is-active span,.geo-all-button.is-active{color:#087b55;font-weight:600;}
  .geo-country p {font-size:.65rem;color:#789588;line-height:1.43;margin:0;}
  .geo-all-button {grid-column:1/-1;display:flex;justify-content:space-between;gap:10px;width:100%;border:0;background:none;text-align:left;padding:.3rem 0;margin:0 0 1rem;color:#275840;font:inherit;font-size:.95rem;cursor:pointer;}
  .geo-all-button span{color:#779587;font-size:.72rem;}
  .geo-index button:focus-visible {outline:2px solid #67b58e;outline-offset:2px;}
  .map-tooltip {position:absolute; top:calc(var(--globe-page-overlap,145px) + 62px); left:clamp(20px,9vw,165px); z-index:7; width:min(335px,35vw); max-height:min(420px,53vh); overflow:auto; background:rgba(255,255,255,.58); border:1px solid rgba(93,156,126,.28); box-shadow:0 10px 26px rgba(25,79,51,.065); -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);padding:14px 17px;scrollbar-width:thin;color:#174833;pointer-events:auto;}
  .map-tooltip[hidden],#institution-map-details[hidden]{display:none;}
  .map-popup-country {display:flex;justify-content:space-between;gap:1rem;font-size:.91rem;font-weight:600;color:#175d44;margin-bottom:.55rem;}
  .map-popup-country span {color:#779587;font-weight:400;}
  .map-location-precision{font-size:.69rem;color:#779587;line-height:1.5;margin:0 0 .8rem;}
  .map-popup-group{margin-bottom:.8rem;}
  .map-popup-group h3{font-size:.76rem;letter-spacing:.09em;color:#688677;margin:0 0 .25rem;}
  .map-popup-group ul {list-style:none;margin:0;padding:0;}
  .map-popup-group li+li{border-top:1px solid rgba(117,153,134,.16);}
  .map-popup-group li a,.cluster-city-link{display:block;padding:.42rem 0;font-size:.82rem;line-height:1.45;color:#244d39;text-decoration:none;}
  .map-popup-group li a:hover,.cluster-city-link:hover{text-decoration:underline;text-underline-offset:3px;}
  .cluster-city-link{background:none;border:0;text-align:left;cursor:pointer;}
  .globe-zoom-controls{position:absolute;top:calc(var(--globe-page-overlap, 145px) + 10px);left:max(42px, calc((100vw - 1280px) / 2 + 42px));z-index:8;display:flex;gap:4px;align-items:center;pointer-events:auto;}
  .globe-zoom-controls[hidden]{display:none;}
  .globe-zoom-controls button{width:36px;height:36px;padding:0;border:0;border-radius:50%;background:transparent;color:#26674c;font:400 22px/1 system-ui,sans-serif;cursor:pointer;display:grid;place-items:center;transition:color .18s ease,transform .18s ease;}
  .globe-zoom-controls button:hover{color:#0b8a58;transform:scale(1.13);}
  .globe-zoom-controls button:focus-visible{outline:1px solid #5b9776;outline-offset:-3px;}
  /* The white list is a clean continuation: country | city | three institution names. */
  .institution-filter-count {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;}
  .institution-geography-index{position:relative;z-index:2;background:#fff;padding-top:28px;}
  /* One continuous full-viewport line separates the spatial index from the archive list. */
  .institution-geography-index::before{content:"";position:absolute;top:0;left:50%;width:100vw;transform:translateX(-50%);border-top:1px solid #d6e5da;pointer-events:none;}
  .institution-country-group:first-child{border-top:0;}
  .institution-country-group[hidden]{display:none!important;}
  .institution-country-group{display:grid;grid-template-columns:clamp(155px,13.2vw,190px) minmax(0,1fr);gap:clamp(12px,1.8vw,26px);padding:22px 0 24px;border-top:0;}
  .institution-country-header{margin:0;min-width:0;}
  .institution-country-header h2{font-size:clamp(17px,1.38vw,21px);font-weight:400;line-height:1.4;letter-spacing:-.01em;margin:0;white-space:nowrap;}
  .institution-country-cities{min-width:0;}
  .institution-city-group{display:grid;grid-template-columns:clamp(82px,8vw,113px) minmax(0,1fr);gap:12px;padding:4px 0 13px;}
  .institution-city-group+.institution-city-group{border-top:1px solid #edf2ee;padding-top:15px;}
  .institution-city-group h3{font-size:.76rem;line-height:1.5;font-weight:500;color:#6c8a7b;margin:4px 0 0;}
  .institution-city-list{min-width:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 17px;margin:0;padding:0;}
  .institution-city-list li{min-width:0;padding:0;margin:0;}
  .institution-city-list a{display:block;font-size:clamp(13px,1.08vw,16px);line-height:1.47;letter-spacing:-.012em;overflow-wrap:anywhere;color:var(--ink);background:transparent;border:0;padding:2px 0;}
  .institution-related-title{display:block;font-size:.68em;color:#879f8f;font-weight:400;margin-top:3px;line-height:1.4;}
  .institution-city-list a:hover,.institution-city-list a:focus-visible{text-decoration:underline;text-underline-offset:4px;color:#056848;}
  .institution-ungrouped-list{grid-column:2;}
  @media(max-width:1070px){.globe-index-layout{grid-template-columns:minmax(0,1fr) minmax(310px,.95fr)}.institution-city-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.globe-index-layout{display:flex;flex-direction:column;align-items:stretch;gap:5px;min-height:0;}.map-shell{position:relative;left:calc(50% - 50vw);top:auto;width:100vw;height:clamp(300px,80vw,450px);}.world-map{position:relative;height:100%;}.geo-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:14px 0 10px;}.map-tooltip{position:absolute;top:14px;left:14px;width:min(320px,calc(100% - 28px));max-height:280px;}.globe-zoom-controls{top:10px;left:12px;}.institution-country-group{grid-template-columns:1fr;gap:12px;}.institution-country-header h2{white-space:normal;}.institution-city-group{grid-template-columns:100px minmax(0,1fr);}.institution-city-list{grid-template-columns:repeat(2,minmax(0,1fr));}}
  @media(max-width:480px){.institution-geography-index{padding-top:18px}.institution-city-group{grid-template-columns:1fr;gap:7px}.institution-city-list{grid-template-columns:1fr 1fr;gap:12px}.institution-city-list a{font-size:13px}}
  @media(prefers-reduced-motion:reduce){.world-map{scroll-behavior:auto}}

  /* Mobile redesign: preserve the geographic explorer, but turn it into a compact card
     with quick country chips and a lighter institution list. Desktop remains unchanged. */
  .mobile-geo-hint{display:none;}
  .mobile-land-atlas{display:none;}
  @media(max-width:650px){
    /* A compact flat geographic field. Transparent sea; reliably visible land. */
    .institutions-page .mobile-land-atlas{display:block;position:relative;width:100%;margin:3px 0 22px;}
    .institutions-page .mobile-land-atlas-graphic{position:relative;width:100%;aspect-ratio:2/1;min-height:155px;max-height:235px;overflow:hidden;background:transparent;}
    .institutions-page .mobile-land-atlas-silhouette{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:fill;opacity:1;pointer-events:none;user-select:none;-webkit-user-drag:none;}
    .institutions-page .mobile-land-atlas-tap{position:absolute;inset:0;border:0;background:transparent;padding:0;cursor:crosshair;width:100%;height:100%;}
    .institutions-page .mobile-land-atlas-tap:focus-visible{outline:2px solid #0d8e61;outline-offset:-3px;}
    /* An atmospheric location emphasis, not a pin or a repeated country name.
       Its centre is anchored inside the image, so it cannot be clipped at the top. */
    .institutions-page .mobile-land-atlas-selection{position:absolute;left:var(--atlas-x,50%);top:var(--atlas-y,50%);width:64px;height:64px;transform:translate(-50%,-50%);display:grid;place-items:center;pointer-events:none;z-index:2;}
    .institutions-page .mobile-land-atlas-selection[hidden]{display:none;}
    .institutions-page .mobile-land-atlas-halo{display:block;width:100%;height:100%;border-radius:50%;background:radial-gradient(circle,rgba(19,123,83,.30) 0%,rgba(40,155,105,.20) 22%,rgba(64,166,116,.09) 51%,rgba(64,166,116,0) 75%);border:0;box-shadow:none;}
    @media(max-width:360px){.institutions-page .mobile-land-atlas-selection{width:56px;height:56px;}}
    /* The WebGL globe is still kept intact for the desktop experience. */
    .institutions-page .map-shell{display:none !important;}
    .institutions-page .mobile-geo-hint{display:none;}
    .institutions-page .geo-index-kicker{margin-bottom:7px;}
  }
  @media(max-width:650px){
    .institutions-page .map-heading{display:none;}
    .institutions-page .globe-index-layout{display:block;min-height:0;}
    .institutions-page .map-shell{display:none !important;position:relative;left:auto;top:auto;width:100%;height:clamp(315px,92vw,425px);margin:0 0 2px;border:0;border-radius:0;overflow:hidden;background:transparent;pointer-events:auto;}
    .institutions-page .world-map{position:relative;inset:0;height:100%;cursor:grab;touch-action:pan-y;}
    .institutions-page .world-map:active{cursor:grabbing;}
    .institutions-page .globe-canvas,.institutions-page .globe-dots{position:absolute;inset:0;width:100%;height:100%;}
    .institutions-page .globe-loading{font-size:11px;}
    .institutions-page .globe-zoom-controls{display:none !important;}
    .institutions-page .map-tooltip{top:12px;left:12px;width:min(300px,calc(100% - 24px));max-height:min(170px,calc(100% - 24px));padding:12px 13px;background:rgba(255,255,255,.82);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(93,156,126,.22);box-shadow:0 10px 26px rgba(25,79,51,.08);}
    .institutions-page .map-popup-country{font-size:13px;margin-bottom:.45rem;}
    .institutions-page .map-location-precision{display:none;}
    .institutions-page .map-popup-group{margin-bottom:.55rem;}
