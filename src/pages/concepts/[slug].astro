---
import ArchiveProfile from "../../components/ArchiveProfile.astro";
import ArchiveSources from "../../components/ArchiveSources.astro";
import {archiveDay,engagementLabel} from '../../lib/exhibition-engagement.mjs';
import Base from '../../layouts/Base.astro';
import OrganismLink from '../../components/OrganismLink.astro';
import ResearchContinuity from '../../components/ResearchContinuity.astro';
import { getCollection, render } from 'astro:content';
import {conceptRevisionTimeline} from '../../../murmurgrove-editor/research-continuity.mjs';
import {currentExhibitionIds,currentConcept,canonicalConceptId} from '../../lib/current-research.mjs';
export async function getStaticPaths(){return (await getCollection('concepts')).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const {Content}=await render(item);
const memory=currentConcept(item.id);
const conceptHistory=await conceptRevisionTimeline(process.cwd(),item.id);
const canonical=memory?.mergedInto?(await getCollection('concepts')).find(c=>c.id===canonicalConceptId(item.id)):null;
const relatedIds=currentExhibitionIds('concepts:'+item.id);
const exhibitions=(await getCollection('exhibitions')).filter(e=>relatedIds.has(e.id)).sort((a,b)=>archiveDay(b.data).localeCompare(archiveDay(a.data)));
---
<Base title={`${item.data.title} | murmurgrove`} description={`Explore ${item.data.title} and related exhibitions in the murmurgrove research archive.`}><article class="article"><nav class="record-nav" aria-label="Record navigation"><a class="eyebrow" href="/concepts/">← Themes & Concepts</a><OrganismLink path={`/concepts/${item.id}/`}/></nav><h1>{item.data.title}</h1><ArchiveProfile data={item.data} type="concepts"/><div class="prose"><Content/></div><ArchiveSources sources={item.data.sources}/>{canonical && <p class="note">Earlier concept record · current classification: <a href={`/concepts/${canonical.id}/`}>{canonical.data.title}</a></p>}{memory && !canonical && <section class="concept-memory">{memory.aliases?.length>0 && <p class="note">{memory.aliases.join(' · ')}</p>}{[['Definition',memory.definition],['Interpretation',memory.interpretation],['Development',memory.development]].filter(([,value])=>value?.trim()).map(([label,value])=><section><h2>{label}</h2><p>{value}</p></section>)}{memory.updatedAt && <p class="note">Current reading · {memory.updatedAt.slice(0,10)}{memory.status==='provisional'?' · provisional':''}</p>}</section>}{exhibitions.length>0 && <section><h2>Related exhibitions &amp; events</h2><ol class="archive-list">{exhibitions.map(e=><li class="archive-entry"><time>{archiveDay(e.data)}</time><a href={`/exhibitions/${e.id}/`}>{e.data.title}</a></li>)}</ol></section>}{conceptHistory.length>1 && <details class="concept-memory-history"><summary>Concept development history</summary>{conceptHistory.map(r=><p class="note"><time datetime={r.at}>{r.at.slice(0,10)}</time> · {r.kind}</p>)}</details>}<ResearchContinuity type="concepts" id={item.id}/></article></Base>

<style>.concept-memory-history{margin:28px 0}.concept-memory-history summary{cursor:pointer;color:var(--quiet);font-size:13px}.concept-memory h2{font-size:18px;font-weight:400;margin:28px 0 10px}.concept-memory p{white-space:pre-wrap;line-height:1.8;overflow-wrap:anywhere}</style>
