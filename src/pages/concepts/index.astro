---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('concepts')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const exhibitions = await getCollection('exhibitions');
const frequency = new Map(items.map(item => [item.id, 0]));
const connections = new Map<string, number>();
for (const e of exhibitions) {
  const concepts = [...new Set(e.data.concepts)].filter(id => frequency.has(id));
  concepts.forEach(id => frequency.set(id, (frequency.get(id) ?? 0) + 1));
  for(let i=0; i<concepts.length; i++) for(let j=i+1; j<concepts.length; j++) {
    const [a,b] = [concepts[i], concepts[j]].sort();
    const key = `${a}|${b}`;
    connections.set(key, (connections.get(key) ?? 0) + 1);
  }
}
const locations:Record<string,[number,number]> = {
 'institutional-studies':[550,305], 'curatorial-practices':[290,170],
 'site-specificity':[285,410], 'transcultural-studies':[795,175],
 'politics-of-representation':[795,345], 'artist-residency':[535,75],
 'collective-practices':[365,65], 'performance':[118,270],
 'photography':[945,95], 'identity-and-representation':[965,255],
 'memory-and-place':[155,505], 'material-and-memory':[365,550],
 'sound-and-technology':[145,100], 'technology-and-body':[975,460],
 'ecology':[540,505], 'care-and-design':[290,285],
 'postwar-art':[760,540], 'printmaking':[970,565],
 'moving-image':[110,405],
};
let extra = 0;
const translations:Record<string,{en:string,ja:string}> = {
  'institutional-studies': {en:'Institutional Studies',ja:'制度・機関研究'},
  'curatorial-practices': {en:'Curatorial Practices',ja:'キュレーション実践'},
  'site-specificity': {en:'Site-Specificity',ja:'サイト・スペシフィシティ'},
  'transcultural-studies': {en:'Transcultural Studies',ja:'トランスカルチュラル研究'},
  'politics-of-representation': {en:'Politics of Representation',ja:'表象の政治'},
  'artist-residency': {en:'Artist Residency',ja:'アーティスト・イン・レジデンス'},
  'collective-practices': {en:'Collective Practices',ja:'コレクティブの実践'},
  'performance': {en:'Performance & Theatre',ja:'パフォーマンスと演劇'},
  'photography': {en:'Photography',ja:'写真'},
  'identity-and-representation': {en:'Identity & Representation',ja:'アイデンティティと表象'},
  'memory-and-place': {en:'Memory & Place',ja:'記憶と場所'},
  'material-and-memory': {en:'Material & Memory',ja:'素材と記憶'},
  'sound-and-technology': {en:'Sound & Technology',ja:'音とテクノロジー'},
  'technology-and-body': {en:'Technology & Body',ja:'テクノロジーと身体'},
  'ecology': {en:'Ecology & Resources',ja:'エコロジーと資源'},
  'care-and-design': {en:'Care & Design',ja:'ケアとデザイン'},
  'postwar-art': {en:'Postwar Art',ja:'戦後美術'},
  'printmaking': {en:'Printmaking',ja:'版画'},
  'moving-image': {en:'Moving Image',ja:'映像表現'},
};
const nodes = items.map(item => {
 const position = locations[item.id] ?? [130 + (extra % 5)*205, 620 + Math.floor(extra++/5)*105];
 return {id:item.id, title:item.data.title, en:translations[item.id]?.en ?? item.id.replaceAll('-',' '), ja:translations[item.id]?.ja ?? item.data.title, x:position[0], y:position[1], count:frequency.get(item.id) ?? 0};
});
const positionById = new Map(nodes.map(node=>[node.id,node]));
const edges = [...connections].map(([key,count])=>{
 const [a,b] = key.split('|');
 return {a,b,count,from:positionById.get(a),to:positionById.get(b)};
}).filter(edge => edge.from && edge.to);
const maxY = Math.max(620, ...nodes.map(node=>node.y+55));
const mobileOrder = [
 'institutional-studies', 'curatorial-practices',
 'site-specificity', 'transcultural-studies',
 'politics-of-representation', 'identity-and-representation',
 'artist-residency', 'collective-practices',
 'memory-and-place', 'material-and-memory',
 'ecology', 'care-and-design',
 'performance', 'moving-image',
 'photography', 'postwar-art',
 'sound-and-technology', 'technology-and-body',
 'printmaking',
];
const nodeById = new Map(nodes.map(node => [node.id,node]));
const mobileSorted = [...mobileOrder.map(id=>nodeById.get(id)).filter(Boolean), ...nodes.filter(node=>!mobileOrder.includes(node.id))];
const mobileFieldLayout:Record<string,[number,number,number,number]> = {
  'collective-practices':[18,11,12,10],
  'institutional-studies':[52,10,18,13],
  'curatorial-practices':[82,14,12,10],
  'sound-and-technology':[18,24,14,13],
  'artist-residency':[51,24,16,11],
  'transcultural-studies':[83,27,13,14],
  'performance':[17,39,15,13],
  'care-and-design':[54,38,16,11],
  'identity-and-representation':[84,40,14,13],
  'moving-image':[19,54,15,12],
  'politics-of-representation':[51,53,17,12],
  'photography':[81,56,14,12],
  'site-specificity':[20,69,16,13],
  'ecology':[52,68,18,12],
  'technology-and-body':[82,71,14,13],
  'memory-and-place':[18,84,15,11],
  'material-and-memory':[50,84,15,11],
  'postwar-art':[81,87,13,10],
  'printmaking':[48,95,13,10],
};
const mobileFieldNodes = mobileSorted.map((node, index) => {
  const fallbackX = index % 3 === 0 ? 18 : index % 3 === 1 ? 50 : 82;
  const fallbackY = 12 + Math.floor(index / 3) * 12.5;
  const [mx,my,ampX,ampY] = mobileFieldLayout[node.id] ?? [fallbackX, fallbackY, 13, 10];
  return {...node, mx, my, ampX, ampY, drift:index % 7};
});
const mobileEdges = edges.map(edge => ({a:edge.a,b:edge.b,count:edge.count}));
---
<Base title="Themes & Concepts | TOW ARCHIVE">
  <section class="archive concept-archive">
    <h1 class="sr-only">Themes &amp; Concepts</h1>
    <div class="concept-map-scroll" aria-label="Concept network">
      <svg class="concept-map concept-map-desktop" viewBox={`0 0 1120 ${maxY}`} role="group" aria-label="Interactive concept network" xmlns="http://www.w3.org/2000/svg">
        <g class="concept-links" aria-hidden="true">
          {edges.map(edge=><line class="concept-link" data-a={edge.a} data-b={edge.b} x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} stroke-width={Math.min(2.2, .65 + .55*edge.count)}/>) }
        </g>
        <g class="concept-nodes">
          {nodes.map(node=><a class="concept-node" href={`/concepts/${node.id}/`} data-concept={node.id} data-x={node.x} data-y={node.y} aria-label={`${node.title} / ${node.en} / ${node.ja}`}>
            <circle cx={node.x} cy={node.y} r="3.2" />
            <text x={node.x>=900?node.x-10:node.x+10} y={node.y+5} text-anchor={node.x>=900?'end':'start'} class={node.count>=5?'concept-term concept-term-major concept-cycle':'concept-term concept-cycle'} data-zh={node.title} data-en={node.en} data-ja={node.ja}>{node.title}</text>
          </a>)}
        </g>
      </svg>

      <div class="concept-mobile-explorer" aria-label="Mobile concept field">
        <div class="concept-mobile-stage-shell">
          <div class="concept-mobile-stage-head">
            <p>CONCEPT FIELD</p>
            <span>Tap any moving term to open its page</span>
          </div>
          <script type="application/json" id="concept-mobile-edge-data">{JSON.stringify(mobileEdges)}</script>
          <div class="concept-mobile-stage" id="concept-mobile-stage">
            <svg class="concept-mobile-links" id="concept-mobile-links" aria-hidden="true"></svg>
            {mobileFieldNodes.map((node) => (
              <a
                href={`/concepts/${node.id}/`}
                class="concept-mobile-orbit concept-cycle"
                data-concept={node.id}
                data-zh={node.title}
                data-en={node.en}
                data-ja={node.ja}
                data-base-x={node.mx}
                data-base-y={node.my}
                data-amp-x={node.ampX}
                data-amp-y={node.ampY}
                data-drift={node.drift}
                style={`--x:${node.mx}%;--y:${node.my}%;--weight:${node.count >= 5 ? 1 : 0};`}
              >{node.title}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
    <p class="concept-note">Lines connect concepts tagged in the same exhibition. Larger words appear more frequently in the archive. Select a term to open its page.</p>
  </section>
</Base>
<style>
  .concept-archive { min-height:70vh; }
  .concept-map-scroll { width:100%; overflow:hidden; border-bottom:1px solid var(--rule); }
  .concept-map { display:block; width:100%; height:auto; overflow:visible; }
  .concept-map-desktop { display:none; min-width:0; }
  .concept-link { stroke:var(--ink); opacity:.18; vector-effect:non-scaling-stroke; transition:opacity .16s ease; }
  .concept-node { color:var(--ink); text-decoration:none; outline:none; }
  .concept-node circle { fill:var(--ink); opacity:.55; }
  .concept-term { fill:var(--ink); font-family:inherit; font-weight:400; font-size:15px; letter-spacing:-.025em; }
  .concept-term-major { font-size:17px; }
  .concept-node:hover .concept-term, .concept-node:focus-visible .concept-term { fill:#005b3b; text-decoration:underline; stroke:none; paint-order:normal; }
  .concept-node:focus-visible .concept-term { text-decoration:underline; }
  .concept-node:hover circle, .concept-node:focus-visible circle { opacity:1; r:5; }
  .concept-link.is-related { opacity:.63; }
  .concept-link.is-muted { opacity:.06; }
  .concept-note { color:var(--quiet); font-size:12px; line-height:1.7; margin:16px 0 0; }

  .concept-mobile-explorer{display:none;}
  .concept-mobile-stage-shell{border-bottom:1px solid var(--rule);padding:4px 0 18px;margin-bottom:8px;}
  .concept-mobile-stage-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;margin:0 0 12px;}
  .concept-mobile-stage-head p{margin:0;font-size:10px;letter-spacing:.12em;color:#7b9788;}
  .concept-mobile-stage-head span{display:block;max-width:22ch;color:var(--quiet);font-size:11px;line-height:1.5;text-align:right;}
  .concept-mobile-stage{position:relative;height:1180px;border:0;border-radius:0;background:radial-gradient(ellipse 55% 35% at 26% 24%,rgba(173,215,188,.11),transparent 100%),radial-gradient(ellipse 47% 39% at 76% 62%,rgba(150,211,174,.1),transparent 100%);overflow:hidden;}
  .concept-mobile-stage::before{content:"";position:absolute;inset:8px;background:radial-gradient(ellipse at 50% 50%,rgba(154,207,169,.03),transparent 72%);pointer-events:none;}
  .concept-mobile-links{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:0;}
  .concept-mobile-links line{stroke:rgba(41,117,79,.14);stroke-width:1.1;vector-effect:non-scaling-stroke;}
  .concept-mobile-orbit{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);display:block;border:0;background:none;color:var(--ink);font-family:inherit;font-weight:400;font-size:clamp(19px,5.6vw,24px);line-height:1.28;letter-spacing:-.022em;padding:8px 5px;border-radius:10px;cursor:pointer;width:40%;max-width:40%;text-align:center;text-decoration:none;overflow-wrap:anywhere;opacity:.96;z-index:1;touch-action:manipulation;will-change:transform,left,top;}
  .concept-mobile-orbit[style*="--weight:1"]{font-weight:500;}
  .concept-mobile-orbit:hover,.concept-mobile-orbit:focus-visible{text-decoration:underline;text-underline-offset:4px;}
  .concept-mobile-orbit:focus-visible{outline:2px solid #0d8e61;outline-offset:2px;}

  @media(min-width:901px){
    .concept-map-desktop{display:block}
    .concept-mobile-explorer{display:none}
  }
  @media(max-width:900px){
    .concept-archive{min-height:0}
    .concept-map-scroll{overflow:visible}
    .concept-mobile-explorer{display:block}
    .concept-archive .concept-note{display:none;}
  }
  @media(max-width:650px){
    .concept-mobile-stage{height:1180px;}
  }
  @media(max-width:380px){
    .concept-mobile-stage{height:1260px;}
    .concept-mobile-orbit{font-size:clamp(18px,5.2vw,21px);width:40%;max-width:40%;padding:7px 4px;}
  }

  .concept-node{will-change:transform;transition:opacity .2s ease}
  .concept-map-desktop{user-select:none}
  .concept-cycle{opacity:1;transition:opacity .32s ease;}
  .concept-cycle.is-changing{opacity:.08;}
  @media(prefers-reduced-motion:reduce){ .concept-link { transition:none; } .concept-cycle{transition:none!important;} }
</style>
<script>
  const reducedLanguages=window.matchMedia('(prefers-reduced-motion: reduce)');
  const languageNodes=Array.from(document.querySelectorAll<SVGTextElement|HTMLElement>('.concept-cycle'));
  type CyclingLabel={el:SVGTextElement|HTMLElement; words:string[];current:number;changing:boolean;switchAt:number;next:number};
  const seededRandom=(seed:number)=>{
    let n=seed>>>0;
    return ()=>{n=(Math.imul(n,1664525)+1013904223)>>>0;return n/4294967296;};
  };
  const rng=seededRandom(1172026);
  const labels:CyclingLabel[]=languageNodes.map((el,i)=>{
    const words=[el.dataset.zh||'',el.dataset.en||'',el.dataset.ja||''];
    const current=(i*7+Math.floor(i/3))%3;
    const next=performance.now()+1300+rng()*4700+i*95;
    el.textContent=words[current];
    el.setAttribute('lang',['zh','en','ja'][current]);
    return {el,words,current,next,changing:false,switchAt:0};
  });
  let labelTimer=0;
  const cycleLabels=()=>{
    if(document.hidden||reducedLanguages.matches)return;
    const now=performance.now();
    for(const label of labels){
      if(!label.changing&&now>=label.next){
        label.changing=true;
        label.switchAt=now+320;
        label.el.classList.add('is-changing');
      }else if(label.changing&&now>=label.switchAt){
        const shift=1+Math.floor(rng()*2);
        label.current=(label.current+shift)%3;
        label.el.textContent=label.words[label.current];
        label.el.setAttribute('lang',['zh','en','ja'][label.current]);
        label.el.classList.remove('is-changing');
        label.changing=false;
        label.next=now+3300+rng()*5800;
      }
    }
  };
  const syncLanguageMotion=()=>{
    window.clearInterval(labelTimer);
    labelTimer=0;
    if(!document.hidden&&!reducedLanguages.matches){
      const now=performance.now();
      for(const label of labels){
        if(label.changing){label.changing=false;label.el.classList.remove('is-changing');}
        if(label.next<now)label.next=now+800+rng()*5300;
      }
      labelTimer=window.setInterval(cycleLabels,80);
    }
  };
  document.addEventListener('visibilitychange',syncLanguageMotion);
  reducedLanguages.addEventListener('change',syncLanguageMotion);
  syncLanguageMotion();

  const mobileStage=document.getElementById('concept-mobile-stage') as HTMLElement | null;
  const mobileLinksSvg=document.getElementById('concept-mobile-links') as SVGSVGElement | null;
  const mobileLinks=Array.from(document.querySelectorAll<HTMLAnchorElement>('.concept-mobile-orbit'));
  const mobileEdgeDataElement=document.getElementById('concept-mobile-edge-data');
  if(mobileStage && mobileLinksSvg && mobileLinks.length && mobileEdgeDataElement){
    const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
    const edges: {a:string,b:string,count:number}[] = JSON.parse(mobileEdgeDataElement.textContent || '[]');
    const nodeMap=new Map(mobileLinks.map((link,index)=>{
      const baseX=Number(link.dataset.baseX||'50');
      const baseY=Number(link.dataset.baseY||'50');
      const ampX=Number(link.dataset.ampX||'12');
      const ampY=Number(link.dataset.ampY||'10');
      const drift=Number(link.dataset.drift||String(index));
      const phase=index*0.91 + drift*0.47;
      const phase2=index*1.31 + drift*0.62;
      const periodX=12200 + (index%5)*1700;
      const periodY=15300 + (index%6)*1500;
      const periodX2=9600 + (index%4)*1200;
      const periodY2=11800 + (index%3)*900;
      return [link.dataset.concept||'', {link, baseX, baseY, ampX, ampY, phase, phase2, periodX, periodY, periodX2, periodY2, x:0, y:0}];
    }));
    const ns='http://www.w3.org/2000/svg';
    const lineEntries=edges.map(edge=>{
      const a=nodeMap.get(edge.a), b=nodeMap.get(edge.b);
      if(!a || !b) return null;
      const line=document.createElementNS(ns,'line');
      line.setAttribute('stroke-width', String(Math.min(1.8, 0.55 + edge.count*0.18)));
      line.setAttribute('opacity', String(Math.min(0.26, 0.08 + edge.count*0.02)));
      mobileLinksSvg.appendChild(line);
      return {a,b,line};
    }).filter(Boolean) as {a:any,b:any,line:SVGLineElement}[];

    const layout=()=>{
      const rect=mobileStage.getBoundingClientRect();
      mobileLinksSvg.setAttribute('viewBox', `0 0 ${rect.width} ${rect.height}`);
      mobileLinksSvg.setAttribute('width', String(rect.width));
      mobileLinksSvg.setAttribute('height', String(rect.height));
    };
    layout();
    let raf=0;
    let start=0;
    const tick=(time:number)=>{
      raf=0;
      if(document.hidden) return;
      if(!start) start=time;
      const t=time-start;
      const rect=mobileStage.getBoundingClientRect();
      const w=rect.width, h=rect.height;
      for(const node of nodeMap.values()){
        const x = (node.baseX/100)*w + Math.sin(t/node.periodX*2*Math.PI + node.phase) * (node.ampX/100*w)
          + Math.sin(t/node.periodX2*2*Math.PI + node.phase2) * (node.ampX/100*w*0.55);
        const y = (node.baseY/100)*h + Math.cos(t/node.periodY*2*Math.PI + node.phase*1.12) * (node.ampY/100*h)
          + Math.sin(t/node.periodY2*2*Math.PI + node.phase2*1.07) * (node.ampY/100*h*0.45);
        node.x=x; node.y=y;
        node.link.style.left=`${x}px`;
        node.link.style.top=`${y}px`;
      }
      for(const entry of lineEntries){
        entry.line.setAttribute('x1', String(entry.a.x));
        entry.line.setAttribute('y1', String(entry.a.y));
        entry.line.setAttribute('x2', String(entry.b.x));
        entry.line.setAttribute('y2', String(entry.b.y));
      }
      if(!reducedMotion.matches) raf=requestAnimationFrame(tick);
    };
    const sync=()=>{
      layout();
      if(reducedMotion.matches){
        for(const node of nodeMap.values()){
          const rect=mobileStage.getBoundingClientRect();
          node.x = (node.baseX/100)*rect.width;
          node.y = (node.baseY/100)*rect.height;
          node.link.style.left=`${node.x}px`;
          node.link.style.top=`${node.y}px`;
        }
        for(const entry of lineEntries){
          entry.line.setAttribute('x1', String(entry.a.x));
          entry.line.setAttribute('y1', String(entry.a.y));
          entry.line.setAttribute('x2', String(entry.b.x));
          entry.line.setAttribute('y2', String(entry.b.y));
        }
        if(raf){cancelAnimationFrame(raf);raf=0;}
      }else if(!raf){
        raf=requestAnimationFrame(tick);
      }
    };
    window.addEventListener('resize', sync, {passive:true});
    reducedMotion.addEventListener('change', sync);
    sync();
  }

  const desktopMap=document.querySelector<SVGSVGElement>('.concept-map-desktop');
  if(desktopMap){
    const nodeEls=Array.from(desktopMap.querySelectorAll<SVGAElement>('.concept-node'));
    const edgeEls=Array.from(desktopMap.querySelectorAll<SVGLineElement>('.concept-link'));
    const nodes=nodeEls.map((el,i)=>({
      el,id:el.dataset.concept||'',x:Number(el.dataset.x),y:Number(el.dataset.y),
      phase:i*2.39996323,
      orbitX:26+(i*11%24),orbitY:18+(i*13%22),
      periodX:24500+(i*3731%15500),periodY:28500+(i*4229%18000),
      dx:0,dy:0,held:false,releaseAt:0,releaseX:0,releaseY:0
    }));
    const byId=new Map(nodes.map(n=>[n.id,n]));
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible=false, raf=0, start=0;
    const updateFocus=(id:string|null)=>{
      for(const edge of edgeEls){
        const related=Boolean(id&&(edge.dataset.a===id||edge.dataset.b===id));
        edge.classList.toggle('is-related',related);
        edge.classList.toggle('is-muted',Boolean(id&&!related));
      }
    };
    for(const n of nodes){
      n.el.addEventListener('pointerenter',()=>{n.held=true;updateFocus(n.id)});
      n.el.addEventListener('pointerleave',()=>{n.held=false;n.releaseAt=performance.now();n.releaseX=n.dx;n.releaseY=n.dy;updateFocus(null)});
      n.el.addEventListener('focus',()=>{n.held=true;updateFocus(n.id)});
      n.el.addEventListener('blur',()=>{n.held=false;n.releaseAt=performance.now();n.releaseX=n.dx;n.releaseY=n.dy;updateFocus(null)});
    }
    const tick=(time:number)=>{
      raf=0;
      if(!visible||document.hidden||reduced.matches)return;
      if(!start)start=time;
      const t=time-start;
      for(const node of nodes){
        if(!node.held){
          const ax=t*2*Math.PI/node.periodX+node.phase;
          const ay=t*2*Math.PI/node.periodY+node.phase*1.23;
          const orbitX=node.orbitX*(.78*Math.sin(ax)+.22*Math.sin(ax*.51+node.phase));
          const orbitY=node.orbitY*(.82*Math.cos(ay)+.18*Math.sin(ay*.63+node.phase));
          const blend=node.releaseAt?Math.min(1,(time-node.releaseAt)/1300):1;
          const ease=blend*blend*(3-2*blend);
          node.dx=node.releaseX*(1-ease)+orbitX*ease;
          node.dy=node.releaseY*(1-ease)+orbitY*ease;
          if(blend>=1)node.releaseAt=0;
        }
        node.el.setAttribute('transform',`translate(${node.dx.toFixed(2)} ${node.dy.toFixed(2)})`);
      }
      for(const edge of edgeEls){
        const a=byId.get(edge.dataset.a||'');const b=byId.get(edge.dataset.b||'');
        if(!a||!b)continue;
        edge.setAttribute('x1',String(a.x+a.dx));edge.setAttribute('y1',String(a.y+a.dy));
        edge.setAttribute('x2',String(b.x+b.dx));edge.setAttribute('y2',String(b.y+b.dy));
      }
      raf=requestAnimationFrame(tick);
    };
    const sync=()=>{
      if(visible&&!document.hidden&&!reduced.matches&&!raf)raf=requestAnimationFrame(tick);
      else if((!visible||document.hidden||reduced.matches)&&raf){cancelAnimationFrame(raf);raf=0;}
    };
    const observer=new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??false;sync()},{threshold:0.05});
    observer.observe(desktopMap);
    document.addEventListener('visibilitychange',sync);
    reduced.addEventListener('change',sync);
  }
</script>
