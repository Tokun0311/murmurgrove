---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('exhibitions')).sort((a,b)=>b.data.visitedOn.valueOf()-a.data.visitedOn.valueOf());
const regions = [...new Set(items.map(x=>x.data.region))].sort((a,b)=>a.localeCompare(b));
const isoDay = (d: Date) => d.toISOString().slice(0,10);
const calendarDates = items.map(item=>isoDay(item.data.visitedOn));
const firstDate = calendarDates.at(-1) || '2026-01-01';
const lastDate = calendarDates[0] || '2026-01-01';
---
<Base title="Exhibitions | murmurgrove" description="Exhibitions and events in murmurgrove, explored by date and region.">
  <section class="archive exhibition-index">
    <h1 class="sr-only">Exhibitions &amp; Events</h1>

    <button class="mobile-calendar-toggle" id="mobile-calendar-toggle" type="button" aria-expanded="false" aria-controls="mobile-calendar-content">Browse by date <span aria-hidden="true">+</span></button>
    <div class="exhibition-date-explorer" id="mobile-calendar-content">
    <section class="exhibition-calendar" aria-label="Browse exhibitions by date">
      <div class="exhibition-calendar-heading">
        <div>
          <div class="exhibition-month-pickers" aria-label="Choose calendar month and year">
            <div class="calendar-picker" data-picker="month">
              <button type="button" class="calendar-picker-trigger" id="calendar-month-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="calendar-month-menu">November <span aria-hidden="true">⌄</span></button>
              <div class="calendar-picker-menu" id="calendar-month-menu" role="listbox" aria-label="Choose month" hidden></div>
            </div>
            <div class="calendar-picker" data-picker="year">
              <button type="button" class="calendar-picker-trigger" id="calendar-year-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="calendar-year-menu">2026 <span aria-hidden="true">⌄</span></button>
              <div class="calendar-picker-menu" id="calendar-year-menu" role="listbox" aria-label="Choose year" hidden></div>
            </div>
            <select class="sr-only" id="exhibition-month-select" tabindex="-1" aria-hidden="true"></select>
            <select class="sr-only" id="exhibition-year-select" tabindex="-1" aria-hidden="true"></select>
          </div>
          <h2 id="exhibition-month-label" class="sr-only" aria-live="polite"></h2>
        </div>
        <div class="exhibition-calendar-controls">
          <button type="button" id="exhibition-prev" aria-label="Previous month">←</button>
          <button type="button" id="exhibition-latest">Latest</button>
          <button type="button" id="exhibition-next" aria-label="Next month">→</button>
        </div>
      </div>
      <div class="exhibition-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
      <div id="exhibition-calendar-grid" class="exhibition-calendar-grid" aria-label="Dates with exhibition records"></div>
      <div class="exhibition-calendar-footer">
        <p id="exhibition-date-status" class="sr-only" role="status" aria-live="polite">Select a marked date to view exhibitions.</p>
        <button id="exhibition-date-clear" type="button" hidden>Clear selection <span aria-hidden="true">×</span></button>
      </div>
    </section>

    <section class="exhibition-day-preview" aria-labelledby="exhibition-preview-heading">
      <div class="exhibition-preview-heading">
        <h2 id="exhibition-preview-heading" aria-live="polite">{lastDate.replaceAll('-', '.')}</h2>
      </div>
      <p id="exhibition-preview-count" class="exhibition-preview-count" aria-live="polite"></p>
      <ol id="exhibition-preview-list" class="exhibition-preview-list">
        {items.map(item=><li class="exhibition-preview-entry" data-preview-date={isoDay(item.data.visitedOn)} hidden>
          <a href={`/exhibitions/${item.id}/`}>{item.data.title}</a>
          <span>{item.data.region}</span>
        </li>)}
      </ol>
      <p id="exhibition-preview-empty" class="exhibition-preview-empty" hidden>Choose a highlighted date in the calendar to see its exhibitions here.</p>
    </section>
    </div>

    <div class="exhibition-index-divider" aria-hidden="true"></div>
    <div class="filters exhibition-filters">
      <div class="filter-languages" aria-label="Region filters">
        <button type="button" data-region="all" aria-pressed="true">All</button>
        {regions.map(r=><button type="button" data-region={r} aria-pressed="false">{r}</button>)}
      </div>
      <label class="sort-label"><span class="sr-only">Sort by visit date</span><select id="date-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label>
    </div>
    <p class="exhibition-result-count" id="exhibition-result-count" aria-live="polite"></p>
    <ol class="archive-list" id="archive-list">
      {items.map(item=><li class="archive-entry" data-region={item.data.region} data-date={isoDay(item.data.visitedOn)}><time datetime={isoDay(item.data.visitedOn)}>{item.data.dateLabel.replaceAll('-', '.')}</time><a href={`/exhibitions/${item.id}/`}>{item.data.title}</a><span class="entry-type">{item.data.region}</span></li>)}
    </ol>
    <p id="empty-message" class="empty-message" hidden>No matching entries. Try another date or region.</p>
  </section>
</Base>
<script type="application/json" id="exhibition-calendar-data" set:html={JSON.stringify({dates:calendarDates, firstDate,lastDate}).replace(/</g,'\\u003c')} />
<script>
  const rows=[...document.querySelectorAll<HTMLLIElement>('.archive-entry')];
  const previewRows=[...document.querySelectorAll<HTMLLIElement>('.exhibition-preview-entry')];
  const previewHeading=document.querySelector<HTMLElement>('#exhibition-preview-heading');
  const previewCount=document.querySelector<HTMLElement>('#exhibition-preview-count');
  const previewEmpty=document.querySelector<HTMLElement>('#exhibition-preview-empty');
  const list=document.querySelector<HTMLOListElement>('#archive-list');
  const regionBtns=[...document.querySelectorAll<HTMLButtonElement>('[data-region]')];
  const sorter=document.querySelector<HTMLSelectElement>('#date-sort');
  const empty=document.querySelector<HTMLElement>('#empty-message');
  const results=document.querySelector<HTMLElement>('#exhibition-result-count');
  const dataSource=document.querySelector<HTMLElement>('#exhibition-calendar-data');
  const config=JSON.parse(dataSource?.textContent||'{}') as {dates:string[];firstDate:string;lastDate:string};
  const dateCounts=new Map<string,number>();
  for(const date of config.dates||[]) dateCounts.set(date,(dateCounts.get(date)||0)+1);
  const heading=document.querySelector<HTMLElement>('#exhibition-month-label');
  const monthSelect=document.querySelector<HTMLSelectElement>('#exhibition-month-select');
  const yearSelect=document.querySelector<HTMLSelectElement>('#exhibition-year-select');
  const pickerMenus={
    month:document.querySelector<HTMLElement>('#calendar-month-menu'),
    year:document.querySelector<HTMLElement>('#calendar-year-menu'),
  };
  const pickerTriggers={
    month:document.querySelector<HTMLButtonElement>('#calendar-month-trigger'),
    year:document.querySelector<HTMLButtonElement>('#calendar-year-trigger'),
  };
  const closePickerMenus=()=>{
    for(const key of ['month','year'] as const){
      if(pickerMenus[key])pickerMenus[key]!.hidden=true;
      pickerTriggers[key]?.setAttribute('aria-expanded','false');
    }
  };
  for(const key of ['month','year'] as const){
    const trigger=pickerTriggers[key],menu=pickerMenus[key];
    trigger?.addEventListener('click',()=>{
      const open=Boolean(menu?.hidden);
      closePickerMenus();
      if(menu){menu.hidden=!open;trigger.setAttribute('aria-expanded',String(open));}
    });
  }
  document.addEventListener('pointerdown',event=>{
    if(!(event.target instanceof Element) || !event.target.closest('.calendar-picker'))closePickerMenus();
  });
  document.addEventListener('keydown',event=>{
    if(event.key==='Escape')closePickerMenus();
  });
  const grid=document.querySelector<HTMLElement>('#exhibition-calendar-grid');
  const status=document.querySelector<HTMLElement>('#exhibition-date-status');
  const clear=document.querySelector<HTMLButtonElement>('#exhibition-date-clear');
  const prev=document.querySelector<HTMLButtonElement>('#exhibition-prev');
  const next=document.querySelector<HTMLButtonElement>('#exhibition-next');
  const latest=document.querySelector<HTMLButtonElement>('#exhibition-latest');
  let selectedRegion='all';
  let selectedDate:string|null=config.lastDate||null;
  let currentMonth=config.lastDate.slice(0,7);
  const saved=history.state?.murmurgroveExhibitions;
  if(saved&&typeof saved==='object'){
    if(regionBtns.some(b=>b.dataset.region===saved.region))selectedRegion=saved.region;
    if(saved.date===null||dateCounts.has(saved.date))selectedDate=saved.date;
    if(typeof saved.month==='string'&&/^\d{4}-\d{2}$/.test(saved.month)&&saved.month>=config.firstDate.slice(0,7)&&saved.month<=config.lastDate.slice(0,7))currentMonth=saved.month;
    if(sorter&&['newest','oldest'].includes(saved.sort))sorter.value=saved.sort;
    regionBtns.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.region===selectedRegion)));
  }
  function rememberIndex(){
    try{history.replaceState({...history.state,murmurgroveExhibitions:{region:selectedRegion,date:selectedDate,month:currentMonth,sort:sorter?.value||'newest',calendarOpen:document.getElementById('mobile-calendar-toggle')?.getAttribute('aria-expanded')==='true',scroll:window.scrollY}},'');}catch{}
  }
  window.addEventListener('pagehide',rememberIndex);
  document.querySelector('.exhibition-index')?.addEventListener('click',event=>{
    if(event.target instanceof Element&&event.target.closest('a[href]'))rememberIndex();
  });
  const firstMonth=config.firstDate.slice(0,7);
  const lastMonth=config.lastDate.slice(0,7);
  const monthNames=Array.from({length:12},(_,i)=>new Intl.DateTimeFormat('en',{month:'long',timeZone:'UTC'}).format(new Date(Date.UTC(2026,i,1))));
  if(yearSelect && monthSelect){
    const firstYear=Number(firstMonth.slice(0,4));
    const lastYear=Number(lastMonth.slice(0,4));
    for(let year=firstYear;year<=lastYear;year++){
      const option=document.createElement('option');option.value=String(year);option.textContent=String(year);yearSelect.add(option);
    }
    monthNames.forEach((name,index)=>{
      const option=document.createElement('option');option.value=String(index+1).padStart(2,'0');option.textContent=name;monthSelect.add(option);
    });
  }
  function rebuildPickerMenu(kind:'month'|'year'){
    const menu=pickerMenus[kind];const select=kind==='month'?monthSelect:yearSelect;
    if(!menu||!select)return;
    menu.replaceChildren();
    for(const option of Array.from(select.options)){
      const button=document.createElement('button');
      button.type='button';button.setAttribute('role','option');
      button.className='calendar-picker-option';button.textContent=option.textContent;
      button.setAttribute('aria-selected',String(option.value===select.value));
      button.disabled=option.disabled;
      button.addEventListener('click',()=>{
        select.value=option.value;
        changeCalendarMonth();
        closePickerMenus();
      });
      menu.append(button);
    }
  }
  function synchronizeMonthSelectors(){
    if(yearSelect) yearSelect.value=currentMonth.slice(0,4);
    if(monthSelect){
      monthSelect.value=currentMonth.slice(5,7);
      const chosenYear=yearSelect?.value || currentMonth.slice(0,4);
      for(const option of Array.from(monthSelect.options)){
        const candidate=`${chosenYear}-${option.value}`;
        option.disabled=candidate<firstMonth||candidate>lastMonth;
      }
    }
    if(pickerTriggers.month){
      pickerTriggers.month.firstChild!.textContent=monthNames[Number(currentMonth.slice(5,7))-1]+' ';
    }
    if(pickerTriggers.year){
      pickerTriggers.year.firstChild!.textContent=currentMonth.slice(0,4)+' ';
    }
    rebuildPickerMenu('month');rebuildPickerMenu('year');
  }
  function changeCalendarMonth(){
    if(!yearSelect||!monthSelect)return;
    const candidate=`${yearSelect.value}-${monthSelect.value}`;
    currentMonth=candidate<firstMonth?firstMonth:candidate>lastMonth?lastMonth:candidate;
    renderCalendar();
  }
  yearSelect?.addEventListener('change',changeCalendarMonth);
  monthSelect?.addEventListener('change',changeCalendarMonth);
  const monthTitle=(month:string)=>{
    const [y,m]=month.split('-').map(Number);
    return new Intl.DateTimeFormat('en',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(Date.UTC(y,m-1,1)));
  };
  const moveMonth=(delta:number)=>{
    const [y,m]=currentMonth.split('-').map(Number);
    const d=new Date(Date.UTC(y,m-1+delta,1));
    return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}`;
  };
  function updateList(){
    const visible=rows.filter(row=>selectedRegion==='all'||row.dataset.region===selectedRegion);
    document.querySelectorAll(".archive-year-divider").forEach(el=>el.remove());
    list?.classList.toggle("region-selected",selectedRegion!=="all");
    rows.forEach(row=>{row.hidden=!visible.includes(row)});
    visible.sort((a,b)=>{
      const cmp=(a.dataset.date||'').localeCompare(b.dataset.date||'');
      return sorter?.value==='oldest'?cmp:-cmp;
    });
    const multipleYears=new Set(visible.map(row=>row.dataset.date?.slice(0,4))).size>1;
    let lastYear='';
    for(const row of visible){
      const year=row.dataset.date?.slice(0,4)||'';
      if(multipleYears&&year!==lastYear&&list){
        const marker=document.createElement('li');
        marker.className='archive-year-divider';marker.textContent=year;
        marker.setAttribute('aria-label','Year '+year);list.append(marker);lastYear=year;
      }
      list?.append(row);
    }
    if(empty) empty.hidden=visible.length!==0;
    if(results) results.textContent=`${visible.length} ${visible.length===1?'record':'records'}`;
  }
  function updatePreview(){
    const visible=previewRows.filter(row=>Boolean(selectedDate)&&row.dataset.previewDate===selectedDate);
    previewRows.forEach(row=>{row.hidden=!visible.includes(row)});
    if(previewHeading)previewHeading.textContent=selectedDate?selectedDate.replaceAll('-','.'):'No date selected';
    if(previewCount)previewCount.textContent=selectedDate?`${visible.length} ${visible.length===1?'exhibition':'exhibitions'}`:'';
    if(previewEmpty)previewEmpty.hidden=Boolean(selectedDate);
    if(status)status.textContent=selectedDate?`${selectedDate.replaceAll('-','.')} selected`:'Choose a highlighted date to view exhibitions.';
    if(clear)clear.hidden=!selectedDate;
  }
  function selectDate(date:string|null){
    selectedDate=selectedDate===date?null:date;
    renderCalendar();
    updatePreview();
  }
  function renderCalendar(){
    if(!grid||!heading)return;
    heading.textContent=monthTitle(currentMonth);
    synchronizeMonthSelectors();
    grid.replaceChildren();
    const [year,month]=currentMonth.split('-').map(Number);
    const firstWeekday=(new Date(Date.UTC(year,month-1,1)).getUTCDay()+6)%7;
    const numberOfDays=new Date(Date.UTC(year,month,0)).getUTCDate();
    const cells=42;
    for(let index=0;index<cells;index++){
      const day=index-firstWeekday+1;
      if(day<1||day>numberOfDays){
        const spacer=document.createElement('span');spacer.className='exhibition-calendar-day outside';spacer.setAttribute('aria-hidden','true');grid.append(spacer);continue;
      }
      const date=`${currentMonth}-${String(day).padStart(2,'0')}`;
      const count=dateCounts.get(date)||0;
      if(!count){
        const cell=document.createElement('span');cell.className='exhibition-calendar-day';
        const numeral=document.createElement('span');numeral.className='exhibition-calendar-numeral';numeral.textContent=String(day);cell.append(numeral);
        grid.append(cell);continue;
      }
      const button=document.createElement('button');button.type='button';button.className='exhibition-calendar-day has-records';
      const numeral=document.createElement('span');numeral.className='exhibition-calendar-numeral';numeral.textContent=String(day);button.append(numeral);
      button.dataset.date=date;
      button.setAttribute('aria-label',`${date}, ${count} exhibition ${count===1?'record':'records'}`);
      button.setAttribute('aria-pressed',String(selectedDate===date));
      if(selectedDate===date)button.classList.add('selected');
      if(count>1){const marker=document.createElement('small');marker.textContent=String(count);marker.setAttribute('aria-hidden','true');button.append(marker);}
      button.addEventListener('click',()=>selectDate(date));grid.append(button);
    }
    if(prev)prev.disabled=currentMonth<=firstMonth;
    if(next)next.disabled=currentMonth>=lastMonth;
  }
  prev?.addEventListener('click',()=>{currentMonth=moveMonth(-1);renderCalendar()});
  next?.addEventListener('click',()=>{currentMonth=moveMonth(1);renderCalendar()});
  latest?.addEventListener('click',()=>{currentMonth=lastMonth;renderCalendar()});
  clear?.addEventListener('click',()=>selectDate(null));
  regionBtns.forEach(button=>button.addEventListener('click',()=>{
    selectedRegion=button.dataset.region||'all';
    regionBtns.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
    updateList();
  }));
  sorter?.addEventListener('change',updateList);
  renderCalendar();updateList();updatePreview();
  if(saved&&Number.isFinite(saved.scroll))requestAnimationFrame(()=>requestAnimationFrame(()=>window.scrollTo(0,saved.scroll)));
</script>

<script>
  const dateToggle = document.getElementById('mobile-calendar-toggle');
  const dateContent = document.getElementById('mobile-calendar-content');
  if(history.state?.murmurgroveExhibitions?.calendarOpen){
    dateToggle?.setAttribute('aria-expanded','true');
    dateContent?.classList.add('mobile-calendar-open');
    const sign=dateToggle?.querySelector('span');if(sign)sign.textContent='−';
  }
  dateToggle?.addEventListener('click', () => {
    const open = dateToggle.getAttribute('aria-expanded') !== 'true';
    dateToggle.setAttribute('aria-expanded', String(open));
    dateContent?.classList.toggle('mobile-calendar-open', open);
    const sign = dateToggle.querySelector('span');
    if (sign) sign.textContent = open ? '−' : '+';
  });
</script>

<style is:global>
  .exhibition-index #archive-list.region-selected .entry-type{display:none}
  .exhibition-index #archive-list.region-selected .archive-entry{grid-template-columns:118px minmax(0,1fr)}
  .exhibition-index .archive-year-divider{list-style:none;color:var(--quiet);font-size:13px;letter-spacing:.04em;padding:24px 0 9px}
  @media(max-width:650px){.exhibition-index #archive-list.region-selected .archive-entry{grid-template-columns:83px minmax(0,1fr)}}
</style>
