---
import {archiveDay,engagementOf,engagementLabel} from '../../lib/exhibition-engagement.mjs';
import Base from '../../layouts/Base.astro';
import OrganismLink from '../../components/OrganismLink.astro';
import ResearchContinuity from '../../components/ResearchContinuity.astro';
import { getCollection, render } from 'astro:content';
import {currentConceptIds} from '../../lib/current-research.mjs';
export async function getStaticPaths(){return (await getCollection('exhibitions')).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const {Content}=await render(item);
const people = await getCollection('people');
const institutions = await getCollection('institutions');
const concepts = await getCollection('concepts');
const personById = new Map(people.map(x=>[x.id,x]));
const inst = institutions.find(x=>x.id===item.data.institution);
const relatedInst = item.data.relatedInstitutions.map(id=>institutions.find(x=>x.id===id)).filter(Boolean);
const conceptById = new Map(concepts.map(x=>[x.id,x]));
const artistLinks=item.data.artists.map(id=>personById.get(id)).filter(Boolean);
const activeConceptIds=currentConceptIds(item.id);
const conceptLinks=activeConceptIds.map(id=>conceptById.get(id)).filter(Boolean);
const earlierConcepts=item.data.concepts.filter(id=>!activeConceptIds.includes(id)).map(id=>conceptById.get(id)).filter(Boolean);
const mode=engagementOf(item.data);
const day=archiveDay(item.data);
---
<Base title={`${item.data.title} | murmurgrove`} description={`Murmurgrove exhibition record for ${item.data.title} in ${item.data.location}. ${engagementLabel(item.data)}.`}>
  <article class="article">
    <nav class="record-nav" aria-label="Record navigation"><a class="eyebrow" href="/exhibitions/">← Exhibitions</a><OrganismLink path={`/exhibitions/${item.id}/`}/></nav>
    <h1>{item.data.title}</h1>
    <p class="lead">{[item.data.region,item.data.location!==inst?.data.name?item.data.location:null,item.data.kind].filter(Boolean).join(' · ')}</p>
    <dl class="record-meta">
      <div><dt>Engagement</dt><dd>{engagementLabel(item.data)}</dd></div>
      {mode!=='planned'&&day&&<div><dt>{mode==='visited'?'Visited':'Research date'}</dt><dd><time datetime={day}>{day}</time></dd></div>}
      {mode==='visited'&&item.data.researchOn&&<div><dt>Research date</dt><dd>{item.data.researchOn.toISOString().slice(0,10)}</dd></div>}
      {item.data.plannedOn&&<div><dt>Expected visit</dt><dd>{item.data.plannedOn.toISOString().slice(0,10)}</dd></div>}
      {item.data.recordedOn&&<div><dt>Record date</dt><dd>{item.data.recordedOn.toISOString().slice(0,10)}</dd></div>}
      {item.data.researchSources&&<div><dt>Research sources</dt><dd>{item.data.researchSources}</dd></div>
      {(item.data.exhibitionStart || item.data.exhibitionEnd) && <div><dt>{item.data.exhibitionStart && item.data.exhibitionEnd ? 'Exhibition period' : item.data.exhibitionStart ? 'Exhibition start' : 'Exhibition end'}</dt><dd>{[item.data.exhibitionStart,item.data.exhibitionEnd].filter(Boolean).map(d=>d!.toISOString().slice(0,10)).join(' – ')}</dd></div>}
      {item.data.verification==='needs-review' && <div><dt>Archive status</dt><dd>Details to verify</dd></div>}
      {inst && <div><dt>Institution</dt><dd><a href={`/institutions/${inst.id}/`}>{inst.data.name}</a></dd></div>}
    </dl>
    {relatedInst.length > 0 && <section class="record-relations" aria-label="Related institutions"><h2>Institutions</h2><div class="tags">{relatedInst.map(i=><a class="tag" href={`/institutions/${i.id}/`}>{i.data.name}</a>)}</div></section>}
    {artistLinks.length > 0 && <section class="record-relations" aria-label="People and collectives"><h2>People</h2><div class="tags">{artistLinks.map(p=><a class="tag" href={`/people/${p.id}/`}>{p.data.name}</a>)}</div></section>}
    {conceptLinks.length > 0 && <section class="record-relations" aria-label="Related concepts"><h2>Concepts</h2><div class="tags">{conceptLinks.map(c=><a class="tag" href={`/concepts/${c.id}/`}>{c.data.title}</a>)}</div></section>}
    {earlierConcepts.length>0 && <details class="record-relations"><summary class="note">Earlier recorded classification</summary><div class="tags">{earlierConcepts.map(c=><a class="tag" href={`/concepts/${c.id}/`}>{c.data.title}</a>)}</div></details>}
    <div class="prose"><Content/></div>
    {item.data.verification==='recorded' && <p class="note">Reviewed archive entry.</p>}
    <p class="note">{mode==='visited'?'Editorial note: visit dates and first-person observations come from personal records.':mode==='researched'?'Editorial note: this record is based on research, not a personal visit.':'Editorial note: this is a plan, not a completed visit or research activity.'} Refer to the source links for independently documented programme details.</p>
  <ResearchContinuity type="exhibitions" id={item.id}/></article>
</Base>

<style>
.record-relations{margin:18px 0 25px}.record-relations h2{font-size:12px;color:var(--quiet);font-weight:500;margin:0 0 8px}.record-relations .tags{column-gap:16px;row-gap:5px}.record-relations .tag{padding:3px 0;text-decoration:none}.record-relations .tag:hover{text-decoration:underline}
</style>
