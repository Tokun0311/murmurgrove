---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('exhibitions')).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const {Content}=await render(item);
const people = await getCollection('people');
const institutions = await getCollection('institutions');
const concepts = await getCollection('concepts');
const personById = new Map(people.map(x=>[x.id,x]));
const inst = institutions.find(x=>x.id===item.data.institution);
const relatedInst = item.data.relatedInstitutions.map(id=>institutions.find(x=>x.id===id)).filter(Boolean);
const conceptById = new Map(concepts.map(x=>[x.id,x]));
---
<Base title={`${item.data.title} | murmurgrove`} description={`Murmurgrove exhibition record for ${item.data.title} in ${item.data.location}, visited on ${item.data.visitedOn.toISOString().slice(0, 10)}.`}>
  <article class="article">
    <a class="eyebrow" href="/exhibitions/">← Exhibitions</a>
    <h1>{item.data.title}</h1>
    <p class="lead">{item.data.region} · {item.data.location} · {item.data.kind}</p>
    <dl class="record-meta">
      <div><dt>Visited</dt><dd>{item.data.dateLabel.replaceAll('-','.')}.{item.data.visitedOn.getUTCFullYear()}</dd></div>
      {(item.data.exhibitionStart || item.data.exhibitionEnd) && <div><dt>{item.data.exhibitionStart && item.data.exhibitionEnd ? 'Exhibition period' : item.data.exhibitionStart ? 'Exhibition start' : 'Exhibition end'}</dt><dd>{[item.data.exhibitionStart,item.data.exhibitionEnd].filter(Boolean).map(d=>d!.toISOString().slice(0,10)).join(' – ')}</dd></div>}
      <div><dt>Archive status</dt><dd>{item.data.verification==='needs-review'?'Details to verify':'Reviewed archive entry'}</dd></div>
      {inst && <div><dt>Institution</dt><dd><a href={`/institutions/${inst.id}/`}>{inst.data.name}</a></dd></div>}
    </dl>
    {relatedInst.length > 0 && <div class="tags">{relatedInst.map(i=><a class="tag" href={`/institutions/${i.id}/`}>{i.data.name}</a>)}</div>}
    <div class="tags">
      {item.data.artists.map((id)=>personById.get(id)).filter(Boolean).map(p=><a class="tag" href={`/people/${p.id}/`}>{p.data.name}</a>)}
      {item.data.concepts.map((id)=>conceptById.get(id)).filter(Boolean).map(c=><a class="tag" href={`/concepts/${c.id}/`}>{c.data.title}</a>)}
    </div>
    <div class="prose"><Content/></div>
    <p class="note">Editorial note: visit dates and first-person observations come from personal records. Refer to the source links in each entry for independently documented programme details.</p>
  </article>
</Base>
