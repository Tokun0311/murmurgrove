---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const items=(await getCollection('people')).sort((a,b)=>a.data.name.localeCompare(b.data.name));
---
<Base title="People & Collectives | TOW ARCHIVE"><section class="archive"><h1 class="sr-only">People &amp; Collectives</h1><ol class="archive-list">{items.map(item=><li class="archive-entry"><span class="eyebrow">INDEX</span><a href={`/people/${item.id}/`}>{item.data.name}</a></li>)}</ol></section></Base>
