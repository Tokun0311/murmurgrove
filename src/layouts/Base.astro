---
import '../styles/global.css';
const { noindex = false, title = 'murmurgrove', description = 'An evolving research archive of exhibitions, people, institutions and concepts. A living organism made visible through their relationships.' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const activeSection = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <!-- murmurgrove favicon: theme selection, no added JavaScript -->
    {isHome && <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />}
    <link rel="icon" type="image/png" sizes="96x96"
          media="(prefers-color-scheme: light)"
          href="/favicon-96x96.png?v=20261125-safe" />
    <link rel="icon" type="image/png" sizes="96x96"
          media="(prefers-color-scheme: dark)"
          href="/favicon-dark-96x96.png?v=20261125-safe" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Put the white stage in place before painting any page; no JS means no hiding.
      document.documentElement.classList.add('murmur-preparing');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="murmurgrove-release" content="white-stage-page-reveal-20261124" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="murmurgrove" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:image" content={new URL('/murmurgrove-icon-512.png', Astro.site ?? Astro.url.origin).href} />
    <meta property="og:image:alt" content="murmurgrove emblem" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'murmurgrove',
        url: new URL('/', Astro.site ?? Astro.url.origin).href,
      })} />
    )}
  </head>
  <body>
    <script is:inline>
      (() => {
        let revealed = false;
        const reveal = () => {
          if (revealed) return;
          revealed = true;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            document.documentElement.classList.remove('murmur-preparing');
          }));
        };
        const afterDOM = () => {
          // Fonts can swap after first paint and make headings jump. Wait briefly,
          // but always reveal even with a blocked remote font request.
          const fallback = window.setTimeout(reveal, 900);
          Promise.resolve(document.fonts?.ready).then(() => {
            window.clearTimeout(fallback);
            reveal();
          }, reveal);
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', afterDOM, {once: true});
        } else afterDOM();
        // BFCache restoration should not replay the entrance animation.
        window.addEventListener('pageshow', e => {
          if (e.persisted) document.documentElement.classList.remove('murmur-preparing');
        });
      })();
    </script>
    <div class="frame">
      <header class="mast">
        {isHome ? (
          <h1 class="brand"><a href="/">murmurgrove</a></h1>
        ) : (
          <a class="brand" href="/">murmurgrove</a>
        )}
        <nav aria-label="Main navigation">
          <a href="/exhibitions/" aria-current={activeSection === 'exhibitions' ? 'page' : undefined}>Exhibitions</a>
          <a href="/institutions/" aria-current={activeSection === 'institutions' ? 'page' : undefined}>Institutions</a>
          <a href="/people/" aria-current={activeSection === 'people' ? 'page' : undefined}>People</a>
          <a href="/concepts/" aria-current={activeSection === 'concepts' ? 'page' : undefined}>Concepts</a>
          <a href="/about/" aria-current={activeSection === 'about' ? 'page' : undefined}>About</a>
          <a href="/search/" aria-label="Search the archive" title="Search" aria-current={activeSection === 'search' ? 'page' : undefined}><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.35" aria-hidden="true" style="vertical-align:middle"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg></a>
        </nav>
        <details class="mobile-nav" id="mobile-nav">
          <summary aria-label="Open site sections"><span>Explore</span><span class="mobile-nav-symbol" aria-hidden="true"></span></summary>
          <nav aria-label="Mobile navigation">
            <a href="/exhibitions/" aria-current={activeSection === 'exhibitions' ? 'page' : undefined}>Exhibitions</a>
            <a href="/institutions/" aria-current={activeSection === 'institutions' ? 'page' : undefined}>Institutions</a>
            <a href="/people/" aria-current={activeSection === 'people' ? 'page' : undefined}>People</a>
            <a href="/concepts/" aria-current={activeSection === 'concepts' ? 'page' : undefined}>Concepts</a>
            <a href="/about/" aria-current={activeSection === 'about' ? 'page' : undefined}>About</a>
            <a href="/search/" aria-current={activeSection === 'search' ? 'page' : undefined}>Search</a>
          </nav>
        </details>
      </header>
      <main><slot /></main>
    </div>
    <script>
      // Subtle luminous cursor path, drawn only while a fine pointer is moving.
      const finePointer = window.matchMedia('(pointer:fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)');
      if (finePointer.matches && !reducedMotion.matches) {
        const canvas = document.createElement('canvas');
        canvas.id = 'cursor-light-trail';
        canvas.setAttribute('aria-hidden', 'true');
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = 0, height = 0, dpr = 1, frame = 0, lastMove = 0;
          let lastPosition: {x:number,y:number,t:number} | null = null;
          let points: {x:number,y:number,t:number}[] = [];
          const lifetime = 580;
          function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = window.innerWidth; height = window.innerHeight;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx!.setTransform(dpr,0,0,dpr,0,0);
          }
          function draw(now: number) {
            frame = 0;
            ctx!.clearRect(0, 0, width, height);
            points = points.filter(p => now - p.t < lifetime);
            if (points.length > 1) {
              ctx!.lineCap = 'round'; ctx!.lineJoin = 'round';
              for (let i = 1; i < points.length; i++) {
                const older = points[i - 1], newer = points[i];
                const alpha = Math.max(0, 1 - (now - newer.t) / lifetime);
                const distance = Math.hypot(newer.x-older.x,newer.y-older.y);
                if (distance > 110) continue;
                ctx!.beginPath();ctx!.moveTo(older.x,older.y);ctx!.lineTo(newer.x,newer.y);
                ctx!.strokeStyle = `rgba(107,234,117,${(alpha * .18).toFixed(3)})`;
                ctx!.lineWidth = 9 * alpha + 2; ctx!.shadowColor = '#70ee88'; ctx!.shadowBlur = 12;
                ctx!.stroke();
                ctx!.strokeStyle = `rgba(79,221,106,${(alpha * .58).toFixed(3)})`;
                ctx!.lineWidth = Math.max(.5, 1.35 * alpha);ctx!.shadowBlur = 5;ctx!.stroke();
              }
              ctx!.shadowBlur = 0;
            }
            // A small luminous head makes links targetable even with the arrow hidden.
            if (lastPosition && now-lastPosition.t < 2400) {
              const age = Math.max(0, now-lastPosition.t);
              const strength = age < 1600 ? 1 : Math.max(0,(2400-age)/800);
              const x=lastPosition.x, y=lastPosition.y;
              const bloom=ctx!.createRadialGradient(x,y,0,x,y,13);
              bloom.addColorStop(0,`rgba(47,189,87,${(.65*strength).toFixed(3)})`);
              bloom.addColorStop(.27,`rgba(93,239,125,${(.38*strength).toFixed(3)})`);
              bloom.addColorStop(1,'rgba(93,239,125,0)');
              ctx!.fillStyle=bloom;ctx!.beginPath();ctx!.arc(x,y,13,0,Math.PI*2);ctx!.fill();
            }
            if (points.length || (lastPosition && now-lastPosition.t < 2400)) frame = requestAnimationFrame(draw);
          }
          const onMove = (event: PointerEvent) => {
            const now = performance.now();
            lastPosition = {x:event.clientX,y:event.clientY,t:now};
            // Sample the trail without dropping the cursor head's final position.
            if (now - lastMove >= 12) {
              lastMove = now;
              points.push(lastPosition);
              if (points.length > 48) points.shift();
            }
            if (!frame) frame = requestAnimationFrame(draw);
          };
          resize();
          window.addEventListener('resize', resize, {passive:true});
          window.addEventListener('pointermove', onMove, {passive:true});
          window.addEventListener('blur', () => {points=[];lastPosition=null;ctx.clearRect(0,0,width,height);});
          document.addEventListener('pointerleave', () => {points=[];lastPosition=null;ctx.clearRect(0,0,width,height);});
        }
      }
    </script>
  </body>
</html>
