---
import '../styles/global.css';
const { title = 'TOW ARCHIVE', description = 'A personal archive of exhibitions, art institutions, people and research concepts.' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const activeSection = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="tow-archive-release" content="soft-glow-trail-only-v2-20261117" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="frame">
      <header class="mast">
        {isHome ? (
          <h1 class="brand"><a href="/">TOW ARCHIVE</a></h1>
        ) : (
          <a class="brand" href="/">TOW ARCHIVE</a>
        )}
        <nav aria-label="Main navigation">
          <a href="/exhibitions/" aria-current={activeSection === 'exhibitions' ? 'page' : undefined}>Exhibitions</a>
          <a href="/people/" aria-current={activeSection === 'people' ? 'page' : undefined}>People</a>
          <a href="/institutions/" aria-current={activeSection === 'institutions' ? 'page' : undefined}>Institutions</a>
          <a href="/concepts/" aria-current={activeSection === 'concepts' ? 'page' : undefined}>Concepts</a>
          <a href="/about/" aria-current={activeSection === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <main><slot /></main>
    </div>
    <script>
      // Subtle luminous cursor path, drawn only while a fine pointer is moving.
      const finePointer = window.matchMedia('(pointer:fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)');
      if (finePointer.matches && !reducedMotion.matches) {
        const canvas = document.createElement('canvas');
        canvas.id = 'cursor-light-trail';
        canvas.setAttribute('aria-hidden', 'true');
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = 0, height = 0, dpr = 1, frame = 0, lastMove = 0;
          let lastPosition: {x:number,y:number} | null = null;
          let points: {x:number,y:number,t:number}[] = [];
          const lifetime = 580;
          function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = window.innerWidth; height = window.innerHeight;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx!.setTransform(dpr,0,0,dpr,0,0);
          }
          function draw(now: number) {
            frame = 0;
            ctx!.clearRect(0, 0, width, height);
            points = points.filter(p => now - p.t < lifetime);
            if (points.length > 1) {
              ctx!.lineCap = 'round'; ctx!.lineJoin = 'round';
              for (let i = 1; i < points.length; i++) {
                const older = points[i - 1], newer = points[i];
                const alpha = Math.max(0, 1 - (now - newer.t) / lifetime);
                const distance = Math.hypot(newer.x-older.x,newer.y-older.y);
                if (distance > 110) continue;
                ctx!.beginPath();ctx!.moveTo(older.x,older.y);ctx!.lineTo(newer.x,newer.y);
                ctx!.strokeStyle = `rgba(107,234,117,${(alpha * .18).toFixed(3)})`;
                ctx!.lineWidth = 9 * alpha + 2; ctx!.shadowColor = '#70ee88'; ctx!.shadowBlur = 12;
                ctx!.stroke();
                ctx!.strokeStyle = `rgba(79,221,106,${(alpha * .58).toFixed(3)})`;
                ctx!.lineWidth = Math.max(.5, 1.35 * alpha);ctx!.shadowBlur = 5;ctx!.stroke();
              }
              ctx!.shadowBlur = 0;
            }
            // A small luminous head makes links targetable even with the arrow hidden.
            if (lastPosition && now-lastMove < 2400) {
              const age = now-lastMove;
              const strength = age < 1600 ? 1 : Math.max(0,(2400-age)/800);
              const x=lastPosition.x, y=lastPosition.y;
              const bloom=ctx!.createRadialGradient(x,y,0,x,y,13);
              bloom.addColorStop(0,`rgba(47,189,87,${(.65*strength).toFixed(3)})`);
              bloom.addColorStop(.27,`rgba(93,239,125,${(.38*strength).toFixed(3)})`);
              bloom.addColorStop(1,'rgba(93,239,125,0)');
              ctx!.fillStyle=bloom;ctx!.beginPath();ctx!.arc(x,y,13,0,Math.PI*2);ctx!.fill();
            }
            if (points.length || (lastPosition && now-lastMove < 2400)) frame = requestAnimationFrame(draw);
          }
          const onMove = (event: PointerEvent) => {
            const now = performance.now();
            if (now - lastMove < 12) return;
            lastMove = now;
            lastPosition = {x:event.clientX,y:event.clientY};
            points.push({x:event.clientX,y:event.clientY,t:now});
            if (points.length > 48) points.shift();
            if (!frame) frame = requestAnimationFrame(draw);
          };
          resize();
          window.addEventListener('resize', resize, {passive:true});
          window.addEventListener('pointermove', onMove, {passive:true});
          window.addEventListener('blur', () => {points=[];lastPosition=null;ctx.clearRect(0,0,width,height);});
          document.addEventListener('pointerleave', () => {points=[];lastPosition=null;ctx.clearRect(0,0,width,height);});
        }
      }
    </script>
  </body>
</html>
