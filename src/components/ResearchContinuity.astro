---
import {currentRelationships} from '../lib/current-research.mjs';
import {readRevisionNotes} from '../../murmurgrove-editor/research-continuity.mjs';
const {type,id}=Astro.props;
const links=currentRelationships(`${type}:${id}`);
const grouped=[...new Set(links.map(l=>l.other.type))].map(group=>({group,items:links.filter(l=>l.other.type===group)}));
const labels={people:"People",institutions:"Institutions",exhibitions:"Exhibitions",concepts:"Concepts",writing:"Writing"};
const relationLabel=(l:any)=>l.kind==='archive-association'?(l.provenance.some((p:any)=>p.field==='curators')?(type==='exhibitions'?'Curator':'Curated exhibition'):''):l.kind;
const revisions=await readRevisionNotes(process.cwd(),type,id);
---
{links.length>0 && <section class="continuity-reading"><h2>Connections</h2>{grouped.map(({group,items})=><section class="continuity-group"><h3>{labels[group]||group}</h3>{items.map(link=><div class="continuity-relation"><a href={link.other.path}>{link.other.title}</a>{relationLabel(link)&&<small>{relationLabel(link)}</small>}{link.provenance.filter(p=>p.method==='reviewed-claim').map(p=><details><summary>Evidence &amp; interpretation</summary><blockquote>{p.evidence}</blockquote><p>{p.reason}</p></details>)}</div>)}</section>)}</section>}
{revisions.length>0 && <details class="continuity-reading"><summary>Research history</summary>{revisions.map(r=><div class="continuity-relation"><small><time datetime={r.at}>{r.at.slice(0,10)}</time> · {r.kind}</small><p>{r.note}</p></div>)}</details>}
<style>
.continuity-reading{margin:40px 0 25px;color:var(--ink)}.continuity-reading h2{font-weight:400;font-size:19px;margin:0 0 15px}.continuity-reading summary{cursor:pointer;color:var(--quiet);font-size:13px}.continuity-group{margin:16px 0}.continuity-group h3{font-size:12px;font-weight:500;color:var(--quiet);margin:0 0 5px}.continuity-relation{padding:4px 0}.continuity-relation small{display:block;color:var(--quiet);font-size:12px;margin:4px 0}.continuity-relation blockquote{margin:10px 0;color:var(--quiet);font-size:13px;white-space:pre-wrap}.continuity-relation p{font-size:14px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;margin:6px 0}
</style>
