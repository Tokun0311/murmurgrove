---
import {currentRelationships} from '../lib/current-research.mjs';
import {readRevisionNotes} from '../../murmurgrove-editor/research-continuity.mjs';
const {type,id}=Astro.props;
const links=currentRelationships(`${type}:${id}`);
const revisions=await readRevisionNotes(process.cwd(),type,id);
---
{links.length>0 && <section class="continuity-reading"><h2>Research relationships</h2>{links.map(link=><div class="continuity-relation"><a href={link.other.path}>{link.other.title}</a><small>{link.kind} · {link.source===`${type}:${id}`?'source → related':'related ← source'}</small>{link.provenance.filter(p=>p.method==='reviewed-claim').map(p=><details><summary>Evidence &amp; interpretation</summary><blockquote>{p.evidence}</blockquote><p>{p.reason}</p></details>)}</div>)}</section>}
{revisions.length>0 && <details class="continuity-reading"><summary>Research history</summary>{revisions.map(r=><div class="continuity-relation"><small><time datetime={r.at}>{r.at.slice(0,10)}</time> · {r.kind}</small><p>{r.note}</p></div>)}</details>}
<style>
.continuity-reading{margin:40px 0 25px;color:var(--ink)}.continuity-reading h2{font-weight:400;font-size:19px;margin:0 0 15px}.continuity-reading summary{cursor:pointer;color:var(--quiet);font-size:13px}.continuity-relation{padding:14px 0}.continuity-relation small{display:block;color:var(--quiet);font-size:12px;margin:4px 0}.continuity-relation blockquote{margin:10px 0;color:var(--quiet);font-size:13px;white-space:pre-wrap}.continuity-relation p{font-size:14px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;margin:6px 0}
</style>
